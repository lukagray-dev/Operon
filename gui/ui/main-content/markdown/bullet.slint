import { Tokens } from "../../shared/tokens.slint";

export component MarkdownBullet inherits HorizontalLayout {
    in property <string> text: "";
    in property <string> font-family-custom: Tokens.serif-font-family;
    in property <length> font-size-custom: Tokens.body-font-size;
    
    spacing: 12px;
    padding-left: 24px;
    alignment: start;
    
    // Bullet character
    Text {
        text: "•";
        color: #8b949e; // GitHub muted grey
        font-size: root.font-size-custom;
        font-weight: 600;
        vertical-alignment: top;
    }
    
    // Text content
    Text {
        text: root.text;
        color: Tokens.text-primary;
        font-size: root.font-size-custom;
        font-family: root.font-family-custom;
        wrap: word-wrap;
        horizontal-stretch: 1;
        vertical-alignment: top;
    }
}
