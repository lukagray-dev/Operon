import { Tokens } from "../../shared/tokens.slint";
import { InlineMarkdown, InlineMarkdownSpan } from "./inline-code.slint";

export component MarkdownBullet inherits HorizontalLayout {
    in property <[InlineMarkdownSpan]> spans: [];
    in property <string> text: "";
    in property <styled-text> content: @markdown("");
    // Pre-compiled styled text with the trailing cursor parsed on the Rust side
    in property <styled-text> content-with-cursor: @markdown("");
    // Custom font family for assistant message (PT Serif)
    in property <string> font-family-custom: Tokens.serif-font-family;
    // Custom font size for readability
    in property <length> font-size-custom: Tokens.body-font-size;
    // Show trailing cursor if this is the active/streaming chunk
    in property <bool> show-cursor: false;

    spacing: 12px;
    padding-left: 24px;
    alignment: start;
    horizontal-stretch: 1;

    Text {
        text: "\u{2022}";
        color: #8b949e;
        font-size: root.font-size-custom;
        font-weight: 600;
        vertical-alignment: top;
    }

    HorizontalLayout {
        spacing: 0px;
        horizontal-stretch: 1;

        StyledText {
            text: root.show-cursor ? root.content-with-cursor : root.content;
            default-font-family: root.font-family-custom;
            default-font-size: root.font-size-custom;
            default-color: Tokens.text-primary;
        }
    }
}
