import { Tokens } from "../../shared/tokens.slint";
import { InlineMarkdown, InlineMarkdownSpan } from "./inline-code.slint";

export component MarkdownHeading inherits VerticalLayout {
    in property <int> level: 1;
    in property <[InlineMarkdownSpan]> spans: [];
    in property <string> text: "";
    in property <bool> show-cursor: false;
    
    spacing: 4px;
    padding-top: 8px;
    padding-bottom: 4px;
    
    InlineMarkdown {
        spans: root.spans;
        fallback-text: root.text;
        default-color: #ffffff;
        font-family-custom: Tokens.serif-font-family;
        font-size-custom: root.level == 1 ? 20px : (root.level == 2 ? 18px : 16px);
        default-bold: true;
        show-cursor: root.show-cursor;
    }
    
    // Bottom border for h1 and h2 (GitHub / Tauri reference style)
    if (root.level == 1 || root.level == 2) : Rectangle {
        height: 1px;
        background: rgba(255, 255, 255, 0.15);
    }
}
