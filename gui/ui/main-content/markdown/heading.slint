import { Tokens } from "../../shared/tokens.slint";
import { InlineMarkdown, InlineMarkdownSpan } from "./inline-code.slint";

export component MarkdownHeading inherits VerticalLayout {
    in property <int> level: 1;
    in property <[InlineMarkdownSpan]> spans: [];
    in property <string> text: "";
    in property <styled-text> content: @markdown("");
    // Pre-compiled styled text with the trailing cursor parsed on the Rust side
    in property <styled-text> content-with-cursor: @markdown("");
    in property <bool> show-cursor: false;
    in property <string> font-family: Tokens.serif-font-family;
    
    spacing: 4px;
    padding-top: 8px;
    padding-bottom: 4px;
    horizontal-stretch: 1;
    
    StyledText {
        width: parent.width;
        text: root.show-cursor ? root.content-with-cursor : root.content;
        default-color: #ffffff;
        default-font-family: root.font-family;
        default-font-size: root.level == 1 ? 20px : (root.level == 2 ? 18px : 16px);
    }
    
    // Bottom border for h1 and h2 (GitHub / Tauri reference style)
    if (root.level == 1 || root.level == 2) : Rectangle {
        height: 1px;
        background: rgba(255, 255, 255, 0.15);
    }
}
