import { Tokens } from "../../shared/tokens.slint";

export component MarkdownHeading inherits VerticalLayout {
    in property <int> level: 1;
    in property <string> text: "";
    
    spacing: 4px;
    padding-top: 8px;
    padding-bottom: 4px;
    
    Text {
        text: root.text;
        color: #ffffff;
        font-family: Tokens.serif-font-family;
        font-size: root.level == 1 ? 20px : (root.level == 2 ? 18px : 16px);
        font-weight: 600;
        wrap: word-wrap;
    }
    
    // Bottom border for h1 and h2 (GitHub / Tauri reference style)
    if (root.level == 1 || root.level == 2) : Rectangle {
        height: 1px;
        background: rgba(255, 255, 255, 0.15);
    }
}
