// =============================================================================
// Markdown Heading Component (`ui/markdown/heading.slint`)
// =============================================================================
// Renders headings (# h1, ## h2, ### h3) with native StyledText rich text.

import { Tokens } from "../../shared/tokens.slint";

export component MarkdownHeading inherits Rectangle {
    in property <int> level: 1;
    in property <styled-text> rich_text: @markdown("");
    in property <string> font_family: Tokens.font_family;

    horizontal-stretch: 1;
    height: heading_text.preferred-height + (level == 1 ? 16px : level == 2 ? 12px : 8px);

    heading_text := StyledText {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.rich_text;
        default-font-family: root.font_family;
        default-font-size: level == 1 ? 26px : level == 2 ? 20px : 16px;
        default-color: Tokens.text_primary;
    }
}
