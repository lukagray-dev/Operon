import { Tokens } from "../../shared/tokens.slint";

export component MarkdownSvg inherits Rectangle {
    in property <string> source: "";
    in property <image> svg-image;
    in property <bool> svg-valid: false;
    in property <int> svg-width-px: 0;
    in property <int> svg-height-px: 0;

    property <length> image-width: max(96px, root.svg-width-px * 1px);
    property <length> image-height: max(96px, root.svg-height-px * 1px);
    property <length> fallback-height: source-measure.preferred-height + 24px;
    property <length> body-height: root.svg-valid
        ? min(max(root.image-height + 24px, 120px), 420px)
        : root.fallback-height;

    background: rgba(30, 30, 30, 0.32);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    clip: true;
    height: 28px + root.body-height;

    source-measure := Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 0px;
        opacity: 0;
        text: root.source;
        font-family: Tokens.mono-font-family;
        font-size: Tokens.body-font-size;
        wrap: word-wrap;
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 28px;
            background: rgba(255, 255, 255, 0.04);

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: rgba(255, 255, 255, 0.08);
            }

            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: "svg";
                color: #8b949e;
                font-family: Tokens.font-family;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        if (root.svg-valid) : Flickable {
            height: root.body-height;
            viewport-width: max(parent.width, root.image-width + 24px);
            viewport-height: root.image-height + 24px;
            interactive: true;

            Rectangle {
                x: 12px;
                y: 12px;
                width: root.image-width;
                height: root.image-height;
                background: rgba(255, 255, 255, 0.04);
                border-radius: 6px;

                Image {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: root.svg-image;
                    image-fit: contain;
                }
            }
        }

        if (!root.svg-valid) : Rectangle {
            height: root.body-height;

            Text {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                text: root.source;
                color: #f0f6fc;
                font-family: Tokens.mono-font-family;
                font-size: Tokens.body-font-size;
                wrap: word-wrap;
            }
        }
    }
}
