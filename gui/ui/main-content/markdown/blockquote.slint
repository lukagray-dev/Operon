// =============================================================================
// Markdown BlockQuote Component (`ui/markdown/blockquote.slint`)
// =============================================================================
// Renders blockquote blocks with an accent border line.

import { Tokens } from "../../shared/tokens.slint";

export component MarkdownBlockQuote inherits Rectangle {
    in property <styled-text> rich_text: @markdown("");
    in property <int> depth: 0;
    in property <string> font_family: Tokens.font_family;

    horizontal-stretch: 1;
    height: quote_layout.preferred-height;

    Rectangle {
        x: 0px;
        width: 4px;
        height: parent.height;
        background: Tokens.accent_blue;
        border-radius: 2px;
    }

    quote_layout := HorizontalLayout {
        padding-left: 14px;

        quote_text := StyledText {
            width: parent.width - 14px;
            text: root.rich_text;
            default-font-family: root.font_family;
            default-font-size: Tokens.editor_font_size;
            default-color: Tokens.text_secondary;
        }
    }
}
