// =============================================================================
// Markdown List Component (`ui/markdown/list.slint`)
// =============================================================================
// Renders bullet, numbered, and task list items with indentation support.

import { Tokens } from "../../shared/tokens.slint";

export component MarkdownList inherits Rectangle {
    in property <string> text: "";
    in property <styled-text> rich_text: @markdown("");
    in property <int> depth: 0;
    in property <bool> is_ordered: false;
    in property <string> prefix: "";
    in property <bool> is_task: false;
    in property <bool> is_checked: false;
    in property <string> font_family: Tokens.font_family;

    horizontal-stretch: 1;
    height: list_layout.preferred-height + 4px;

    list_layout := HorizontalLayout {
        padding-left: (root.depth * 20) * 1px;
        spacing: 8px;

        if (root.is_task) : Rectangle {
            width: 16px;
            height: 16px;
            y: 3px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.is_checked ? Tokens.accent_blue : Tokens.text_muted;
            background: root.is_checked ? Tokens.accent_blue : transparent;

            if (root.is_checked) : Image {
                source: @image-url("../../../assets/icons/main-content/messages/assistant/check.svg");
                width: 12px;
                height: 12px;
                colorize: #ffffff;
            }
        }

        if (!root.is_task && !root.is_ordered) : Rectangle {
            width: 6px;
            height: 6px;
            y: 8px;
            border-radius: 3px;
            background: Tokens.text_secondary;
        }

        if (!root.is_task && root.is_ordered) : Text {
            text: root.prefix;
            font-family: root.font_family;
            font-size: Tokens.editor_font_size;
            color: Tokens.text_secondary;
            vertical-alignment: top;
        }

        item_text := StyledText {
            width: parent.width - 24px;
            text: root.rich_text;
            default-font-family: root.font_family;
            default-font-size: Tokens.editor_font_size;
            default-color: Tokens.text_primary;
        }
    }
}
