import { Tokens } from "../../shared/tokens.slint";
import { MarkdownParagraph } from "./paragraph.slint";
import { MarkdownHeading } from "./heading.slint";
import { MarkdownCode, CodeLine } from "./code.slint";
import { MarkdownBullet } from "./bullet.slint";
import { ThinkingCard } from "../reasoning/reasoning.slint";
import { DiffLine } from "../tools/diff.slint";
import { ToolCard } from "../tools/cards.slint";
import { PermissionCard } from "../permission/permission.slint";

// Struct representing a single block-level markdown item
export struct MarkdownItem {
    kind: string, // "p" (paragraph), "h1", "h2", "h3", "code", "bullet", "thinking", "tool", "permission"
    text: string,
    lang: string,
    code_lines: [CodeLine],
    
    // Tool Call Fields
    tool_name: string,
    tool_title: string,
    tool_args: string,
    tool_result: string,
    tool_status: string, // "running", "completed", "failed"
    tool_is_diff: bool,
    tool_diff_lines: [DiffLine],
    tool_added_count: int,
    tool_deleted_count: int,
    tool_call_id: string,

    // Permission Prompt Fields
    permission_id: string,
    permission_tool: string,
    permission_path: string,
    permission_reason: string,
    permission_args: string,
    permission_status: string, // "pending", "approved", "denied"
}

// Markdown renderer container that loops over MarkdownItems
export component MarkdownContent inherits VerticalLayout {
    in property <[MarkdownItem]> items: [];
    in property <bool> show-cursor: false;
    in property <bool> is-thinking: false;
    in property <string> font-family: Tokens.serif-font-family;
    in property <length> font-size: Tokens.body-font-size;
    
    // Callback fired when a code block's copy button is clicked
    callback code-copied(int /* item-index */);
    
    // Callbacks fired when permission prompts are resolved
    callback permission-approved(string /* permission_id */);
    callback permission-denied(string /* permission_id */);
    
    spacing: 8px;
    alignment: start;
    
    for item[idx] in root.items : VerticalLayout {
        // Calculate if this is the very last block element in the model
        property <bool> is-last: idx == root.items.length - 1;
        
        if (item.kind == "p") : MarkdownParagraph {
            text: item.text + (is-last && root.show-cursor ? "|" : "");
            font-family-custom: root.font-family;
            font-size-custom: root.font-size;
        }
        if (item.kind == "h1") : MarkdownHeading {
            level: 1;
            text: item.text + (is-last && root.show-cursor ? "|" : "");
        }
        if (item.kind == "h2") : MarkdownHeading {
            level: 2;
            text: item.text + (is-last && root.show-cursor ? "|" : "");
        }
        if (item.kind == "h3") : MarkdownHeading {
            level: 3;
            text: item.text + (is-last && root.show-cursor ? "|" : "");
        }
        if (item.kind == "code") : MarkdownCode {
            text: item.text + (is-last && root.show-cursor ? "|" : "");
            lang: item.lang;
            code-lines: item.code-lines;
            copy-clicked => {
                root.code-copied(idx);
            }
        }
        if (item.kind == "bullet") : MarkdownBullet {
            text: item.text + (is-last && root.show-cursor ? "|" : "");
            font-family-custom: root.font-family;
            font-size-custom: root.font-size;
        }
        if (item.kind == "thinking") : ThinkingCard {
            text: item.text;
            active: is-last && root.is-thinking;
        }
        if (item.kind == "tool") : ToolCard {
            tool-name: item.tool_name;
            tool-title: item.tool_title;
            tool-args: item.tool_args;
            tool-result: item.tool_result;
            tool-status: item.tool_status;
            tool-is-diff: item.tool_is_diff;
            tool-diff-lines: item.tool_diff_lines;
            tool-added-count: item.tool_added_count;
            tool-deleted-count: item.tool_deleted_count;
        }
        if (item.kind == "permission") : PermissionCard {
            permission-id: item.permission_id;
            permission-tool: item.permission_tool;
            permission-path: item.permission_path;
            permission-reason: item.permission_reason;
            permission-args: item.permission_args;
            permission-status: item.permission_status;
            
            approved => {
                root.permission-approved(item.permission_id);
            }
            denied => {
                root.permission-denied(item.permission_id);
            }
        }
    }
}
