// =============================================================================
// Master Markdown Renderer Component (`ui/markdown/markdown.slint`)
// =============================================================================
// Entry point component for rendering GitHub-flavored Markdown documents in Slint.
// Uses Slint 1.17's built-in `StyledText` element with the `styled-text` property
// type for native rich inline formatting.

import { Tokens } from "../../shared/tokens.slint";
import { MarkdownTableRow } from "./types.slint";
import { MarkdownHeading } from "./heading.slint";
import { MarkdownParagraph } from "./paragraph.slint";
import { MarkdownList } from "./list.slint";
import { MarkdownRule } from "./rule.slint";
import { MarkdownSpacer } from "./spacer.slint";
import { MarkdownTable } from "./table.slint";
import { MarkdownCodeBlock } from "./code_block.slint";
import { MarkdownDisplayMath } from "./math.slint";
import { MarkdownBlockQuote } from "./blockquote.slint";
import { MarkdownLink } from "./link.slint";
import { MarkdownMermaid } from "./mermaid.slint";
import { DiffLine } from "../tools/diff.slint";
import { WorkGroup } from "../work-group/work-group.slint";
import { WorkGroupItem } from "../work-group/types.slint";

// Enum specifying the block type of a Markdown AST element
export enum MarkdownBlockType {
    Heading,
    Paragraph,
    ListItem,
    Rule,
    Spacer,
    Table,
    CodeBlock,
    DisplayMath,
    BlockQuote,
    Link,
    Mermaid,
    WorkGroup,
}

// Struct representing a single parsed Markdown block element.
export struct MarkdownElement {
    block_type: MarkdownBlockType,
    // `text` is the plain-text fallback string (or target URL for links)
    text: string,
    // `rich_text` carries full inline bold/italic/code formatting
    rich_text: styled-text,
    level: int,
    is_ordered: bool,
    prefix: string,
    is_task: bool,
    is_checked: bool,
    depth: int,
    // Table rows for MarkdownBlockType.Table
    rows: [MarkdownTableRow],
    // Language identifier for MarkdownBlockType.CodeBlock (e.g. "rust", "js")
    language: string,
    // Rendered vector image for MarkdownBlockType.Mermaid
    diagram_image: image,

    // Thinking Card fields
    thinking_text: string,
    is_thinking_active: bool,

    // Tool Call fields
    tool_name: string,
    tool_title: string,
    tool_args: string,
    tool_result: string,
    tool_status: string, // "running", "completed", "failed"
    tool_is_diff: bool,
    tool_diff_lines: [DiffLine],
    tool_added_count: int,
    tool_deleted_count: int,
    tool_call_id: string,

    // Collapsed assistant work activity summary fields
    work_group_items: [WorkGroupItem],
    work_group_active: bool,
    work_group_elapsed_secs: int,
    work_group_expanded: bool,
    work_group_summary: string,

    // Permission Prompt fields
    permission_id: string,
    permission_tool: string,
    permission_path: string,
    permission_reason: string,
    permission_args: string,
    permission_status: string, // "pending", "approved", "denied"
}

// Main exported view component rendering the array of Markdown blocks
export component MarkdownView inherits VerticalLayout {
    in property <[MarkdownElement]> elements: [];
    in property <string> font_family: Tokens.font_family;
    in property <int> orb_style: 0; // 0=composing, 1=solving, 2=breathing
    callback open-url(string);
    callback copy-code(int /* element_index */);
    callback work-group-toggled(int /* element_index */);
    callback work-group-item-toggled(int /* element_index */, int /* item_index */);

    spacing: 0px;
    padding: 0px;
    width: 100%;

    for element[idx] in root.elements : VerticalLayout {
        spacing: 0px;
        padding: 0px;

        if (element.block_type == MarkdownBlockType.Heading) : MarkdownHeading {
            level: element.level;
            rich_text: element.rich_text;
            font_family: root.font_family;
        }

        if (element.block_type == MarkdownBlockType.Paragraph) : MarkdownParagraph {
            rich_text: element.rich_text;
            font_family: root.font_family;
        }

        if (element.block_type == MarkdownBlockType.ListItem) : MarkdownList {
            text: element.text;
            rich_text: element.rich_text;
            depth: element.depth;
            is_ordered: element.is_ordered;
            prefix: element.prefix;
            is_task: element.is_task;
            is_checked: element.is_checked;
            font_family: root.font_family;
        }

        if (element.block_type == MarkdownBlockType.Rule) : MarkdownRule {}

        if (element.block_type == MarkdownBlockType.Spacer) : MarkdownSpacer {
            level: element.level;
        }

        if (element.block_type == MarkdownBlockType.Table) : MarkdownTable {
            rows: element.rows;
        }

        if (element.block_type == MarkdownBlockType.CodeBlock) : MarkdownCodeBlock {
            rich_text: element.rich_text;
            language: element.language;

            copy-clicked => {
                root.copy-code(idx);
            }
        }

        if (element.block_type == MarkdownBlockType.DisplayMath) : MarkdownDisplayMath {
            rich_text: element.rich_text;
        }

        if (element.block_type == MarkdownBlockType.BlockQuote) : MarkdownBlockQuote {
            rich_text: element.rich_text;
            depth: element.depth;
            font_family: root.font_family;
        }

        if (element.block_type == MarkdownBlockType.Link) : MarkdownLink {
            rich_text: element.rich_text;
            url: element.text;

            open-url(url) => {
                root.open-url(url);
            }
        }

        if (element.block_type == MarkdownBlockType.Mermaid) : MarkdownMermaid {
            diagram_image: element.diagram_image;
        }

        if (element.block_type == MarkdownBlockType.WorkGroup) : WorkGroup {
            items: element.work_group_items;
            is-active: element.work_group_active;
            elapsed-secs: element.work_group_elapsed_secs;
            expanded: element.work_group_expanded;
            summary-text: element.work_group_summary;
            orb-style: root.orb_style;

            toggle-expanded => {
                root.work-group-toggled(idx);
            }

            item-toggled(item_idx) => {
                root.work-group-item-toggled(idx, item_idx);
            }
        }
    }
}
