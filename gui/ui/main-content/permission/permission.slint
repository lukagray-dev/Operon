// Slint UI component for interactive action/directory permissions.
//
// Prompts the user with target commands/paths, details the warning policy,
// and presents interactive Allow and Deny buttons to resume/abort the runner.

import { Tokens } from "../../shared/tokens.slint";


// Hover target text component that exposes the hover state of the filename/command cleanly.
component HoverableTarget inherits Rectangle {
    in property <string> text;
    in-out property <bool> hovered: touch.has-hover;

    width: text-el.preferred-width;
    height: text-el.preferred-height;

    text-el := Text {
        text: root.text;
        color: root.hovered ? #ffb300 : #81c784;
        font-size: 13px;
        font-weight: 600;
        font-family: Tokens.font_family;

        animate color { duration: 100ms; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
    }
}

// Cleaner, floating panel attached to the prompt input box.
// Displays a friendly, humanized target summary, and lists absolute paths as tooltips on hover.
export component FloatingPermissionPanel inherits Rectangle {
    in property <string> permission-id: "";
    in property <string> permission-tool: "";
    in property <string> permission-path: "";
    in property <string> permission-reason: "";
    in property <string> display-action: "";
    in property <string> display-target: "";

    callback approved();
    callback denied();

    in-out property <bool> target-hovered: false;

    background: Tokens.titlebar-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 179, 0, 0.3); // Warm amber glow for pending action
    
    drop-shadow-blur: 8px;
    drop-shadow-color: rgba(0, 0, 0, 0.4);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Image {
                source: @image-url("../../../assets/icons/settings/lock.svg");
                width: 14px;
                height: 14px;
                colorize: #ffb300;
            }

            HorizontalLayout {
                spacing: 4px;

                Text {
                    text: "Operon wants to " + root.display-action;
                    color: Tokens.text-primary;
                    font-size: 13px;
                    font-weight: 500;
                    font-family: Tokens.font_family;
                }

                if (root.display-target != "") : target-container := HoverableTarget {
                    text: root.display-target;
                    hovered <=> root.target-hovered;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            deny-btn := TouchArea {
                clicked => { root.denied(); }
                Rectangle {
                    background: deny-btn.has-hover ? rgba(244, 67, 54, 0.15) : rgba(244, 67, 54, 0.08);
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: rgba(244, 67, 54, 0.2);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        Text {
                            text: "Deny";
                            color: #ef9a9a;
                            font-size: 11px;
                            font-weight: 600;
                            font-family: Tokens.font_family;
                        }
                    }
                }
            }

            allow-btn := TouchArea {
                clicked => { root.approved(); }
                Rectangle {
                    background: allow-btn.has-hover ? rgba(76, 175, 80, 0.15) : rgba(76, 175, 80, 0.08);
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: rgba(76, 175, 80, 0.2);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        Text {
                            text: "Allow";
                            color: #a5d6a7;
                            font-size: 11px;
                            font-weight: 600;
                            font-family: Tokens.font_family;
                        }
                    }
                }
            }
        }
    }

    // Hover tooltip to display absolute location or description details
    if (root.target-hovered && (root.permission-path != "" || root.permission-reason != "")) : Rectangle {
        x: 40px;
        y: -42px;
        background: #1a1a1a;
        border-radius: 4px;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.08);
        drop-shadow-blur: 6px;
        drop-shadow-color: rgba(0, 0, 0, 0.5);

        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 2px;

            if (root.permission-path != "") : Text {
                text: root.permission-path;
                color: #a5d6a7;
                font-size: 11px;
                font-family: Tokens.mono-font-family;
            }
            if (root.permission-reason != "") : Text {
                text: "Reason: " + root.permission-reason;
                color: #888888;
                font-size: 11px;
                font-family: Tokens.font_family;
            }
        }
    }
}
