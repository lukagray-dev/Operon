// Topbar component for the main content area.
//
// This component acts as the unified header bar at the top of the main chat area.
// Currently it wires and displays the active session title, but it is structured
// to scale for future toolbar controls, actions, and status indicators.
//
// The topbar matches the main content background and includes a bottom separator.

import { Tokens } from "../../shared/tokens.slint";
import { SessionTitle } from "./title.slint";
import { TerminalButton } from "./terminal.slint";
import { GitCommitButton } from "./git-commit.slint";

export component Topbar inherits Rectangle {
    // Active session/conversation title to display
    in property <string> title: "New Session";

    // Project session indicator and quick git diff stats
    in property <bool> is-project-session: false;
    in property <int> git-insertions: 0;
    in property <int> git-deletions: 0;

    // Callbacks for the action buttons
    callback terminal-clicked();
    callback git-commit-clicked();

    // Fixed height for the header bar (slimmer height)
    height: 40px;
    horizontal-stretch: 1;

    // Background color matches the main content area
    background: Tokens.window-background;

    // Horizontal layout for padding and positioning the elements
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        
        // 1. Session Title (aligned to left)
        HorizontalLayout {
            alignment: start;
            SessionTitle {
                text: root.title;
                // Center the text vertically within the 40px bar
                vertical-alignment: center;
            }
        }

        // 2. Middle Spacer (stretches to push buttons to the right)
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        // 3. Right Action Buttons
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // Terminal button
                TerminalButton {
                    clicked => {
                        root.terminal-clicked();
                    }
                }

                // Git Commit / Diff button (always visible in topbar)
                GitCommitButton {
                    insertions: root.git-insertions;
                    deletions: root.git-deletions;
                    clicked => {
                        root.git-commit-clicked();
                    }
                }
            }
        }
    }

    // Light separator border line at the bottom of the topbar
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.dropdown-border;
        horizontal-stretch: 1;
    }
}
