// Git commit button component for the topbar action bar.
//
// This component provides an icon button that allows users to perform or view
// Git commits/version control options. It follows the topbar action button
// visual style with smooth hover highlight transitions.

import { Tokens } from "../../shared/tokens.slint";

// Git commit action button.
export component GitCommitButton inherits Rectangle {
    // Callback fired when the button is clicked
    callback clicked();

    // Quick stats properties for changes badge (+X -Y)
    in property <int> insertions: 0;
    in property <int> deletions: 0;

    height: 28px;
    min-width: 28px;
    horizontal-stretch: 0;
    border-radius: 4px;
    
    // Background highlight on hover
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : transparent;
    
    // Smooth transition for background hover state
    animate background { duration: 150ms; easing: ease-in-out; }

    content-layout := HorizontalLayout {
        alignment: center;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            // Git commit icon
            Image {
                source: @image-url("../../../assets/icons/main-content/topbar/git-commit.svg");
                width: 16px;
                height: 16px;
                // Brightens up to text-primary on hover, default to text-secondary
                colorize: touch-area.has-hover 
                    ? Tokens.text-primary 
                    : Tokens.text-secondary;
                image-fit: contain;
                
                // Smooth transition for icon color change
                animate colorize { duration: 150ms; easing: ease-in-out; }
            }
        }

        // Quick insertions/deletions badge
        if (root.insertions > 0 || root.deletions > 0) : VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;

                if (root.insertions > 0) : Text {
                    text: "+" + root.insertions;
                    font-size: 11px;
                    font-weight: 600;
                    color: #23d18b;
                    vertical-alignment: center;
                }
                if (root.deletions > 0) : Text {
                    text: "-" + root.deletions;
                    font-size: 11px;
                    font-weight: 600;
                    color: #f14c4c;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
