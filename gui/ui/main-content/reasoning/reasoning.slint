// Reasoning / Thinking card component for the Operon GUI.
//
// This component displays the chain-of-thought reasoning process of the AI model.
// It is collapsible, styled with premium dark-mode tones, and auto-scrolls
// to the bottom during live streaming.

import { Tokens } from "../../shared/tokens.slint";

export component ThinkingCard inherits Rectangle {
    // The accumulated reasoning text
    in property <string> text: "";
    
    // Whether the model is actively reasoning/thinking
    in property <bool> active: false;
    
    // Collapsed state of the card
    in-out property <bool> collapsed: !active;

    // Hover detection state
    property <bool> has-hover: header-touch.has-hover;

    // Pulse animation phase for the thinking icon
    in-out property <float> pulse-opacity: 0.6;

    // Visual attributes matching the Tauri reference design system
    background: has-hover ? rgba(255, 255, 255, 0.025) : rgba(255, 255, 255, 0.015);
    border-radius: 6px;
    border-width: 1px;
    border-color: has-hover ? rgba(255, 255, 255, 0.08) : rgba(255, 255, 255, 0.04);

    // Smooth hover transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    animate border-color { duration: 150ms; easing: ease-in-out; }

    // Pulsing animation for the thinking icon
    animate pulse-opacity {
        duration: 900ms;
        easing: ease-in-out;
    }
    
    pulse-timer := Timer {
        interval: 900ms;
        running: root.active;
        triggered => {
            if (root.pulse-opacity < 0.5) {
                root.pulse-opacity = 0.8;
            } else {
                root.pulse-opacity = 0.4;
            }
        }
    }

    // Force expand card when active thinking starts
    changed active => {
        if (root.active) {
            root.collapsed = false;
        } else {
            root.collapsed = true;
        }
    }

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // ===== HEADER AREA (CLICKABLE TOGGLE) =====
        header-touch := TouchArea {
            clicked => {
                root.collapsed = !root.collapsed;
            }
            
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                alignment: start;
                
                // Thinking status icon - rotates when collapsed
                Image {
                    source: @image-url("../../../assets/icons/main-content/messages/assistant/thinking.svg");
                    width: 14px;
                    height: 14px;
                    colorize: header-touch.has-hover ? #999999 : #777777;
                    opacity: root.active ? root.pulse-opacity : 0.6;
                    
                    transform-rotation: root.collapsed ? -90deg : 0deg;
                    
                    animate transform-rotation {
                        duration: 200ms;
                        easing: ease-in-out;
                    }
                    animate colorize { duration: 150ms; }
                }
                
                Text {
                    text: root.active ? "Thinking..." : "Thinking Process";
                    color: header-touch.has-hover ? #999999 : #777777;
                    font-size: 12.5px;
                    font-weight: 500;
                    font-family: Tokens.font_family;
                    vertical-alignment: center;
                    
                    animate color { duration: 150ms; }
                }
            }
        }

        // ===== CONTENT AREA (COLLAPSIBLE / SCROLLABLE VIEWPORT) =====
        if (!root.collapsed) : VerticalLayout {
            // Horizontal border line separating header and content
            Rectangle {
                height: 1px;
                background: rgba(255, 255, 255, 0.04);
            }
            
            Rectangle {
                background: rgba(0, 0, 0, 0.1);
                
                // Limit visible height to approximately 10 lines of text (180px)
                height: Math.min(180px, text-layout.preferred-height);
                
                flickable := Flickable {
                    width: 100%;
                    height: parent.height;
                    viewport-height: text-layout.preferred-height;
                    interactive: true;
                    
                    // Internal scroll target to handle automated delta tracking
                    property <length> target-scroll-y: 0px;
                    viewport-y: self.target-scroll-y;
                    
                    // Enable auto-scrolling to the bottom as new content streams in
                    changed viewport-height => {
                        self.target-scroll-y = Math.min(0px, parent.height - self.viewport-height);
                    }
                    
                    // Smooth ease-out target tracking during streaming
                    animate viewport-y {
                        duration: 100ms;
                        easing: ease-out;
                    }
                    
                    // Intercept scroll wheel events for desktop mouse wheel support
                    TouchArea {
                        width: 100%;
                        height: max(flickable.height, flickable.viewport-height);
                        scroll-event(e) => {
                            flickable.target-scroll-y = Math.clamp(
                                flickable.target-scroll-y + e.delta-y,
                                Math.min(0px, flickable.height - flickable.viewport-height),
                                0px
                            );
                            EventResult.accept
                        }
                    }
                    
                    text-layout := VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        
                        Text {
                            text: root.text;
                            color: #999999;
                            font-size: 12.5px;
                            font-family: Tokens.font_family;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
