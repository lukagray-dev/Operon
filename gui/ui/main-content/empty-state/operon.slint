// Operon brand logo component for the empty state screen.
//
// This component displays the Operon logo in a larger size when there are no
// messages in the conversation. It serves as the primary visual element in the
// empty state, establishing brand identity and creating a welcoming entry point
// for new conversations.
//
// The logo is displayed in its original colorful form (not colorized) to maintain
// brand consistency and visual appeal during the initial user experience.

import { Tokens } from "../../shared/tokens.slint";

// Large Operon logo for empty state display.
// Centered in the main content area above the intro text.
export component OperonLogo inherits Image {
    // The logo has a fixed size - larger than the small logo in other contexts
    // to create a strong visual presence in the empty state
    source: @image-url("../../../assets/brand/operon.svg");
    width: 120px;
    height: 120px;
    // Don't colorize - show the original colorful brand logo
    image-fit: contain;
}
