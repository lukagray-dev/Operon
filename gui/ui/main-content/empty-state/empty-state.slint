// Empty state component for the main content area.
//
// Displayed when no conversation session is active or loaded.
// Shows the Operon brand logo centered in the viewport with a
// tagline underneath. Matches the Tauri reference design exactly:
//   - 64px brand logo at 0.9 opacity, centered
//   - Tagline text in muted gray (#6e6e6e), 16px, centered
//   - Max container width of 400px for readable line lengths
//   - Vertically + horizontally centered in the full viewport

import { Tokens } from "../../shared/tokens.slint";

// The root empty state component. Place it as a sibling of the
// messages area inside main-content and toggle its visibility
// based on whether a session is active.
export component EmptyState inherits Rectangle {
    background: transparent;

    // Full-size flex container that centers its children both axes
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            // Inner container constrains tagline width for readability
            VerticalLayout {
                alignment: center;
                spacing: 24px;
                max-width: 400px;

                // ===== BRAND LOGO =====
                // Centered Operon logo at 64x64, slightly dimmed (0.9 opacity)
                HorizontalLayout {
                    alignment: center;

                    Image {
                        source: @image-url("../../../assets/brand/operon.svg");
                        width: 64px;
                        height: 64px;
                        image-fit: contain;
                        opacity: 0.9;
                    }
                }

                // ===== TAGLINE =====
                // Two-line tagline matching the Tauri reference wording.
                // Uses the primary app font (Google Sans) at muted color.
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    // Line 1: "Agent that is built for everyone,"
                    Text {
                        text: "Agent that is built for everyone,";
                        font-family: Tokens.font-family;
                        font-size: 16px;
                        font-weight: 400;
                        color: #6e6e6e;
                        horizontal-alignment: center;
                    }

                    // Line 2: "— not just for developers."
                    Text {
                        text: "— not just for developers.";
                        font-family: Tokens.font-family;
                        font-size: 16px;
                        font-weight: 400;
                        color: #6e6e6e;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
