// Empty state component for the main content area.
//
// This component is displayed when there are no messages in the conversation
// or when a new session is started. It consists of:
// 1. Large Operon logo (120px) - centered
// 2. Introductory text - two lines below the logo
//
// The entire empty state is centered both horizontally and vertically within
// the main content area, creating a welcoming and balanced initial state.

import { Tokens } from "../../shared/tokens.slint";
import { OperonLogo } from "./operon.slint";
import { IntroText } from "./intro.slint";

// Empty state display for new conversations.
// Centered in the main content area with logo and intro text.
export component EmptyState {
    // Use VerticalLayout as the root to stack logo and text
    VerticalLayout {
        alignment: center;
        spacing: 24px;  // Space between logo and text
        
        // Operon brand logo
        OperonLogo {
            // Logo is already sized at 120x120px
        }
        
        // Introductory text
        IntroText {
            // Text component is already configured with proper styling
        }
    }
}
