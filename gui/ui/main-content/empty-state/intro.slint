// Introductory text component for the empty state screen.
//
// This component displays a welcoming message below the Operon logo when
// starting a new conversation or when no messages are present. The text
// is structured in two lines:
// 1. "The autonomous AI agent built for everyone" - in normal style
// 2. "not just developers" - in italic style for emphasis
//
// The text uses a centered layout and appropriate styling to create a
// professional, welcoming first impression for users.

import { Tokens } from "../../shared/tokens.slint";

// Introductory text for empty state display.
// Positioned below the Operon logo, centered in the content area.
export component IntroText inherits VerticalLayout {
    // Vertical layout to stack the two text lines
    alignment: center;
    spacing: 4px;
    
    // First line: "The autonomous AI agent built for everyone"
    // Normal text style
    Text {
        text: "The autonomous AI agent built for everyone";
        color: Tokens.text-primary;
        font-size: 16px;
        font-family: Tokens.font-family;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    
    // Second line: "not just developers"
    // Italic style for subtle emphasis
    Text {
        text: "not just developers";
        color: Tokens.text-secondary;
        font-size: 14px;
        font-family: Tokens.font-family;
        font-weight: 400;
        // Note: Slint doesn't have a direct font-style: italic property
        // The italic style is achieved through the font family or styling
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
