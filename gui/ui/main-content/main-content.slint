// Main content area component for the Operon GUI.
//
// This component represents the central area of the application where:
// - Chat messages are displayed (scrollable area above)
// - The input panel floats at the bottom for user prompts
// - A scrollbar appears on the right edge when content overflows
//
// Layout structure:
// ┌─────────────────────────────────────────────────────────┐
// │                                                         │ ▲
// │  [Chat messages will be displayed here]                 │ │
// │                                                         │ │ Scrollbar
// │                                                         │ │
// │  ┌───────────────────────────────────────────────────┐  │ │
// │  │ [Input Panel - floating at bottom]                │  │ │
// │  └───────────────────────────────────────────────────┘  │ ▼
// └─────────────────────────────────────────────────────────┘
//
// The input panel is positioned absolutely at the bottom with proper padding,
// creating a floating effect over the chat messages area.

import { Tokens } from "../shared/tokens.slint";
import { InputPanel } from "./input/input.slint";
import { Topbar } from "./topbar/topbar.slint";
import { WarningText } from "./input/warning.slint";
import { TerminalPanel } from "./terminal/terminal.slint";
import { FloatingPermissionPanel } from "./permission/permission.slint";
import { MessageList, ChatMessage } from "./messages/message-list.slint";
export { ChatMessage }

// Main content area component that contains the chat interface.
// This is the primary workspace where users interact with the AI agent.
export component MainContent inherits Rectangle {
    // ===== Input Panel Width Control =====
    // **ADJUST THIS VALUE** to change the maximum width of the input panel
    // Recommended range: 700px - 1200px
    // Default: 900px (increased from 800px for a wider panel)
    in property <length> input-panel-max-width: 900px;
    
    // ===== Input Panel Properties =====
    // These properties are exposed to allow parent components to control
    // and monitor the input panel state
    
    // Current text in the input field
    in-out property <string> input-text: "";
    
    // Selected model and settings
    in-out property <string> selected-model: "";
    in-out property <string> selected-reasoning: "";
    in-out property <bool> auto-approve-enabled: false;
    
    // Context window information
    in property <float> context-usage: 0.0;
    in property <int> tokens-used: 0;
    in property <int> tokens-total: 0;
    
    // Voice recording state
    in-out property <bool> is-recording: false;
    
    // Generator / responding state
    in-out property <bool> is-responding: false;
    in property <bool> cursor-blink: true;
    
    // Session loading state
    in-out property <bool> is-loading-session: false;
    
    // Discovered models list and inline context indicator values
    in property <string> context-text: "";
    in property <[string]> available-models: [];

    // ===== Terminal Properties & Callbacks =====
    in property <[string]> terminal-tab-names: [];
    in-out property <int> terminal-active-tab: -1;
    in-out property <length> terminal-height: 220px;
    in property <string> terminal-text: "";

    callback terminal-tab-clicked(int);
    callback terminal-tab-close-clicked(int);
    callback terminal-tab-new-clicked();
    callback terminal-key-pressed(int, string);

    // ===== Message Properties =====
    // Array of user and assistant messages to display in the chat
    in property <[ChatMessage]> chat-messages: [];

    // ===== Active/Pending Permission Properties =====
    in property <bool> has-pending-permission: false;
    in property <string> pending-permission-id: "";
    in property <string> pending-permission-tool: "";
    in property <string> pending-permission-path: "";
    in property <string> pending-permission-reason: "";
    in property <string> pending-permission-action: "";
    in property <string> pending-permission-target: "";
    
    // Session title property
    in property <string> session-title: "New Session";
    
    // State of terminal drawer panel
    in-out property <bool> is-terminal-open: false;

    
    // ===== Callbacks =====
    // Forward all input panel callbacks to parent
    callback message-submitted(string /* message-text */);
    callback attach-clicked();
    callback auto-approve-toggled(bool /* enabled */);
    callback context-clicked();
    callback model-clicked();
    callback reasoning-clicked();
    callback voice-clicked();
    callback voice-recording-started();
    callback voice-recording-stopped();
    callback model-selected(string /* selected-model */);
    callback cancel-clicked();
    
    // Message action callbacks
    callback message-edit-clicked(int /* message-index */);
    callback message-copy-clicked(int /* message-index */);
    
    // Assistant message action callbacks
    callback assistant-copy-clicked(int /* message-index */);
    callback assistant-like-clicked(int /* message-index */);
    callback assistant-dislike-clicked(int /* message-index */);
    callback assistant-regenerate-clicked(int /* message-index */);
    callback assistant_fork_clicked(int /* message-index */);
    callback code-copied(int /* message-index */, int /* item-index */);
    
    // Callbacks for permission approved/denied actions
    callback permission_approved(string /* permission_id */);
    callback permission_denied(string /* permission_id */);
    
    // ===== Layout =====
    // FocusScope used to clear focus from input fields when clicking outside
    focus-scope := FocusScope {}

    // Main content background
    background: Tokens.window-background;
    
    // Vertical layout to organize content
    VerticalLayout {
        // ===== TOPBAR =====
        // Unified header containing session title and potential top bar actions
        topbar := Topbar {
            title: root.session-title;
            
            // Toggle terminal visibility when the terminal button is clicked
            terminal-clicked => {
                root.is-terminal-open = !root.is-terminal-open;
                if (root.is-terminal-open && root.terminal-tab-names.length == 0) {
                    root.terminal-tab-new-clicked();
                }
            }
        }

        // ===== MAIN CONTENT BODY (Messages scroll area + Floating input panel) =====
        main-body := Rectangle {
            vertical-stretch: 1;

            // 1. Messages Scroll Area
            messages-area := MessageList {
                width: 100%;
                height: 100%;
                input-panel-max-width: root.input-panel-max-width;
                chat-messages: root.chat-messages;
                is-loading-session: root.is-loading-session;
                is-responding: root.is-responding;
                cursor-blink: root.cursor-blink;

                message-edit-clicked(idx) => {
                    root.message-edit-clicked(idx);
                }
                message-copy-clicked(idx) => {
                    root.message-copy-clicked(idx);
                }
                assistant-copy-clicked(idx) => {
                    root.assistant-copy-clicked(idx);
                }
                assistant-like-clicked(idx) => {
                    root.assistant-like-clicked(idx);
                }
                assistant-dislike-clicked(idx) => {
                    root.assistant-dislike-clicked(idx);
                }
                assistant-regenerate-clicked(idx) => {
                    root.assistant-regenerate-clicked(idx);
                }
                assistant-fork-clicked(idx) => {
                    root.assistant-fork-clicked(idx);
                }
                code-copied(msg-idx, item-idx) => {
                    root.code-copied(msg-idx, item-idx);
                }
                permission-approved(id) => {
                    root.permission-approved(id);
                }
                permission-denied(id) => {
                    root.permission-denied(id);
                }
            }

            // 2. Floating Input Overlay
            // Positioned absolutely at the bottom of the body viewport, rendering on top of messages.
            // Spans the full width, but has a transparent background so messages and the scrollbar
            // remain fully visible underneath it.
            floating-input-overlay := Rectangle {
                y: parent.height - self.height;
                width: parent.width;
                height: floating-layout.preferred-height;
                background: transparent;

                // Click background outside input box to deselect input panel
                TouchArea {
                    clicked => {
                        focus-scope.focus();
                    }
                }

                floating-layout := VerticalLayout {
                    padding-top: 16px; // Smooth transition zone for the fading text
                    spacing: 8px;

                    // Centered Floating Permission Panel
                    if (root.has-pending-permission) : HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                        
                        FloatingPermissionPanel {
                            width: input-panel.width;
                            permission-id: root.pending-permission-id;
                            permission-tool: root.pending-permission-tool;
                            permission-path: root.pending-permission-path;
                            permission-reason: root.pending-permission-reason;
                            display-action: root.pending-permission-action;
                            display-target: root.pending-permission-target;
                            
                            approved => {
                                root.permission_approved(root.pending-permission-id);
                            }
                            denied => {
                                root.permission_denied(root.pending-permission-id);
                            }
                        }
                        
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                    }

                    // Center the input panel horizontally
                    HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                        
                        input-panel := InputPanel {
                            min-width: 400px;
                            max-width: root.input-panel-max-width;
                            horizontal-stretch: 1;
                            
                            // Bind all properties
                            input-text <=> root.input-text;
                            selected-model <=> root.selected-model;
                            selected-reasoning <=> root.selected-reasoning;
                            auto-approve-enabled <=> root.auto-approve-enabled;
                            context-usage: root.context-usage;
                            tokens-used: root.tokens-used;
                            tokens-total: root.tokens-total;
                            is-recording <=> root.is-recording;
                            context-text: root.context-text;
                            available-models: root.available-models;
                            is-responding <=> root.is-responding;
                            
                            // Forward all callbacks
                            cancel-clicked => {
                                root.cancel-clicked();
                            }
                            
                            message-submitted(text) => {
                                root.message-submitted(text);
                            }
                            
                            attach-clicked => {
                                root.attach-clicked();
                            }
                            
                            auto-approve-toggled(enabled) => {
                                root.auto-approve-toggled(enabled);
                            }
                            
                            context-clicked => {
                                root.context-clicked();
                            }
                            
                            model-clicked => {
                                root.model-clicked();
                            }
                            
                            reasoning-clicked => {
                                root.reasoning-clicked();
                            }
                            
                            voice-clicked => {
                                root.voice-clicked();
                            }
                            
                            voice-recording-started => {
                                root.voice-recording-started();
                            }
                            
                            voice-recording-stopped => {
                                root.voice-recording-stopped();
                            }
                            
                            model-selected(model) => {
                                root.model-selected(model);
                            }
                        }
                        
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                    }
                    
                    // Center the warning text below the input panel
                    warning-container := Rectangle {
                        height: 22px;
                        background: transparent;
                        
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                            
                            warning-text := WarningText {
                                min-width: 400px;
                                max-width: root.input-panel-max-width;
                                horizontal-stretch: 1;
                            }
                            
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                        }
                    }
                }
            }
        }
        
        // ===== TERMINAL PANEL =====
        // Resizable bottom terminal drawer that pushes the chat viewport up when visible
        if (root.is-terminal-open) : terminal-panel := TerminalPanel {
            max-height-limit: root.height * 0.75;
            tab-names: root.terminal-tab-names;
            active-tab <=> root.terminal-active-tab;
            terminal-height <=> root.terminal-height;
            terminal-text: root.terminal-text;

            tab-clicked(idx) => { root.terminal-tab-clicked(idx); }
            tab-close-clicked(idx) => { root.terminal-tab-close-clicked(idx); }
            tab-new-clicked => { root.terminal-tab-new-clicked(); }
            key-pressed(idx, key) => { root.terminal-key-pressed(idx, key); }
        }
    }

}
