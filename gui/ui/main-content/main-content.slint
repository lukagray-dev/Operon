// Main content area component for the Operon GUI.
//
// This component represents the central area of the application where:
// - Chat messages are displayed (scrollable area above)
// - The input panel floats at the bottom for user prompts
// - A scrollbar appears on the right edge when content overflows
//
// Layout structure:
// ┌─────────────────────────────────────────────────────────┐
// │                                                         │ ▲
// │  [Chat messages will be displayed here]                 │ │
// │                                                         │ │ Scrollbar
// │                                                         │ │
// │  ┌───────────────────────────────────────────────────┐  │ │
// │  │ [Input Panel - floating at bottom]                │  │ │
// │  └───────────────────────────────────────────────────┘  │ ▼
// └─────────────────────────────────────────────────────────┘
//
// The input panel is positioned absolutely at the bottom with proper padding,
// creating a floating effect over the chat messages area.

import { Tokens } from "../shared/tokens.slint";
import { InputPanel } from "./input/input.slint";
import { UserMessage } from "./messages/user/user.slint";
import { AssistantMessage } from "./messages/assistant/assistant.slint";
import { Topbar } from "./topbar/topbar.slint";
import { WarningText } from "./input/warning.slint";

// Main content area component that contains the chat interface.
// This is the primary workspace where users interact with the AI agent.
export component MainContent inherits Rectangle {
    // ===== Input Panel Width Control =====
    // **ADJUST THIS VALUE** to change the maximum width of the input panel
    // Recommended range: 700px - 1200px
    // Default: 900px (increased from 800px for a wider panel)
    in property <length> input-panel-max-width: 900px;
    
    // ===== Input Panel Properties =====
    // These properties are exposed to allow parent components to control
    // and monitor the input panel state
    
    // Current text in the input field
    in-out property <string> input-text: "";
    
    // Selected model and settings
    in-out property <string> selected-model: "Claude Sonnet 4.5";
    in-out property <string> selected-reasoning: "Medium";
    in-out property <bool> auto-approve-enabled: false;
    
    // Context window information
    in property <float> context-usage: 0.35;
    in property <int> tokens-used: 35000;
    in property <int> tokens-total: 100000;
    
    // Voice recording state
    in-out property <bool> is-recording: false;
    
    // ===== Message Properties =====
    // Array of user messages to display in the chat
    // In a real implementation, this would be a model containing all messages
    // For now, we'll use simple properties to demonstrate the layout
    in property <string> demo-user-message: "This is a sample user message to demonstrate the layout. It can be quite long and will wrap to multiple lines. When the message exceeds 10 lines, a 'Show more' button will appear to expand the full content.";
    in property <string> demo-assistant-message: "This is a sample assistant message using PT Serif font. The assistant's response appears without a bubble, spanning the full width of the input panel. Below this message, you'll find action buttons for copying, liking, regenerating, and more.";
    in property <string> demo-time: "2m ago";
    
    // Session title property
    in property <string> session-title: "New Session";
    
    // ===== Callbacks =====
    // Forward all input panel callbacks to parent
    callback message-submitted(string /* message-text */);
    callback attach-clicked();
    callback auto-approve-toggled(bool /* enabled */);
    callback context-clicked();
    callback model-clicked();
    callback reasoning-clicked();
    callback voice-clicked();
    callback voice-recording-started();
    callback voice-recording-stopped();
    
    // Message action callbacks
    callback message-edit-clicked(int /* message-index */);
    callback message-copy-clicked(int /* message-index */);
    
    // Assistant message action callbacks
    callback assistant-copy-clicked(int /* message-index */);
    callback assistant-like-clicked(int /* message-index */);
    callback assistant-dislike-clicked(int /* message-index */);
    callback assistant-regenerate-clicked(int /* message-index */);
    callback assistant-fork-clicked(int /* message-index */);
    
    // ===== Layout =====
    // Main content background
    background: Tokens.window-background;
    
    // Vertical layout to organize content
    VerticalLayout {
        // ===== TOPBAR =====
        // Unified header containing session title and potential top bar actions
        topbar := Topbar {
            title: root.session-title;
        }

        // ===== MAIN CONTENT BODY (Messages scroll area + Floating input panel) =====
        // This container holds both the scrollable message viewport and the absolute
        // floating input overlay. Because they are sibling children of a Rectangle (not in a layout),
        // they overlay each other. The input overlay sits at the bottom, and messages scroll behind it.
        main-body := Rectangle {
            vertical-stretch: 1;

            // 1. Messages Scroll Area
            // Covers the full width and height of the body area.
            messages-area := Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;
                
                // Flickable container for scrolling through messages
                messages-flickable := Flickable {
                    width: parent.width;
                    height: parent.height;
                    
                    // Viewport height is computed dynamically to match the inner content layout
                    viewport-height: messages-inner-layout.preferred-height;
                    interactive: true;
                    
                    // Content container for all messages
                    messages-content := Rectangle {
                        width: parent.width;
                        height: messages-inner-layout.preferred-height;
                        background: transparent;
                        
                        // Horizontal layout to center the message column
                        messages-inner-layout := HorizontalLayout {
                            padding-top: 24px;
                            // Large bottom padding of 180px ensures the last message can be scrolled
                            // completely clear of the floating input panel.
                            padding-bottom: 180px;
                            
                            // Left spacer - matches the input panel side margins
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                            
                            // Messages inner container - matches input panel width limits
                            messages-inner := Rectangle {
                                min-width: 400px;
                                max-width: root.input-panel-max-width;
                                horizontal-stretch: 1;
                                background: transparent;
                                
                                // Vertical layout for stacking messages
                                VerticalLayout {
                                    spacing: 24px;
                                    alignment: start;
                                    
                                    // Demo user message to show the layout
                                    demo-user-message := UserMessage {
                                        message-text: root.demo-user-message;
                                        // Calculated based on root width to avoid layout binding loops
                                        max-bubble-width: (root.width < root.input-panel-max-width ? root.width : root.input-panel-max-width) * 0.75;
                                        
                                        // Forward callbacks
                                        edit-clicked => {
                                            root.message-edit-clicked(0);
                                        }
                                        
                                        copy-clicked => {
                                            root.message-copy-clicked(0);
                                        }
                                    }
                                    
                                    // Demo assistant message to show the layout
                                    demo-assistant-message := AssistantMessage {
                                        message-text: root.demo-assistant-message;
                                        time-text: root.demo-time;
                                        
                                        // Forward callbacks
                                        copy-clicked => {
                                            root.assistant-copy-clicked(0);
                                        }
                                        
                                        like-clicked => {
                                            root.assistant-like-clicked(0);
                                        }
                                        
                                        dislike-clicked => {
                                            root.assistant-dislike-clicked(0);
                                        }
                                        
                                        regenerate-clicked => {
                                            root.assistant-regenerate-clicked(0);
                                        }
                                        
                                        fork-clicked => {
                                            root.assistant-fork-clicked(0);
                                        }
                                    }
                                }
                            }
                            
                            // Right spacer - matches the input panel side margins
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                        }
                    }
                }
            }

            // 2. Floating Input Overlay
            // Positioned absolutely at the bottom of the body viewport, rendering on top of messages.
            // Uses a premium linear-gradient background to fade messages out smoothly as they scroll under.
            floating-input-overlay := Rectangle {
                y: parent.height - self.height;
                width: parent.width;
                height: floating-layout.preferred-height;
                
                // Linear gradient fade effect from transparent (at the top edge) to window-background (where the input sits)
                background: @linear-gradient(180deg, transparent 0%, Tokens.window-background 20%, Tokens.window-background 100%);

                floating-layout := VerticalLayout {
                    padding-top: 16px; // Smooth transition zone for the fading text

                    // Center the input panel horizontally
                    HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                        
                        input-panel := InputPanel {
                            min-width: 400px;
                            max-width: root.input-panel-max-width;
                            horizontal-stretch: 1;
                            
                            // Bind all properties
                            input-text <=> root.input-text;
                            selected-model <=> root.selected-model;
                            selected-reasoning <=> root.selected-reasoning;
                            auto-approve-enabled <=> root.auto-approve-enabled;
                            context-usage: root.context-usage;
                            tokens-used: root.tokens-used;
                            tokens-total: root.tokens-total;
                            is-recording <=> root.is-recording;
                            
                            // Forward all callbacks
                            message-submitted(text) => {
                                root.message-submitted(text);
                            }
                            
                            attach-clicked => {
                                root.attach-clicked();
                            }
                            
                            auto-approve-toggled(enabled) => {
                                root.auto-approve-toggled(enabled);
                            }
                            
                            context-clicked => {
                                root.context-clicked();
                            }
                            
                            model-clicked => {
                                root.model-clicked();
                            }
                            
                            reasoning-clicked => {
                                root.reasoning-clicked();
                            }
                            
                            voice-clicked => {
                                root.voice-clicked();
                            }
                            
                            voice-recording-started => {
                                root.voice-recording-started();
                            }
                            
                            voice-recording-stopped => {
                                root.voice-recording-stopped();
                            }
                        }
                        
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }
                    }
                    
                    // Center the warning text below the input panel
                    warning-container := Rectangle {
                        height: 22px;
                        background: transparent;
                        
                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                            
                            warning-text := WarningText {
                                min-width: 400px;
                                max-width: root.input-panel-max-width;
                                horizontal-stretch: 1;
                            }
                            
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                        }
                    }
                }
            }
        }
    }
    
    // ===== SCROLLBAR =====
    // Positioned on the right edge for scrolling through messages
    // This will be implemented when the messages area is added
    // For now, it's a placeholder
    
    // TODO: Add scrollbar component on the right edge
    // This should be synchronized with the messages-area Flickable
}
