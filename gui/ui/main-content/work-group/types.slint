// Data model for one entry inside a collapsed assistant work activity group.

export struct WorkGroupItem {
    kind: string, // "thinking" or "tool"
    thinking_text: string,
    tool_name: string,
    tool_title: string,
    tool_args: string,
    tool_result: string,
    tool_status: string, // "running", "completed", "failed"
    tool_call_id: string,
    item_expanded: bool,
}
