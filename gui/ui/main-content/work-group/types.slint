// Data model for one entry inside a collapsed assistant work activity group.

import { DiffLine } from "../tools/diff.slint";

export struct WorkGroupItem {
    kind: string, // "thinking" or "tool"
    thinking_text: string,
    tool_name: string,
    tool_title: string,
    tool_args: string,
    tool_result: string,
    tool_status: string, // "running", "completed", "failed"
    tool_is_diff: bool,
    tool_diff_lines: [DiffLine],
    tool_added_count: int,
    tool_deleted_count: int,
    tool_call_id: string,
    item_expanded: bool,
}
