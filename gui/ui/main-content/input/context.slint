// Context window indicator component for the input panel.
//
// This component displays the current context window usage as formatted text
// directly in place, next to the context icon.

import { Tokens } from "../../shared/tokens.slint";

export component ContextIndicator inherits Rectangle {
    // Current context usage as a percentage (0.0 to 1.0)
    in property <float> usage: 0.0;
    
    // Total tokens used and available display text
    in property <string> display-text: "";
    
    // Callback fired when the user clicks the context indicator
    callback clicked();
    
    // Dynamic width based on text content
    min-width: 60px;
    preferred-width: label.preferred-width + 28px;
    height: 32px;
    
    // Background color changes on hover for visual feedback
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : Tokens.dropdown-surface;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners matching the design system
    border-radius: 6px;
    
    // Subtle border for definition
    border-width: 1px;
    border-color: #2a2a2a;
    
    // Horizontal layout for icon + text label
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        
        // Context icon
        icon := Image {
            source: @image-url("../../../assets/icons/main-content/input/context.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: root.usage < 0.6 
                ? (touch-area.has-hover ? Tokens.text-primary : Tokens.text-secondary)
                : (root.usage < 0.85 
                    ? #ffa500  // Orange for medium usage
                    : Tokens.danger-red);  // Red for high usage
            image-fit: contain;
            
            animate colorize { duration: 150ms; easing: ease-in-out; }
        }
        
        // Formatted context text directly in place
        label := Text {
            text: root.display-text;
            color: Tokens.text-primary;
            font-size: Tokens.body-font-size - 1px;
            font-family: Tokens.font-family;
            vertical-alignment: center;
        }
    }
    
    // Touch area for click detection covering the entire button
    touch-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
