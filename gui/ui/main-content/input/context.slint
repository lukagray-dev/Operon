// Context window indicator component for the input panel.
//
// This component displays a circular icon that shows the current context window
// usage. It provides visual feedback about how much of the available context
// window is being used by the current conversation.
//
// The component could be enhanced to show:
// - A progress ring around the icon indicating usage percentage
// - Color changes based on usage level (green -> yellow -> red)
// - Tooltip with detailed token count information
//
// For now, it serves as a clickable indicator that can show context details.

import { Tokens } from "../../shared/tokens.slint";

// Context window indicator positioned before the model selection.
// Shows the current context usage and allows viewing detailed information.
export component ContextIndicator inherits Rectangle {
    // Current context usage as a percentage (0.0 to 1.0)
    in property <float> usage: 0.35;
    
    // Total tokens used and available
    in property <int> tokens-used: 35000;
    in property <int> tokens-total: 100000;
    
    // Callback fired when the user clicks the context indicator
    // Could open a detailed view of context usage
    callback clicked();
    
    // Fixed square dimensions for the button
    width: 32px;
    height: 32px;
    
    // Background color changes on hover for visual feedback
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : transparent;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners matching the design system
    border-radius: 6px;
    
    // Center the icon within the button
    HorizontalLayout {
        alignment: center;
        
        VerticalLayout {
            alignment: center;
            
            // Context icon (circular indicator)
            // Using colorize to apply theme colors to the SVG
            icon := Image {
                source: @image-url("../../../assets/icons/main-content/input/context.svg");
                width: 18px;
                height: 18px;
                // Color changes based on usage level
                // Green when low, yellow when medium, red when high
                colorize: root.usage < 0.6 
                    ? (touch-area.has-hover ? Tokens.text-primary : Tokens.text-secondary)
                    : (root.usage < 0.85 
                        ? #ffa500  // Orange for medium usage
                        : Tokens.danger-red);  // Red for high usage
                image-fit: contain;
                
                // Smooth color transition on hover and usage changes
                animate colorize { duration: 150ms; easing: ease-in-out; }
            }
        }
    }
    
    // Optional: Progress ring overlay to visualize usage percentage
    // This creates a circular progress indicator around the icon
    if (root.usage > 0) : Path {
        // Position the ring around the icon
        x: (parent.width - 20px) / 2;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        
        // Draw a circular arc representing the usage
        // The arc starts at the top and goes clockwise
        viewbox-width: 20;
        viewbox-height: 20;
        
        // Stroke color matches the icon color logic
        stroke: root.usage < 0.6 
            ? Tokens.text-muted
            : (root.usage < 0.85 ? #ffa500 : Tokens.danger-red);
        stroke-width: 1.5px;
        fill: transparent;
        
        // The arc path - this is a simplified version
        // A full implementation would calculate the arc based on usage percentage
        // For now, this serves as a placeholder for the visual concept
        
        // Smooth color transition
        animate stroke { duration: 150ms; easing: ease-in-out; }
    }
    
    // Touch area for click detection covering the entire button
    touch-area := TouchArea {
        // Change cursor to pointer to indicate clickability
        mouse-cursor: pointer;
        
        clicked => {
            root.clicked();
        }
    }
}
