// File attachment button component for the input panel.
//
// This component provides a button that allows users to attach files to their
// messages. It displays a paperclip/plus icon and responds to clicks with
// visual feedback through hover states.
//
// When clicked, this would typically open a file picker dialog to let users
// select files to attach to their prompt (images, documents, code files, etc.).

import { Tokens } from "../../shared/tokens.slint";

// File attachment button positioned at the bottom-left of the input panel.
// Allows users to add context files, images, or documents to their prompts.
export component AttachButton inherits Rectangle {
    // Callback fired when the user clicks the attach button
    // The parent component should handle opening a file picker
    callback clicked();
    
    // Fixed square dimensions for the button
    width: 32px;
    height: 32px;
    
    // Background color changes on hover for visual feedback
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : transparent;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners matching the design system
    border-radius: 6px;
    
    // Center the icon within the button
    HorizontalLayout {
        alignment: center;
        
        VerticalLayout {
            alignment: center;
            
            // Attachment icon (plus/paperclip symbol)
            // Using colorize to apply theme colors to the SVG
            icon := Image {
                source: @image-url("../../../assets/icons/main-content/input/attach.svg");
                width: 18px;
                height: 18px;
                colorize: touch-area.has-hover 
                    ? Tokens.text-primary 
                    : Tokens.text-secondary;
                image-fit: contain;
                
                // Smooth color transition on hover
                animate colorize { duration: 150ms; easing: ease-in-out; }
            }
        }
    }
    
    // Touch area for click detection covering the entire button
    touch-area := TouchArea {
        // Change cursor to pointer to indicate clickability
        mouse-cursor: pointer;
        
        clicked => {
            root.clicked();
        }
    }
}
