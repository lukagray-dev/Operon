// Model selection dropdown component for the input panel.
//
// This component provides a dropdown button that allows users to select which
// AI model to use for their conversation. It displays the currently selected
// model name and opens a dropdown menu when clicked.
//
// The component shows:
// - Current model name (e.g., "Claude Sonnet 4.5", "GPT-4", etc.)
// - A dropdown arrow icon to indicate it's clickable
// - Hover states for visual feedback
//
// When clicked, it should open a dropdown menu with available models.

import { Tokens } from "../../shared/tokens.slint";

// Model selection dropdown positioned before the reasoning strength selector.
// Allows users to choose which AI model to use for the conversation.
export component ModelSelector inherits Rectangle {
    // Currently selected model name
    in-out property <string> selected-model: "Claude Sonnet 4.5";
    
    // List of available models (for future dropdown implementation)
    in property <[string]> available-models: [
        "Claude Sonnet 4.5",
        "Claude Sonnet 4",
        "Claude Opus 4",
        "GPT-4 Turbo",
        "GPT-4"
    ];
    
    // Callback fired when the user clicks to open the model selection dropdown
    callback clicked();
    
    // Callback fired when a model is selected (for future implementation)
    callback model-selected(string /* model-name */);
    
    // Dynamic width based on text content, with minimum width
    min-width: 120px;
    height: 32px;
    
    // Calculate preferred width based on text length
    preferred-width: model-text.preferred-width + 40px;
    
    // Background color changes on hover for visual feedback
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : Tokens.dropdown-surface;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners matching the design system
    border-radius: 6px;
    
    // Subtle border for definition
    border-width: 1px;
    border-color: #2a2a2a;
    
    // Horizontal layout for model name + icon
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: space-between;
        
        // Model icon (optional - could show model provider logo)
        Image {
            source: @image-url("../../../assets/icons/main-content/input/model.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Tokens.text-secondary;
            image-fit: contain;
            
            // Smooth color transition on hover
            animate colorize { duration: 150ms; easing: ease-in-out; }
        }
        
        // Currently selected model name
        model-text := Text {
            text: root.selected-model;
            color: Tokens.text-primary;
            font-size: Tokens.body-font-size;
            font-family: Tokens.font-family;
            vertical-alignment: center;
            
            // Truncate long model names with ellipsis
            overflow: elide;
            
            // Smooth color transition on hover
            animate color { duration: 150ms; easing: ease-in-out; }
        }
        
        // Dropdown arrow icon to indicate expandability
        // This is a small chevron-down icon
        Image {
            source: @image-url("../../../assets/icons/main-content/input/chevron-down.svg");
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            colorize: Tokens.text-secondary;
            image-fit: contain;
            
            // Smooth color transition on hover
            animate colorize { duration: 150ms; easing: ease-in-out; }
        }
    }
    
    // Touch area for click detection covering the entire button
    touch-area := TouchArea {
        // Change cursor to pointer to indicate clickability
        mouse-cursor: pointer;
        
        clicked => {
            root.clicked();
        }
    }
}
