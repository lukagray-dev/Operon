// Reasoning strength selector component for the input panel.
//
// This component provides a dropdown button that allows users to select the
// reasoning strength/mode for the AI model. Different reasoning levels affect
// how the model processes and responds to prompts.
//
// Typical reasoning levels might include:
// - Low: Fast, direct responses
// - Medium: Balanced reasoning and speed
// - High: Deep analysis and careful reasoning
// - Extended: Maximum reasoning for complex problems
//
// The component displays the current level and opens a dropdown when clicked.

import { Tokens } from "../../shared/tokens.slint";

// Reasoning strength selector positioned before the voice input button.
// Allows users to control how deeply the AI reasons about their prompts.
export component ReasoningSelector inherits Rectangle {
    // Currently selected reasoning level
    in-out property <string> selected-level: "Medium";
    
    // List of available reasoning levels (for future dropdown implementation)
    in property <[string]> available-levels: [
        "Low",
        "Medium",
        "High",
        "Extended"
    ];
    
    // Callback fired when the user clicks to open the reasoning dropdown
    callback clicked();
    
    // Callback fired when a reasoning level is selected (for future implementation)
    callback level-selected(string /* level-name */);
    
    // Dynamic width based on text content, with minimum width
    min-width: 100px;
    height: 32px;
    
    // Calculate preferred width based on text length plus extra space for icon and chevron
    preferred-width: level-text.preferred-width + 60px;
    
    // Background color changes on hover for visual feedback
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : Tokens.dropdown-surface;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners matching the design system
    border-radius: 6px;
    
    // Subtle border for definition
    border-width: 1px;
    border-color: #2a2a2a;
    
    // Horizontal layout for icon + level name + dropdown arrow
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        alignment: space-between;
        
        // Reasoning icon (brain or thinking symbol)
        Image {
            source: @image-url("../../../assets/icons/main-content/input/reasoning.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Tokens.text-secondary;
            image-fit: contain;
            
            // Smooth color transition on hover
            animate colorize { duration: 150ms; easing: ease-in-out; }
        }
        
        // Currently selected reasoning level
        level-text := Text {
            text: root.selected-level;
            color: Tokens.text-primary;
            font-size: Tokens.body-font-size;
            font-family: Tokens.font-family;
            vertical-alignment: center;
            
            // Smooth color transition on hover
            animate color { duration: 150ms; easing: ease-in-out; }
        }
        
        // Dropdown arrow icon to indicate expandability
        // This is a small chevron-down icon
        Image {
            source: @image-url("../../../assets/icons/main-content/input/chevron-down.svg");
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            colorize: Tokens.text-secondary;
            image-fit: contain;
            
            // Smooth color transition on hover
            animate colorize { duration: 150ms; easing: ease-in-out; }
        }
    }
    
    // Touch area for click detection covering the entire button
    touch-area := TouchArea {
        // Change cursor to pointer to indicate clickability
        mouse-cursor: pointer;
        
        clicked => {
            root.clicked();
        }
    }
}
