// Voice input button component for the input panel.
//
// This component provides a microphone button that allows users to input their
// prompts using voice instead of typing. When clicked, it would activate voice
// recording functionality.
//
// The button can have multiple states:
// - Idle: Ready to start recording
// - Recording: Currently capturing audio (could show animated state)
// - Processing: Converting speech to text
//
// For now, it's a simple clickable button with hover states.

import { Tokens } from "../../shared/tokens.slint";

// Voice input button positioned before the send button.
// Allows users to dictate their prompts instead of typing.
export component VoiceButton inherits Rectangle {
    // Whether voice recording is currently active
    in-out property <bool> is-recording: false;
    
    // Callback fired when the user clicks to start/stop voice input
    callback clicked();
    
    // Callback fired when recording starts
    callback recording-started();
    
    // Callback fired when recording stops
    callback recording-stopped();
    
    // Fixed square dimensions for the button
    width: 32px;
    height: 32px;
    
    // Background color changes based on recording state and hover
    // When recording, use a red tint to indicate active state
    background: root.is-recording 
        ? (touch-area.has-hover ? #ff474750 : #ff000030)
        : (touch-area.has-hover ? Tokens.dropdown-surface-hover : transparent);
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners matching the design system
    border-radius: 6px;
    
    // Optional border when recording to emphasize the active state
    border-width: root.is-recording ? 1px : 0px;
    border-color: root.is-recording ? Tokens.danger-red : transparent;
    
    // Smooth border transitions
    animate border-width { duration: 150ms; easing: ease-in-out; }
    animate border-color { duration: 150ms; easing: ease-in-out; }
    
    // Center the icon within the button
    HorizontalLayout {
        alignment: center;
        
        VerticalLayout {
            alignment: center;
            
            // Microphone icon
            // Using colorize to apply theme colors to the SVG
            icon := Image {
                source: @image-url("../../../assets/icons/main-content/input/voice.svg");
                width: 18px;
                height: 18px;
                // When recording, use danger red; otherwise use secondary color
                colorize: root.is-recording 
                    ? Tokens.danger-red 
                    : (touch-area.has-hover ? Tokens.text-primary : Tokens.text-secondary);
                image-fit: contain;
                
                // Smooth color transition on state change and hover
                animate colorize { duration: 150ms; easing: ease-in-out; }
                
                // Optional: Add a pulsing animation when recording
                // This would require animation support in Slint
            }
        }
    }
    
    // Touch area for click detection covering the entire button
    touch-area := TouchArea {
        // Change cursor to pointer to indicate clickability
        mouse-cursor: pointer;
        
        clicked => {
            // Toggle recording state
            root.is-recording = !root.is-recording;
            
            // Notify parent of state change
            if (root.is-recording) {
                root.recording-started();
            } else {
                root.recording-stopped();
            }
            
            // Also fire the generic clicked callback
            root.clicked();
        }
    }
}
