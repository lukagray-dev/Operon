// Main input panel component that assembles all input-related components.
//
// This component creates the complete prompt input interface at the bottom of
// the main content area. It includes:
// - A multiline text input field for typing prompts
// - Bottom toolbar with action buttons and controls
// - Proper spacing and layout following the design system
//
// Layout structure:
// ┌─────────────────────────────────────────────────────────────┐
// │ [Text input area - multiline, 4 lines visible]              │
// ├─────────────────────────────────────────────────────────────┤
// │ [attach] [auto-approve]  ...  [context] [model] [reasoning] [voice] [send] │
// └─────────────────────────────────────────────────────────────┘
//
// The panel floats above the main content area with proper elevation/shadow.

import { Tokens } from "../../shared/tokens.slint";
import { TextInputField } from "./text.slint";
import { AttachButton } from "./attach.slint";
import { AutoApproveButton } from "./auto-approve.slint";
import { ContextIndicator } from "./context.slint";
import { ModelSelector } from "./models.slint";
import { ReasoningSelector } from "./reasoning.slint";
import { VoiceButton } from "./voice.slint";
import { SendButton } from "./send.slint";
import { WarningText } from "./warning.slint";
import { ScrollView } from "std-widgets.slint";

// Main input panel component that combines all input controls.
// This is the primary user interaction point for sending messages to the AI.
export component InputPanel inherits Rectangle {
    // ===== Text Input Properties =====
    // Current text content in the input field
    in-out property <string> input-text: "";

    // Placeholder text shown when input is empty
    in property <string> placeholder: "Do anything with Operon...";

    // Currently selected AI model
    in-out property <string> selected-model: "";

    // Currently selected reasoning strength
    in-out property <string> selected-reasoning: "";

    // Auto-approve state
    in-out property <bool> auto-approve-enabled: false;

    // Context window usage (0.0 to 1.0)
    in property <float> context-usage: 0.0;
    in property <int> tokens-used: 0;
    in property <int> tokens-total: 0;

    // Voice recording state
    in-out property <bool> is-recording: false;

    // Inline context statistics text and models dropdown properties
    in property <string> context-text: "";
    in property <[string]> available-models: [];
    in-out property <bool> show-model-dropdown: false;
    in-out property <bool> is-responding: false;

    // Fired when user selects a model from the dropdown
    callback model-selected(string /* selected-model */);

    // Fired when the user submits a message (Enter key or Send button)
    callback message-submitted(string /* message-text */);
    callback cancel-clicked();

    // Fired when text content changes
    callback text-changed(string /* new-text */);

    // Fired when attach button is clicked
    callback attach-clicked();

    // Fired when auto-approve is toggled
    callback auto-approve-toggled(bool /* enabled */);

    // Fired when context indicator is clicked
    callback context-clicked();

    // Fired when model selector is clicked
    callback model-clicked();

    // Fired when reasoning selector is clicked
    callback reasoning-clicked();

    // Fired when voice button is clicked
    callback voice-clicked();

    // Fired when voice recording starts
    callback voice-recording-started();

    // Fired when voice recording stops
    callback voice-recording-stopped();

    // ===== Layout Properties =====
    // Width is controlled by parent - no min-width to allow flexibility
    
    // Dynamic height based on text content
    // Minimum: 1 line, Maximum: 10 lines
    // Formula: text-field height + toolbar (32px) + padding (32px total: 8px top + 8px bottom + 8px spacing + 8px internal)
    property <length> min-panel-height: 48px;  // 1 line: 20px + 32px toolbar + padding
    property <length> max-panel-height: 248px; // 10 lines: 200px + 32px toolbar + padding
    property <length> dynamic-panel-height: text-field.height + 32px + 32px;

    height: max(min-panel-height, min(dynamic-panel-height, max-panel-height));

    // Panel background - slightly lighter than the main background
    background: Tokens.titlebar-background;

    // Rounded corners for modern appearance
    border-radius: 12px;

    // White border only appears when focused
    border-width: text-field.has-focus ? 1px : 0px;
    border-color: #ffffff;

    // Smooth border transition
    animate border-width {
        duration: 200ms;
        easing: ease-in-out;
    }

    // Outer glow effect only when text input has focus
    // This creates a subtle white glow around the panel
    drop-shadow-blur: text-field.has-focus ? 16px : 20px;
    drop-shadow-color: text-field.has-focus
        ? #ffffff40  // White glow with 25% opacity when focused
        : Tokens.shadow-color;  // Normal shadow when not focused
    drop-shadow-offset-y: 4px;

    // Smooth shadow transition on focus
    animate drop-shadow-blur {
        duration: 200ms;
        easing: ease-in-out;
    }
    animate drop-shadow-color {
        duration: 200ms;
        easing: ease-in-out;
    }

    // ===== Main Layout =====
    // Vertical layout dividing the panel into text area and toolbar
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;  // Reduced padding for more compact appearance
        spacing: 8px;

        // ===== TEXT INPUT AREA =====
        // Multiline text input field - takes most of the space
        text-field := TextInputField {
            text <=> root.input-text;
            placeholder: root.placeholder;
            vertical-stretch: 1;
            horizontal-stretch: 1;

            // Handle text changes
            text-changed(new-text) => {
                root.text-changed(new-text);
            }
            
            // Handle submit (Enter key pressed)
            submit => {
                // Only submit if there's actual text content
                if (root.input-text != "") {
                    root.message-submitted(root.input-text);
                    // Clear the input after submission
                    root.input-text = "";
                }
            }
        }

        // ===== BOTTOM TOOLBAR =====
        // Contains all action buttons and controls
        toolbar := Rectangle {
            height: 32px;
            vertical-stretch: 0;
            horizontal-stretch: 1;
            background: transparent;

            // Horizontal layout for toolbar items
            HorizontalLayout {
                spacing: 6px;
                width: parent.width;

                // ===== LEFT SECTION: File & Settings =====
                left-section := HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 0;

                    // File attachment button
                    AttachButton {
                        clicked => {
                            root.attach-clicked();
                        }
                    }

                    // Auto-approve toggle button
                    AutoApproveButton {
                        enabled <=> root.auto-approve-enabled;

                        toggled(new-state) => {
                            root.auto-approve-toggled(new-state);
                        }
                    }
                }

                // ===== MIDDLE SECTION: Spacer =====
                // This pushes the right section to the right edge
                Rectangle {
                    horizontal-stretch: 1;
                }

                // ===== RIGHT SECTION: Model Controls & Actions =====
                right-section := HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 0;
                    alignment: end;

                    // Context window indicator
                    ContextIndicator {
                        usage: root.context-usage;
                        display-text: root.context-text;

                        clicked => {
                            root.context-clicked();
                        }
                    }

                    // Model selection dropdown
                    ModelSelector {
                        selected-model <=> root.selected-model;

                        clicked => {
                            root.show-model-dropdown = !root.show-model-dropdown;
                            root.model-clicked();
                        }
                    }

                    // Reasoning strength selector
                    ReasoningSelector {
                        selected-level <=> root.selected-reasoning;

                        clicked => {
                            root.reasoning-clicked();
                        }
                    }

                    // Voice input button
                    VoiceButton {
                        is-recording <=> root.is-recording;

                        clicked => {
                            root.voice-clicked();
                        }

                        recording-started => {
                            root.voice-recording-started();
                        }

                        recording-stopped => {
                            root.voice-recording-stopped();
                        }
                    }

                    // Send button - stop when responding, submit when text present
                    SendButton {
                        enabled: root.input-text != "" || root.is-responding;
                        is-responding: root.is-responding;

                        clicked => {
                            if (root.is-responding) {
                                root.cancel-clicked();
                            } else if (root.input-text != "") {
                                root.message-submitted(root.input-text);
                                root.input-text = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // Floating dropdown popup overlays model selection button
    if (root.show-model-dropdown): Rectangle {
        x: parent.width - self.width - 76px;
        y: parent.height - 40px - self.height;
        width: 220px;
        height: min(150px, dropdown-layout.preferred-height + 10px);
        background: Tokens.dropdown-surface;
        border-width: 1px;
        border-color: Tokens.dropdown-border;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;
        clip: true;

        ScrollView {
            width: 100%;
            height: 100%;

            dropdown-layout := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for model-name in root.available-models: Rectangle {
                    height: 30px;
                    background: dropdown-item-touch.has-hover
                        ? Tokens.dropdown-surface-hover
                        : (model-name == root.selected-model ? rgba(255, 255, 255, 0.04) : transparent);
                    border-radius: 4px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        Text {
                            text: model-name;
                            color: model-name == root.selected-model ? Tokens.text-primary : Tokens.text-secondary;
                            font-size: Tokens.body-font-size;
                            font-family: Tokens.font-family;
                            vertical-alignment: center;
                        }
                    }

                    dropdown-item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-model = model-name;
                            root.show-model-dropdown = false;
                            root.model-selected(model-name);
                        }
                    }
                }
            }
        }
    }
}
