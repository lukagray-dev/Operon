// Text input component for the main prompt area.
//
// This component provides a multiline text input field where users can type their
// prompts and messages to the AI agent. It supports:
// - Multiline text editing (up to 4 lines visible by default)
// - Scrolling when content exceeds visible area
// - Placeholder text when empty
// - Focus states for visual feedback
// - Text wrapping for long lines
//
// The component uses Slint's TextInput element wrapped in a Flickable
// to enable scrolling, which prevents text from overflowing into the buttons.

import { Tokens } from "../../shared/tokens.slint";

// Multiline text input field for user prompts.
// This is the primary text entry component in the chat interface.
export component TextInputField inherits Rectangle {
    // The current text content entered by the user
    in-out property <string> text: "";
    
    // Placeholder text shown when the input is empty
    in property <string> placeholder: "Message Operon...";
    
    // Whether the input currently has keyboard focus
    out property <bool> has-focus: text-input.has-focus;
    
    // Callback fired when the user presses Enter (without Shift)
    // This typically triggers sending the message
    callback submit();
    
    // Callback fired when text content changes
    callback text-changed(string);
    
    // Dynamic height calculation:
    // - Minimum: 1 line (~20px) - shows single line when empty or minimal text
    // - Maximum: 10 lines (~200px) - after this, scrolling kicks in
    // - Uses text-input.preferred-height to automatically adjust based on actual content
    // - This approach works because Slint's TextInput calculates preferred-height
    //   based on the actual text content and wrapping
    property <length> min-text-height: 20px;   // Height for 1 line
    property <length> max-text-height: 200px;  // Height for 10 lines (20px * 10)
    
    // Bind height to text-input's preferred height with constraints
    // This automatically grows from 1 line to 10 lines as user types
    height: max(min-text-height, min(text-input.preferred-height, max-text-height));
    

    
    // Transparent background - the parent panel provides the background
    background: transparent;
    
    // No border - the parent panel has the border
    border-width: 0px;
    
    // Clip content to prevent overflow
    clip: true;
    
    // Flickable wrapper to enable scrolling when text exceeds visible area
    flickable := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-height: text-input.preferred-height;
        
        // Auto-scroll to keep cursor visible
        // When text changes, scroll to show the cursor position
        interactive: true;
        
        // The actual text input element
        // Using TextInput instead of TextEdit for more control
        text-input := TextInput {
            width: parent.width;
            
            // Enable multiline editing - this is crucial for chat input
            single-line: false;
            
            // Enable word wrapping so long lines don't overflow
            wrap: word-wrap;
            
            // Text content bound to parent property
            text <=> root.text;
            
            // Styling to match the design system
            color: Tokens.text-primary;
            font-size: Tokens.body-font-size;
            font-family: Tokens.font-family;
            
            // Vertical alignment at the top for multiline content
            vertical-alignment: top;
            
            // Selection colors for better visibility
            selection-background-color: Tokens.accent-blue;
            selection-foreground-color: Tokens.text-primary;
            
            // Handle text changes
            edited => {
                root.text-changed(self.text);
                
                // Auto-scroll to cursor position when text changes
                // Calculate the approximate cursor Y position based on line count
                // This ensures the cursor stays visible as the user types
                if (self.preferred-height > flickable.height) {
                    // Scroll to bottom to show the latest text
                    flickable.viewport-y = flickable.height - self.preferred-height;
                }
            }
            
            // Handle keyboard events for submit functionality
            // Enter without Shift = submit, Shift+Enter = new line
            key-pressed(event) => {
                if (event.text == "\n" && !event.modifiers.shift) {
                    // Enter pressed without Shift - submit the message
                    root.submit();
                    return accept;
                }
                // Let TextInput handle all other keys normally
                return reject;
            }
        }
    }
    
    // Placeholder text overlay - only visible when input is empty and not focused
    if (root.text == "" && !text-input.has-focus) : Text {
        x: 0px;
        y: 0px;
        text: root.placeholder;
        color: Tokens.text-muted;
        font-size: Tokens.body-font-size;
        font-family: Tokens.font-family;
        
        // Prevent the placeholder from blocking input clicks
        // This is a visual-only element
    }
}
