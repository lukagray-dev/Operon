// Shared compact body for tool input and output details.

import { Tokens } from "../../shared/tokens.slint";

export component ToolDetailBody inherits Rectangle {
    in property <string> tool-args: "";
    in property <string> tool-result: "";
    in property <string> tool-status: "running";

    background: rgba(255, 255, 255, 0.02);
    border-radius: 6px;
    clip: true;
    width: 100%;
    horizontal-stretch: 1;
    height: Math.min(270px, Math.max(28px, detail-content.preferred-height));

    detail-flickable := Flickable {
        width: 100%;
        horizontal-stretch: 1;
        height: parent.height;
        viewport-width: self.width;
        viewport-height: Math.max(parent.height, detail-content.preferred-height);
        interactive: true;

        detail-content := VerticalLayout {
            alignment: start;
            spacing: 8px;
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 8px;
            width: 100%;
            horizontal-stretch: 1;

            if (root.tool-args != "") : Text {
                text: "args: " + root.tool-args;
                color: #888888;
                font-size: 11px;
                font-family: Tokens.mono_font_family;
                wrap: word-wrap;
                width: 100%;
                horizontal-stretch: 1;
            }

            // Subtle horizontal divider between tool input arguments and output result
            if (root.tool-args != "" && root.tool-result != "") : Rectangle {
                height: 1px;
                width: 100%;
                background: rgba(255, 255, 255, 0.08);
            }

            if (root.tool-result != "") : Text {
                text: root.tool-result;
                color: root.tool-status == "failed" ? #ef9a9a : #c7c7c7;
                font-size: 11px;
                font-family: Tokens.mono_font_family;
                wrap: word-wrap;
                width: 100%;
                horizontal-stretch: 1;
            }

            if (root.tool-args == "" && root.tool-result == "") : Text {
                text: root.tool-status == "running" ? "Tool is executing..." : "No input or output data available.";
                color: #888888;
                font-size: 11px;
                font-family: Tokens.mono_font_family;
                wrap: word-wrap;
                width: 100%;
                horizontal-stretch: 1;
            }
        }
    }
}
