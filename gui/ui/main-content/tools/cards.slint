// Slint UI component for tool execution details.
//
// Renders tool runs, statuses (running/completed/failed), modification stats
// (+X, -Y), and expandable views containing code diffs or parameters/results.
//
// The expansion pattern mirrors the ThinkingCard: a Flickable viewport inside
// a height-limited Rectangle, capped at ~15 lines (270px) with scroll support.

import { Tokens } from "../../shared/tokens.slint";
import { DiffLine, DiffLineView } from "./diff.slint";

export component ToolCard inherits Rectangle {
    // Tool execution parameters
    in property <string> tool-name: "";
    in property <string> tool-title: "";
    in property <string> tool-args: "";
    in property <string> tool-result: "";
    in property <string> tool-status: "running"; // "running", "completed", "failed"
    in property <bool> tool-is-diff: false;
    in property <[DiffLine]> tool-diff-lines: [];
    in property <int> tool-added-count: 0;
    in property <int> tool-deleted-count: 0;

    // Toggle states
    in-out property <bool> collapsed: true;

    // Visual state
    property <bool> has-hover: touch.has-hover;

    // Spinner rotation angle for running state indicator
    in-out property <angle> spinner-angle: 0deg;

    background: has-hover ? rgba(255, 255, 255, 0.035) : rgba(255, 255, 255, 0.02);
    border-radius: 6px;
    border-width: 1px;
    border-color: has-hover ? rgba(255, 255, 255, 0.12) : rgba(255, 255, 255, 0.06);

    animate background { duration: 120ms; easing: ease-in-out; }
    animate border-color { duration: 120ms; easing: ease-in-out; }

    // Continuous spinner rotation for running state
    animate spinner-angle {
        duration: 800ms;
        easing: linear;
    }

    spinner-timer := Timer {
        interval: 800ms;
        running: root.tool-status == "running";
        triggered => {
            root.spinner-angle = root.spinner-angle + 360deg;
        }
    }

    // Auto-expand on failure, auto-collapse on completion
    changed tool-status => {
        if (root.tool-status == "failed") {
            root.collapsed = false;
        } else if (root.tool-status == "completed") {
            root.collapsed = true;
        }
    }

    VerticalLayout {
        spacing: 0px;
        alignment: start;

        // ===== HEADER BAR (CLICKABLE TOGGLE) =====
        touch := TouchArea {
            clicked => {
                root.collapsed = !root.collapsed;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                // Left-aligned, not centered — tool name sits at the start
                alignment: start;

                // Tool identity icon
                Image {
                    source: @image-url("../../../assets/icons/main-content/messages/assistant/tool.svg");
                    width: 14px;
                    height: 14px;
                    colorize: root.tool-status == "failed" ? #ef9a9a :
                              root.has-hover ? #cccccc : #999999;
                    opacity: 0.7;

                    animate colorize { duration: 120ms; }
                }

                // Friendly text title — takes remaining space
                Text {
                    text: root.tool-title != "" ? root.tool-title : ("Running " + root.tool-name);
                    color: root.has-hover ? #e6e6e6 : #cccccc;
                    font-size: 13px;
                    font-weight: 500;
                    font-family: Tokens.font_family;
                    vertical-alignment: center;
                    horizontal-stretch: 1;

                    animate color { duration: 120ms; }
                }

                // Diff Statistics Badge (+Lines, -Lines)
                if (root.tool-is-diff && (root.tool-added-count > 0 || root.tool-deleted-count > 0)) : HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    if (root.tool-added-count > 0) : Text {
                        text: "+" + root.tool-added-count;
                        color: #81c784;
                        font-size: 11px;
                        font-family: Tokens.mono-font-family;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if (root.tool-deleted-count > 0) : Text {
                        text: "-" + root.tool-deleted-count;
                        color: #e57373;
                        font-size: 11px;
                        font-family: Tokens.mono-font-family;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // Execution Status Indicator
                // Running → rotating spinner icon
                if (root.tool-status == "running") : Image {
                    source: @image-url("../../../assets/icons/main-content/messages/assistant/tool.svg");
                    width: 14px;
                    height: 14px;
                    colorize: #64b5f6;
                    transform-rotation: root.spinner-angle;

                    animate transform-rotation {
                        duration: 800ms;
                        easing: linear;
                    }
                }

                // Completed → green checkmark icon
                if (root.tool-status == "completed") : Image {
                    source: @image-url("../../../assets/icons/main-content/messages/assistant/check.svg");
                    width: 14px;
                    height: 14px;
                    colorize: #81c784;
                }

                // Failed → red badge
                if (root.tool-status == "failed") : Rectangle {
                    background: rgba(239, 154, 154, 0.08);
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: rgba(239, 154, 154, 0.2);

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: "Failed";
                            color: #ef9a9a;
                            font-size: 11px;
                            font-weight: 500;
                            font-family: Tokens.font_family;
                        }
                    }
                }

                // Collapsible Chevron
                Image {
                    source: @image-url("../../../assets/icons/sidebar/chevron-down.svg");
                    width: 12px;
                    height: 12px;
                    colorize: root.has-hover ? #999999 : #777777;
                    opacity: 0.5;
                    transform-rotation: root.collapsed ? -90deg : 0deg;

                    animate transform-rotation {
                        duration: 150ms;
                        easing: ease-in-out;
                    }
                    animate colorize { duration: 120ms; }
                }
            }
        }

        // ===== DETAIL CONTAINER (ACCORDION — Flickable like ThinkingCard) =====
        if (!root.collapsed) : VerticalLayout {
            // Separator line
            Rectangle {
                height: 1px;
                background: rgba(255, 255, 255, 0.04);
            }

            Rectangle {
                background: rgba(0, 0, 0, 0.1);

                // Cap height at ~15 lines (270px), scroll the rest
                height: Math.min(270px, detail-content.preferred-height);

                detail-flickable := Flickable {
                    width: 100%;
                    height: parent.height;
                    viewport-height: detail-content.preferred-height;
                    interactive: true;

                    // Scroll target for smooth auto-scroll
                    property <length> target-scroll-y: 0px;
                    viewport-y: self.target-scroll-y;

                    // Auto-scroll to bottom when content grows
                    changed viewport-height => {
                        self.target-scroll-y = Math.min(0px, parent.height - self.viewport-height);
                    }

                    animate viewport-y {
                        duration: 100ms;
                        easing: ease-out;
                    }

                    // Mouse wheel support
                    TouchArea {
                        width: 100%;
                        height: max(detail-flickable.height, detail-flickable.viewport-height);
                        scroll-event(e) => {
                            detail-flickable.target-scroll-y = Math.clamp(
                                detail-flickable.target-scroll-y + e.delta-y,
                                Math.min(0px, detail-flickable.height - detail-flickable.viewport-height),
                                0px
                            );
                            EventResult.accept
                        }
                    }

                    detail-content := VerticalLayout {
                        alignment: start;
                        spacing: 0px;

                        // ── Diff view for file-modifying tools ──
                        if (root.tool-is-diff) : VerticalLayout {
                            padding: 8px;

                            Rectangle {
                                background: rgba(0, 0, 0, 0.2);
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.03);

                                VerticalLayout {
                                    alignment: start;
                                    for line in root.tool-diff-lines : DiffLineView {
                                        kind: line.kind;
                                        text: line.text;
                                    }
                                }
                            }
                        }

                        // ── Parameters + Result for generic tools ──
                        if (!root.tool-is-diff) : VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            if (root.tool-args != "") : VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "INPUT PARAMETERS";
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: #555555;
                                    font-family: Tokens.font_family;
                                }
                                Rectangle {
                                    background: rgba(0, 0, 0, 0.25);
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.02);

                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        Text {
                                            text: root.tool-args;
                                            font-size: 11px;
                                            font-family: Tokens.mono-font-family;
                                            color: #bbbbbb;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if (root.tool-result != "") : VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "OUTPUT RESULT";
                                    font-size: 9.5px;
                                    font-weight: 600;
                                    color: #555555;
                                    font-family: Tokens.font_family;
                                }
                                Rectangle {
                                    background: rgba(0, 0, 0, 0.25);
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: rgba(255, 255, 255, 0.02);

                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        Text {
                                            text: root.tool-result;
                                            font-size: 11px;
                                            font-family: Tokens.mono-font-family;
                                            color: root.tool-status == "failed" ? #ef9a9a : #bbbbbb;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
