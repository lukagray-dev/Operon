// Chat loading skeleton component.
//
// Displays an animated shimmer skeleton that mimics the layout of a real
// conversation while session data is being parsed and loaded from disk.
// The skeleton shows alternating "user" (right-aligned bubble) and "assistant"
// (full-width lines) placeholder blocks so the user understands that messages
// are being prepared.
//
// The shimmer effect is driven by a repeating Timer that shifts the gradient
// highlight position across the skeleton bars.

import { Tokens } from "../../shared/tokens.slint";

// A single shimmer bar used as a building block for skeleton placeholders.
// The gradient highlight sweeps left-to-right continuously to indicate loading.
component ShimmerBar inherits Rectangle {
    // Current animation phase (0.0 to 1.0), driven externally by a timer
    in property <float> phase: 0.0;

    height: 14px;
    border-radius: 4px;

    // Base skeleton surface color
    background: rgba(255, 255, 255, 0.04);

    // Shimmer highlight overlay that sweeps across the bar
    Rectangle {
        // Position the highlight based on the current animation phase.
        // It travels from -30% to +130% of the bar width to fully enter and exit.
        x: (root.phase * 1.6 - 0.3) * parent.width;
        y: 0;
        width: parent.width * 0.30;
        height: parent.height;
        border-radius: parent.border-radius;
        background: rgba(255, 255, 255, 0.06);
        opacity: 0.8;
    }
}

// A skeleton block mimicking an assistant message (left-aligned, multi-line).
component AssistantSkeleton inherits Rectangle {
    in property <float> phase: 0.0;
    in property <length> max-content-width: 600px;

    background: transparent;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        // First line - longest (simulates a heading or opening sentence)
        ShimmerBar {
            width: root.max-content-width * 0.85;
            height: 16px;
            phase: root.phase;
        }

        // Body lines of varying widths to look natural
        ShimmerBar {
            width: root.max-content-width * 0.95;
            phase: root.phase;
        }
        ShimmerBar {
            width: root.max-content-width * 0.70;
            phase: root.phase;
        }
        ShimmerBar {
            width: root.max-content-width * 0.88;
            phase: root.phase;
        }
        ShimmerBar {
            width: root.max-content-width * 0.40;
            phase: root.phase;
        }
    }
}

// A skeleton block mimicking a user message (right-aligned bubble).
component UserSkeleton inherits Rectangle {
    in property <float> phase: 0.0;
    in property <length> max-content-width: 400px;

    background: transparent;

    HorizontalLayout {
        alignment: end;
        padding-right: 12px;

        // Simulated user bubble container
        Rectangle {
            width: root.max-content-width;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.03);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.06);

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                ShimmerBar {
                    width: root.max-content-width * 0.75;
                    phase: root.phase;
                }
                ShimmerBar {
                    width: root.max-content-width * 0.50;
                    phase: root.phase;
                }
            }
        }
    }
}

// Main exported loading skeleton component.
// Shows a full-page skeleton that mimics a typical conversation layout:
// User bubble -> Assistant block -> User bubble -> Assistant block
export component ChatLoadingSkeleton inherits Rectangle {
    // Controls whether the shimmer animation is running
    in property <bool> active: false;

    // Internal animation phase (0.0 -> 1.0 repeating)
    in-out property <float> shimmer-phase: 0.0;

    background: transparent;
    clip: true; // Prevent skeleton elements from drawing outside main content area
    
    // Animate the phase property smoothly for the shimmer sweep effect
    animate shimmer-phase {
        duration: 1200ms;
        easing: ease-in-out;
    }

    // Timer drives the shimmer animation in a continuous loop
    shimmer-timer := Timer {
        interval: 1200ms;
        running: root.active;
        triggered => {
            // Toggle between 0.0 and 1.0 to create a back-and-forth sweep
            if (root.shimmer-phase < 0.5) {
                root.shimmer-phase = 1.0;
            } else {
                root.shimmer-phase = 0.0;
            }
        }
    }

    // Reset phase when the skeleton becomes active so the animation starts cleanly
    changed active => {
        if (root.active) {
            root.shimmer-phase = 0.0;
        }
    }

    // Content layout centered horizontally with the same constraints as real messages
    HorizontalLayout {
        alignment: center;

        Rectangle {
            min-width: 200px;
            max-width: 900px;
            horizontal-stretch: 1;

            VerticalLayout {
                padding-top: 24px;
                spacing: 28px;
                alignment: start;

                // Turn 1: User message skeleton
                UserSkeleton {
                    phase: root.shimmer-phase;
                    max-content-width: 320px;
                }

                // Turn 1: Assistant response skeleton
                AssistantSkeleton {
                    phase: root.shimmer-phase;
                    max-content-width: 550px;
                }

                // Turn 2: User message skeleton (shorter)
                UserSkeleton {
                    phase: root.shimmer-phase;
                    max-content-width: 250px;
                }

                // Turn 2: Assistant response skeleton (wider)
                AssistantSkeleton {
                    phase: root.shimmer-phase;
                    max-content-width: 620px;
                }
            }
        }
    }
}
