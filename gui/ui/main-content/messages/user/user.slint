// User message component that combines all user message elements.
//
// This component assembles the complete user message display including:
// - The message bubble with text content
// - Action buttons (Edit and Copy) below the bubble
// - Proper spacing and alignment
//
// Layout structure:
// ┌─────────────────────────────────────────────────────────────┐
// │                                    ┌──────────────────────┐ │
// │                                    │ User's message here  │ │
// │                                    │ (up to 10 lines)     │ │
// │                                    │ [Show more]          │ │
// │                                    └──────────────────────┘ │
// │                                    [Edit]   [Copy]          │
// └─────────────────────────────────────────────────────────────┘
//
// The message bubble is positioned on the right side, taking up to 75% of
// the available width (matching the input panel's maximum width).

import { Tokens } from "../../../shared/tokens.slint";
import { MessageBubble } from "./message.slint";
import { EditButton } from "./edit.slint";
import { CopyButton } from "./copy.slint";

// Complete user message component with bubble and action buttons.
// This represents a single user message in the chat history.
export component UserMessage inherits Rectangle {
    // ===== Message Properties =====
    // The message text content
    in property <string> message-text: "";
    
    // Whether the message is currently expanded (showing all content)
    in-out property <bool> is-expanded: false;
    
    // ===== Layout Properties =====
    // Maximum width for the message bubble (75% of input panel width)
    // This should be set by the parent based on the input panel's width
    in property <length> max-bubble-width: 675px;  // 75% of 900px default
    
    // ===== Callbacks =====
    // Fired when the user clicks the Edit button
    callback edit-clicked();
    
    // Fired when the user clicks the Copy button
    callback copy-clicked();
    
    // Fired when the message expansion state changes
    callback expand-clicked();
    
    // ===== Layout =====
    // Transparent background - the bubble provides its own background
    background: transparent;
    
    // Dynamic height based on bubble and buttons
    height: bubble.height + action-buttons.height + 8px;  // 8px spacing between bubble and buttons
    
    // Horizontal layout to position content on the right side
    HorizontalLayout {
        // Add 12px padding on the right to match assistant message padding
        // This ensures the user bubble's right edge aligns with assistant message's right edge
        padding-right: 12px;
        
        // Left spacer - pushes content to the right
        // This creates the 25% empty space on the left
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }
        
        // Right section containing the message bubble and buttons
        right-section := Rectangle {
            // Width is 75% of the available space (controlled by max-bubble-width)
            width: root.max-bubble-width;
            horizontal-stretch: 0;
            background: transparent;
            
            // Vertical layout for bubble and buttons
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                
                // ===== MESSAGE BUBBLE =====
                bubble := MessageBubble {
                    message-text: root.message-text;
                    is-expanded <=> root.is-expanded;
                    
                    // Forward the expand callback
                    expand-clicked => {
                        root.expand-clicked();
                    }
                }
                
                // ===== ACTION BUTTONS =====
                // Edit and Copy buttons positioned below the bubble
                action-buttons := Rectangle {
                    height: 28px;
                    vertical-stretch: 0;
                    background: transparent;
                    
                    // Horizontal layout for buttons
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        
                        // Edit button
                        EditButton {
                            clicked => {
                                root.edit-clicked();
                            }
                        }
                        
                        // Copy button
                        CopyButton {
                            clicked => {
                                root.copy-clicked();
                            }
                        }
                    }
                }
            }
        }
    }
}
