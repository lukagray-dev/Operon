// Copy button component for assistant messages.
//
// This component provides a button that allows users to copy the assistant's
// message text to their clipboard. It's positioned in the action bar below
// the message content.
//
// When clicked, it displays a checkmark icon (check.svg) for 3 seconds as
// visual feedback, before reverting to the copy icon.

import { Tokens } from "../../../shared/tokens.slint";

// Copy button for copying assistant message text to clipboard.
export component CopyButton inherits Rectangle {
    // Callback fired when the user clicks the copy button
    callback clicked();
    
    // Tracks whether the text was recently copied (shows checkmark feedback)
    in-out property <bool> is-copied: false;
    
    // Fixed size for icon button
    width: 24px;
    height: 24px;
    
    // Background color changes on hover
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : transparent;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners for modern appearance
    border-radius: 4px;

    // Timer to reset the copy feedback icon after 3 seconds
    timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            root.is-copied = false;
            self.running = false;
        }
    }
    
    // Center the icon
    HorizontalLayout {
        alignment: center;
        
        VerticalLayout {
            alignment: center;
            
            // Copy or check icon based on state
            icon := Image {
                source: root.is-copied 
                    ? @image-url("../../../../assets/icons/main-content/messages/assistant/check.svg")
                    : @image-url("../../../../assets/icons/main-content/messages/assistant/copy.svg");
                width: 14px;
                height: 14px;
                colorize: touch-area.has-hover 
                    ? Tokens.text-primary 
                    : Tokens.text-secondary;
                image-fit: contain;
                
                // Smooth color transition on hover
                animate colorize { duration: 150ms; easing: ease-in-out; }
            }
        }
    }
    
    // Touch area for click detection
    touch-area := TouchArea {
        mouse-cursor: pointer;
        
        clicked => {
            root.is-copied = true;
            timer.running = true;
            root.clicked();
        }
    }
}
