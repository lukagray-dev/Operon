// Horizontal separator line component for assistant messages.
//
// This component displays a thin horizontal line that separates the
// assistant's message content from the action bar below. It provides
// clear visual distinction between content and controls.

import { Tokens } from "../../../shared/tokens.slint";

// Horizontal separator line between message and actions.
// Uses a subtle white line for clean separation.
export component Separator inherits Rectangle {
    // Full width, thin height for a line
    height: 1.5px;
    
    // White separator line
    background: #ffffff;
    
    // Absolute white
    opacity: 1.0;
}
