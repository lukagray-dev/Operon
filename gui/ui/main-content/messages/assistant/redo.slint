// Regenerate button component for assistant messages.
//
// This component provides a button that allows users to regenerate the
// assistant's response. Useful when the user wants a different answer
// or the response wasn't satisfactory.

import { Tokens } from "../../../shared/tokens.slint";

// Regenerate button for requesting a new assistant response.
// Positioned in the action bar below the message.
export component RegenerateButton inherits Rectangle {
    // Callback fired when the user clicks the regenerate button
    callback clicked();
    
    // Fixed size for icon button
    width: 24px;
    height: 24px;
    
    // Background color changes on hover
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : transparent;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners for modern appearance
    border-radius: 4px;
    
    // Center the icon
    HorizontalLayout {
        alignment: center;
        
        VerticalLayout {
            alignment: center;
            
            // Regenerate icon (circular arrow)
            icon := Image {
                source: @image-url("../../../../assets/icons/main-content/messages/assistant/redo.svg");
                width: 14px;
                height: 14px;
                colorize: touch-area.has-hover 
                    ? Tokens.text-primary 
                    : Tokens.text-secondary;
                image-fit: contain;
                
                // Smooth color transition on hover
                animate colorize { duration: 150ms; easing: ease-in-out; }
            }
        }
    }
    
    // Touch area for click detection
    touch-area := TouchArea {
        mouse-cursor: pointer;
        
        clicked => {
            root.clicked();
        }
    }
}
