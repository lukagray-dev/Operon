// Like button component for assistant messages.
//
// This component provides a thumbs-up button that allows users to provide
// positive feedback on the assistant's response. It supports both liked
// and unliked states with visual feedback.
//
// Clicking the button triggers a size pop animation and locks the icon
// color to fully white (#ffffff) to indicate it has been active/liked.

import { Tokens } from "../../../shared/tokens.slint";

// Like button for positive feedback on assistant messages.
export component LikeButton inherits Rectangle {
    // Whether the message is currently liked
    in-out property <bool> is-liked: false;
    
    // Callback fired when the user clicks the like button
    callback clicked();
    
    // Fixed size for icon button
    width: 24px;
    height: 24px;
    
    // Background color changes on hover
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : transparent;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners for modern appearance
    border-radius: 4px;
    
    // Center the icon
    HorizontalLayout {
        alignment: center;
        
        VerticalLayout {
            alignment: center;
            
            // Like icon (thumbs up) with click pop scale animation
            icon := Image {
                source: @image-url("../../../../assets/icons/main-content/messages/assistant/like.svg");
                // Pop the size up to 17px when liked, default to 14px
                width: root.is-liked ? 17px : 14px;
                height: self.width;
                
                // When liked, colorize to fully white; otherwise use secondary/hover color
                colorize: root.is-liked 
                    ? #ffffff
                    : (touch-area.has-hover 
                        ? Tokens.text-primary 
                        : Tokens.text-secondary);
                image-fit: contain;
                
                // Smooth animations for scale pop and color transition
                animate width, height { duration: 150ms; easing: ease-in-out; }
                animate colorize { duration: 150ms; easing: ease-in-out; }
            }
        }
    }
    
    // Touch area for click detection and state toggle
    touch-area := TouchArea {
        mouse-cursor: pointer;
        
        clicked => {
            root.is-liked = !root.is-liked;
            root.clicked();
        }
    }
}
