// Time display component for assistant messages.
//
// This component displays the timestamp of when the assistant message
// was generated. It shows relative time (e.g., "2m ago", "1h ago") or
// absolute time for older messages.

import { Tokens } from "../../../shared/tokens.slint";

// Time display for assistant message timestamp.
// Shows when the message was generated.
export component TimeDisplay inherits Rectangle {
    // The time text to display (e.g., "2m ago", "1h ago")
    in property <string> time-text: "Just now";
    
    // Dynamic width based on text content
    width: time-label.preferred-width + 8px;
    height: 24px;
    background: transparent;
    
    // Center the time text
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        alignment: center;
        
        time-label := Text {
            text: root.time-text;
            color: Tokens.text-muted;
            font-size: Tokens.body-font-size;
            font-family: Tokens.font-family;
            vertical-alignment: center;
        }
    }
}
