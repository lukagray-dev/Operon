// Assistant message component that combines all assistant message elements.
//
// This component assembles the complete assistant message display including:
// - The message text (using PT Serif font)
// - A horizontal separator line
// - Action bar with: Operon logo, Copy, Like/Dislike, Regenerate, Fork, Time
// - Dot separators between action items
//
// Layout structure:
// ┌─────────────────────────────────────────────────────────────┐
// │ Assistant's message text here using PT Serif font           │
// │ (spans full width from left edge to right edge of input     │
// │  panel boundaries)                                           │
// ├─────────────────────────────────────────────────────────────┤
// │ [Logo] • [Copy] • [Like] [Dislike] • [Regen] • [Fork] • [Time] │
// └─────────────────────────────────────────────────────────────┘
//
// The message spans the full width of the input panel (no bubble).

import { Tokens } from "../../../shared/tokens.slint";
import { MessageText } from "./message.slint";
import { Separator } from "./separator.slint";
import { OperonLogo } from "./operon.slint";
import { CopyButton } from "./copy.slint";
import { LikeButton } from "./like.slint";
import { DislikeButton } from "./dislike.slint";
import { RegenerateButton } from "./redo.slint";
import { ForkButton } from "./fork.slint";
import { TimeDisplay } from "./time.slint";

// Complete assistant message component with text and action bar.
// This represents a single assistant message in the chat history.
export component AssistantMessage inherits Rectangle {
    // ===== Message Properties =====
    // The message text content
    in property <string> message-text: "";
    
    // Time text to display (e.g., "2m ago")
    in property <string> time-text: "Just now";
    
    // Like/Dislike state
    in-out property <bool> is-liked: false;
    in-out property <bool> is-disliked: false;
    
    // ===== Callbacks =====
    // Fired when the user clicks the Copy button
    callback copy-clicked();
    
    // Fired when the user clicks the Like button
    callback like-clicked();
    
    // Fired when the user clicks the Dislike button
    callback dislike-clicked();
    
    // Fired when the user clicks the Regenerate button
    callback regenerate-clicked();
    
    // Fired when the user clicks the Fork button
    callback fork-clicked();
    
    // ===== Layout =====
    // Transparent background - no bubble for assistant messages
    background: transparent;
    
    // Dynamic height based on message text and action bar
    height: message-text-area.height + separator-line.height + action-bar.height + 16px;
    
    // Vertical layout for message text, separator, and action bar
    VerticalLayout {
        // Add equal padding on left and right to match input panel's internal padding
        // Input panel has 12px padding on each side, so we match that here
        // This ensures the assistant message aligns perfectly with the input panel content
        padding-left: 12px;
        padding-right: 12px;
        spacing: 4px;  // Reduced from 8px to further decrease gap between message and separator
        alignment: start;
        
        // ===== MESSAGE TEXT AREA =====
        message-text-area := MessageText {
            message-text: root.message-text;
        }
        
        // ===== SEPARATOR LINE =====
        separator-line := Separator {
            // Width is automatically filled by VerticalLayout
        }
        
        // ===== ACTION BAR =====
        // Contains all action buttons and info with dot separators
        action-bar := Rectangle {
            height: 24px;
            vertical-stretch: 0;
            background: transparent;
            
            // Horizontal layout for action items
            HorizontalLayout {
                spacing: 6px;  // Add spacing between all items
                alignment: start;
                
                // 1. Operon Logo
                OperonLogo { }
                
                // 2. Copy button
                CopyButton {
                    clicked => {
                        root.copy-clicked();
                    }
                }
                
                // 3. Like button
                LikeButton {
                    is-liked <=> root.is-liked;
                    
                    clicked => {
                        root.like-clicked();
                    }
                }
                
                // 4. Dislike button
                DislikeButton {
                    is-disliked <=> root.is-disliked;
                    
                    clicked => {
                        root.dislike-clicked();
                    }
                }
                
                // 5. Regenerate button
                RegenerateButton {
                    clicked => {
                        root.regenerate-clicked();
                    }
                }
                
                // 6. Fork button
                ForkButton {
                    clicked => {
                        root.fork-clicked();
                    }
                }
                
                // 7. Time display
                TimeDisplay {
                    time-text: root.time-text;
                }
            }
        }
    }
}
