// Assistant message component that combines all assistant message elements.

import { Tokens } from "../../../shared/tokens.slint";
import { MarkdownElement, MarkdownView } from "../../markdown/markdown.slint";
import { Separator } from "./separator.slint";
import { OperonLogo } from "./operon.slint";
import { CopyButton } from "./copy.slint";
import { LikeButton } from "./like.slint";
import { DislikeButton } from "./dislike.slint";
import { ForkButton } from "./fork.slint";
import { TimeDisplay } from "./time.slint";

// Complete assistant message component with text and action bar.
// This represents a single assistant message in the chat history.
export component AssistantMessage inherits Rectangle {
    // The message text content
    in property <string> message-text: "";
    
    // Parsed markdown elements
    in property <[MarkdownElement]> markdown-elements: [];
    
    // Whether to show the blinking typing indicator cursor
    in property <bool> show-cursor: false;

    // Whether the model is actively thinking/reasoning
    in property <bool> is-thinking: false;

    // Time text to display (e.g., "2m ago")
    in property <string> time-text: "Just now";

    // Like/Dislike state
    in-out property <bool> is-liked: false;
    in-out property <bool> is-disliked: false;

    // Whether to show the separator line at the bottom
    in property <bool> show-separator: true;

    // ===== Callbacks =====
    // Fired when the user clicks the Copy button
    callback copy-clicked();

    // Fired when the user clicks the Like button
    callback like-clicked();

    // Fired when the user clicks the Dislike button
    callback dislike-clicked();

    // Fired when the user clicks the Regenerate button
    callback regenerate-clicked();

    // Fired when the user clicks the Fork button
    callback fork-clicked();

    // Callback fired when a code block's copy button is clicked
    callback code-copied(int /* item-index */);

    // Callbacks forwarded when permission prompts are resolved
    callback permission-approved(string /* permission_id */);
    callback permission-denied(string /* permission_id */);

    // ===== Layout =====
    background: transparent;
    horizontal-stretch: 1;

    // Dynamic height based on message text and controls container height
    height: message-text-area.preferred-height + controls-container.height + 16px;

    // Outer TouchArea wrapping the entire component.
    hover-touch := TouchArea {
        width: 100%;
        height: 100%;

        // Vertical layout for message text and controls container
        VerticalLayout {
            // Add equal padding on left and right to match input panel's internal padding
            padding-left: 12px;
            padding-right: 12px;
            spacing: 4px;
            alignment: start;

            // ===== MESSAGE TEXT AREA (RENDERED AS MARKDOWN) =====
            message-text-area := MarkdownView {
                horizontal-stretch: 1;
                elements: root.markdown-elements;
                font-family: Tokens.serif_font_family;

                copy-code(item_idx) => {
                    root.code-copied(item_idx);
                }
            }

            if (root.show-cursor) : HorizontalLayout {
                padding-top: 2px;
                padding-bottom: 2px;
                alignment: start;

                Text {
                    text: "▋";
                    color: Tokens.accent_blue;
                    font-size: 15px;
                    font-family: Tokens.serif_font_family;
                }
            }

            // ===== CONTROLS CONTAINER =====
            controls-container := Rectangle {
                height: root.show-separator ? 29px : 0px; // Hide controls container completely when show-separator is false
                vertical-stretch: 0;
                horizontal-stretch: 1;
                
                // Fade effect linked to parent hover state (only active when show-separator is true)
                opacity: (root.show-separator && hover-touch.has-hover) ? 1.0 : 0.0;
                
                // Disable interaction and visibility when completely faded out or show-separator is false
                visible: root.show-separator && (self.opacity > 0.0);

                // Smooth opacity transition on hover enter/exit
                animate opacity { duration: 150ms; easing: ease-in-out; }

                VerticalLayout {
                    spacing: 4px;

                    // ===== SEPARATOR LINE =====
                    if (root.show-separator) : separator-line := Separator {
                    }

                    // ===== ACTION BAR =====
                    action-bar := Rectangle {
                        height: 24px;
                        vertical-stretch: 0;
                        background: transparent;

                        // Horizontal layout for action items
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            // 1. Operon Logo
                            OperonLogo { }

                            // 2. Copy button
                            CopyButton {
                                clicked => {
                                    root.copy-clicked();
                                }
                            }

                            // 3. Like button
                            LikeButton {
                                is-liked <=> root.is-liked;

                                clicked => {
                                    if (root.is-liked) {
                                        root.is-disliked = false;
                                    }
                                    root.like-clicked();
                                }
                            }

                            // 4. Dislike button
                            DislikeButton {
                                is-disliked <=> root.is-disliked;

                                clicked => {
                                    if (root.is-disliked) {
                                        root.is-liked = false;
                                    }
                                    root.dislike-clicked();
                                }
                            }

                            // 5. Fork button
                            ForkButton {
                                clicked => {
                                    root.fork-clicked();
                                }
                            }

                            // 6. Time display
                            TimeDisplay {
                                time-text: root.time-text;
                            }
                        }
                    }
                }
            }
        }
    }
}
