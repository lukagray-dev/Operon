// Assistant message component that combines all assistant message elements.
//
// This component assembles the complete assistant message display including:
// - The message text (using PT Serif font)
// - A horizontal separator line
// - Action bar with: Operon logo, Copy, Like/Dislike, Fork, Time
// - Dot separators between action items
//
// Layout structure:
// ┌─────────────────────────────────────────────────────────────┐
// │ Assistant's message text here using PT Serif font           │
// │ (spans full width from left edge to right edge of input     │
// │  panel boundaries)                                          │
// ├─────────────────────────────────────────────────────────────┤
// │ [Logo] [Copy] [Like] [Dislike] [Fork] [Time]                │
// └─────────────────────────────────────────────────────────────┘
//
// The action buttons and separator line smoothly fade in when hovered
// and fade out when the cursor leaves, preventing layout shifting.

import { Tokens } from "../../../shared/tokens.slint";
import { MessageText } from "./message.slint";
import { Separator } from "./separator.slint";
import { OperonLogo } from "./operon.slint";
import { CopyButton } from "./copy.slint";
import { LikeButton } from "./like.slint";
import { DislikeButton } from "./dislike.slint";
import { ForkButton } from "./fork.slint";
import { TimeDisplay } from "./time.slint";

// Complete assistant message component with text and action bar.
// This represents a single assistant message in the chat history.
export component AssistantMessage inherits Rectangle {
    // The message text content
    in property <string> message-text: "";
    
    // Whether to show the blinking typing indicator cursor
    in property <bool> show-cursor: false;

    // Time text to display (e.g., "2m ago")
    in property <string> time-text: "Just now";

    // Like/Dislike state
    in-out property <bool> is-liked: false;
    in-out property <bool> is-disliked: false;

    // ===== Callbacks =====
    // Fired when the user clicks the Copy button
    callback copy-clicked();

    // Fired when the user clicks the Like button
    callback like-clicked();

    // Fired when the user clicks the Dislike button
    callback dislike-clicked();

    // Fired when the user clicks the Regenerate button (kept for API compatibility)
    callback regenerate-clicked();

    // Fired when the user clicks the Fork button
    callback fork-clicked();

    // ===== Layout =====
    // Transparent background - no bubble for assistant messages
    background: transparent;

    // Dynamic height based on message text and controls container height
    height: message-text-area.height + controls-container.height + 8px;

    // Outer TouchArea wrapping the entire component.
    // Making the layout a child of TouchArea ensures has-hover remains true
    // when hovering over interactive child elements like buttons.
    hover-touch := TouchArea {
        width: 100%;
        height: 100%;

        // Vertical layout for message text and controls container
        VerticalLayout {
            // Add equal padding on left and right to match input panel's internal padding
            padding-left: 12px;
            padding-right: 12px;
            spacing: 4px;
            alignment: start;

            // ===== MESSAGE TEXT AREA =====
            message-text-area := MessageText {
                message-text: root.message-text;
                show-cursor: root.show-cursor;
            }

            // ===== CONTROLS CONTAINER =====
            // Holds both the separator line and the action bar.
            // Opacity and visibility are tied to the hover state of the parent TouchArea.
            // It uses a fixed height to prevent structural/layout jumping when shown/hidden.
            controls-container := Rectangle {
                height: 29px; // 1px separator + 4px spacing + 24px action-bar
                vertical-stretch: 0;
                horizontal-stretch: 1;
                
                // Fade effect linked to parent hover state
                opacity: hover-touch.has-hover ? 1.0 : 0.0;
                
                // Disable interaction and visibility when completely faded out
                visible: self.opacity > 0.0;

                // Smooth opacity transition on hover enter/exit
                animate opacity { duration: 150ms; easing: ease-in-out; }

                VerticalLayout {
                    spacing: 4px;

                    // ===== SEPARATOR LINE =====
                    separator-line := Separator {
                        // Width is automatically filled by VerticalLayout
                    }

                    // ===== ACTION BAR =====
                    // Contains all action buttons and info with dot separators
                    action-bar := Rectangle {
                        height: 24px;
                        vertical-stretch: 0;
                        background: transparent;

                        // Horizontal layout for action items
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            // 1. Operon Logo
                            OperonLogo { }

                            // 2. Copy button
                            CopyButton {
                                clicked => {
                                    root.copy-clicked();
                                }
                            }

                            // 3. Like button
                            LikeButton {
                                is-liked <=> root.is-liked;

                                clicked => {
                                    if (root.is-liked) {
                                        root.is-disliked = false;
                                    }
                                    root.like-clicked();
                                }
                            }

                            // 4. Dislike button
                            DislikeButton {
                                is-disliked <=> root.is-disliked;

                                clicked => {
                                    if (root.is-disliked) {
                                        root.is-liked = false;
                                    }
                                    root.dislike-clicked();
                                }
                            }

                            // 5. Fork button
                            ForkButton {
                                clicked => {
                                    root.fork-clicked();
                                }
                            }

                            // 6. Time display
                            TimeDisplay {
                                time-text: root.time-text;
                            }
                        }
                    }
                }
            }
        }
    }
}
