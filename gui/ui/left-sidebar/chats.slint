// Chats section component for the sidebar.
//
// This component displays a list of standalone conversations that are not associated
// with any project. These are general-purpose chats that exist independently.
// The section includes a header and a scrollable list of conversation items.

import { Tokens } from "../shared/tokens.slint";
import { Conversation } from "./conversation.slint";
import { SidebarConversation } from "./types.slint";

// Main Chats section containing standalone conversation items.
// These conversations are not grouped under any project.
export component Chats inherits Rectangle {
    // Array of chat titles to display
    in property <[SidebarConversation]> chat-titles: [];
    
    // Currently active/selected chat index (-1 means none selected)
    in-out property <int> active-chat-index: -1;
    
    // Whether the chats section is expanded
    in-out property <bool> is-expanded: true;
    
    // Callback fired when a chat is clicked
    callback chat-clicked(string, int);
    callback delete-chat-clicked(string, int);
    
    // Callback fired when the section header is clicked (for expand/collapse)
    callback header-clicked();

    // Callback fired when the new chat button is clicked
    callback new-chat-clicked();
    
    // Dynamic height based on content
    // In a real implementation, this would be inside a ScrollView
    height: content.preferred-height;
    horizontal-stretch: 1;
    
    // Vertical layout for stacking section header and chat items
    content := VerticalLayout {
        spacing: 4px;
        padding: 4px;
        
        // Section header with "Chats" label and expand/collapse chevron
        header := Rectangle {
            height: 28px;
            horizontal-stretch: 1;
            
            // Subtle hover effect on header
            background: header-touch.has-hover 
                ? Tokens.dropdown-surface 
                : transparent;
            
            animate background { duration: 150ms; }
            border-radius: 6px;
            
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 56px; // Reserved space on the right for new-chat button and chevron
                spacing: 6px;
                
                // Chats section icon
                Image {
                    source: @image-url("../../assets/icons/sidebar/chats.svg");
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.text-muted;
                    image-fit: contain;
                }
                
                // "Chats" section title
                Text {
                    text: "Chats";
                    color: Tokens.text-muted;
                    font-size: Tokens.body-font-size - 1px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            
            // Touch area for header click (expand/collapse)
            header-touch := TouchArea {
                clicked => {
                    root.is-expanded = !root.is-expanded;
                    root.header-clicked();
                }
            }

            // 1. New Chat button (placed before the chevron)
            // Defined after the main touch-area in Slint to ensure it sits on top in the z-order
            // and receives mouse clicks properly instead of letting them fall through to expand/collapse.
            new-chat-btn := Rectangle {
                x: parent.width - 50px;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: new-chat-touch.has-hover ? Tokens.dropdown-surface-hover : transparent;
                visible: header-touch.has-hover || new-chat-touch.has-hover;

                animate background { duration: 100ms; }

                Image {
                    source: @image-url("../../assets/icons/sidebar/new-chat.svg");
                    width: 12px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                    x: (parent.width - self.width) / 2;
                    colorize: Tokens.text-muted;
                    image-fit: contain;
                }

                new-chat-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.new-chat-clicked();
                    }
                }
            }

            // 2. Expand/collapse chevron indicator (at the far right)
            chevron-indicator := Image {
                x: parent.width - 24px;
                y: (parent.height - self.height) / 2;
                source: is-expanded 
                    ? @image-url("../../assets/icons/sidebar/chevron-down.svg")
                    : @image-url("../../assets/icons/sidebar/chevron-right.svg");
                width: 16px;
                height: 16px;
                colorize: Tokens.text-muted;
                image-fit: contain;
            }
        }
        
        // Chat items list (only visible when expanded)
        if is-expanded : VerticalLayout {
            spacing: 2px;
            
            // Dynamically create conversation items from the chat-titles array
            for chat[index] in root.chat-titles : Conversation {
                title: chat.title;
                is-active: index == root.active-chat-index;
                
                clicked => {
                    root.active-chat-index = index;
                    root.chat-clicked(chat.id, index);
                }
                
                delete-clicked => {
                    root.delete-chat-clicked(chat.id, index);
                }
            }
            
            // Empty state message when no chats exist
            if root.chat-titles.length == 0 : Rectangle {
                height: 60px;
                horizontal-stretch: 1;
                
                VerticalLayout {
                    alignment: center;
                    
                    Text {
                        text: "No chats yet";
                        color: Tokens.text-muted;
                        font-size: Tokens.body-font-size - 1px;
                        horizontal-alignment: center;
                    }
                    
                    Text {
                        text: "Start a new chat to begin";
                        color: Tokens.text-muted;
                        font-size: Tokens.body-font-size - 2px;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
