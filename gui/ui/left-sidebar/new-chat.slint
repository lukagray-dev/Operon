// New Chat button component for the sidebar.
//
// This component provides a prominent button at the top of the sidebar that allows
// users to start a new conversation. It features an icon and text with hover states
// for visual feedback.

import { Tokens } from "../shared/tokens.slint";

// Primary action button for creating new chat conversations.
// Positioned at the top of the sidebar as the most common user action.
export component NewChat inherits Rectangle {
    // Callback fired when the user clicks the New Chat button
    callback clicked();
    
    // Fixed height for consistent button sizing
    height: 40px;
    
    // Horizontal stretch to fill sidebar width
    horizontal-stretch: 1;
    
    // Background color changes on hover for visual feedback
    background: touch-area.has-hover 
        ? Tokens.dropdown-surface-hover 
        : Tokens.dropdown-surface;
    
    // Smooth background transitions
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners matching the design system
    border-radius: 8px;
    
    // Horizontal layout for icon + text arrangement
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        
        // Icon for the new chat action
        // Using colorize to apply the current text color to the SVG
        Image {
            source: @image-url("../../assets/icons/sidebar/new-chat.svg");
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            colorize: Tokens.text-primary;
            image-fit: contain;
        }
        
        // "New chat" label text
        Text {
            text: "New chat";
            color: Tokens.text-primary;
            font-size: Tokens.body-font-size;
            vertical-alignment: center;
        }
    }
    
    // Touch area for click detection covering the entire button
    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
