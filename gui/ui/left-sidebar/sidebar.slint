// Main left sidebar component for the Operon GUI.
//
// This component assembles all sidebar sections into a cohesive navigation panel.
// It includes:
// - Top action buttons (New Chat, Search, Plugins)
// - Projects section with expandable project groups
// - Chats section for standalone conversations
// - Bottom Settings button
// - Resizable functionality via drag handle
//
// The sidebar uses a Flickable for the middle content area to handle overflow
// when there are many projects and chats.

import { Tokens } from "../shared/tokens.slint";
import { NewChat } from "./new-chat.slint";
import { Search } from "./search.slint";
import { Plugins } from "./plugins.slint";
import { Projects } from "./projects.slint";
import { Chats } from "./chats.slint";
import { Settings } from "./settings.slint";

// Main sidebar component with resizable width and scrollable content.
// This is the primary navigation interface for the application.
export component Sidebar inherits Rectangle {
    // Sidebar width - can be adjusted by dragging the resize handle
    in-out property <length> sidebar-width: 240px;
    
    // Minimum and maximum width constraints for resizing
    property <length> sidebar-min-width: 180px;
    property <length> sidebar-max-width: 400px;
    
    // Data properties for dynamic content
    // Projects: array of {name: string, conversations: [string]}
    in property <[{name: string, conversations: [string]}]> projects: [
        {
            name: "Lunify",
            conversations: [
                "Hi",
                "You are working in this directory",
                "Add CloudStream style streaming",
                "Fix FFI error handling",
                "Fix player bar position"
            ]
        },
        {
            name: "Operon",
            conversations: [
                "I was building an AI agent named Operon...",
                "Continue plan implementation",
                "Execute Prompt.md",
                "I was building an AI agent named Op...",
                "Replace markdown renderer"
            ]
        }
    ];
    
    // Standalone chats: array of chat title strings
    in property <[string]> chats: [
        "Execute Prompt.md",
        "Explain this project to me",
        "Connect to GitHub",
        "Connect your favorite apps to Codex"
    ];
    
    // Active selection state
    in-out property <int> active-project-index: 0;
    in-out property <int> active-conversation-index: 0;
    in-out property <int> active-chat-index: 0;
    
    // Callbacks for user interactions
    callback new-chat-clicked();
    callback search-clicked();
    callback plugins-clicked();
    callback settings-clicked();
    callback project-conversation-clicked(int /* project-index */, int /* conversation-index */);
    callback chat-clicked(int /* chat-index */);
    callback width-changed(length /* new-width */);
    
    // Set the sidebar width from the property
    width: root.sidebar-width;
    
    // Sidebar background color - match titlebar
    background: Tokens.titlebar_background;
    
    // Main vertical layout dividing the sidebar into three sections:
    // 1. Top actions (fixed)
    // 2. Scrollable content (flexible)
    // 3. Bottom settings (fixed)
    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        
        // ===== TOP SECTION: Action Buttons =====
        // Fixed at the top, always visible
        top-actions := VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0; // Don't expand
            
            // New Chat button - primary action
            NewChat {
                clicked => {
                    root.new-chat-clicked();
                }
            }
            
            // Search button
            Search {
                clicked => {
                    root.search-clicked();
                }
            }
            
            // Plugins button
            Plugins {
                clicked => {
                    root.plugins-clicked();
                }
            }
            
            // Separator line after top actions
            Rectangle {
                height: 1px;
                background: Tokens.dropdown-separator;
                horizontal-stretch: 1;
            }
        }
        
        // ===== MIDDLE SECTION: Scrollable Content =====
        // Contains Projects and Chats sections
        // Expands to fill available space and scrolls when content overflows
        Flickable {
            vertical-stretch: 1; // Take all available space
            viewport-height: content-layout.preferred-height;
            
            // Vertical layout for Projects and Chats sections
            content-layout := VerticalLayout {
                spacing: 16px;
                width: parent.width;
                
                // Projects section
                Projects {
                    projects: root.projects;
                    active-project-index: root.active-project-index;
                    active-conversation-index: root.active-conversation-index;
                    
                    conversation-clicked(proj-idx, conv-idx) => {
                        root.active-project-index = proj-idx;
                        root.active-conversation-index = conv-idx;
                        // Clear chat selection when project conversation is selected
                        root.active-chat-index = -1;
                        root.project-conversation-clicked(proj-idx, conv-idx);
                    }
                }
                
                // Separator between Projects and Chats
                Rectangle {
                    height: 1px;
                    background: Tokens.dropdown-separator;
                    horizontal-stretch: 1;
                }
                
                // Chats section
                Chats {
                    chat-titles: root.chats;
                    active-chat-index: root.active-chat-index;
                    
                    chat-clicked(chat-idx) => {
                        root.active-chat-index = chat-idx;
                        // Clear project selection when standalone chat is selected
                        root.active-project-index = -1;
                        root.active-conversation-index = -1;
                        root.chat-clicked(chat-idx);
                    }
                }
            }
        }
        
        // ===== BOTTOM SECTION: Settings Button =====
        // Fixed at the bottom, always visible
        bottom-actions := VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0; // Don't expand
            
            // Separator line before settings
            Rectangle {
                height: 1px;
                background: Tokens.dropdown-separator;
                horizontal-stretch: 1;
            }
            
            // Settings button
            Settings {
                clicked => {
                    root.settings-clicked();
                }
            }
        }
    }
    
    // ===== RESIZE HANDLE =====
    // Positioned on the right edge of the sidebar
    // Allows users to drag and resize the sidebar width
    resize-handle := Rectangle {
        x: parent.width - self.width / 2;
        width: 4px;
        height: parent.height;
        
        // Subtle visual indicator on hover
        background: resize-touch.has-hover 
            ? Tokens.accent-blue 
            : transparent;
        
        // Smooth color transition
        animate background { duration: 150ms; }
        
        // Touch area for drag detection
        resize-touch := TouchArea {
            // Store the initial width when drag starts
            property <length> drag-start-width: root.sidebar-width;
            
            // Change cursor to indicate resizability
            mouse-cursor: ew-resize;
            
            // Handle pointer events to detect drag start
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.drag-start-width = root.sidebar-width;
                }
            }
            
            // Handle drag movement
            moved => {
                if (self.pressed) {
                    // Calculate new width based on drag distance
                    root.sidebar-width = max(
                        root.sidebar-min-width,
                        min(
                            root.sidebar-max-width,
                            self.drag-start-width + (self.mouse-x - self.pressed-x)
                        )
                    );
                    
                    // Notify parent of width change
                    root.width-changed(root.sidebar-width);
                }
            }
        }
    }
}
