// Search input/button component for the sidebar.
//
// This component provides quick access to search functionality. When not active,
// it displays as a clickable search button. Clicking it expands it into an
// active text input field with close and clear controls.

import { Tokens } from "../shared/tokens.slint";

export component Search inherits Rectangle {
    // Current search text query entered by the user
    in-out property <string> text: "";
    
    // Whether we are currently in active search input mode
    in-out property <bool> is-searching: false;
    
    // Callback fired when the user types or updates the search query
    callback search-query-changed(string);
    
    // Callback fired when the search mode is cancelled/closed
    callback search-cancelled();
    
    // Fixed height for consistent button/input sizing
    height: 40px;
    
    // Horizontal stretch to fill sidebar width
    horizontal-stretch: 1;
    
    // Background changes color depending on active search input state
    background: root.is-searching 
        ? Tokens.dropdown-surface 
        : (touch-area.has-hover ? Tokens.dropdown-surface-hover : transparent);
    
    // Rounded corners matching the design system
    border-radius: 8px;
    
    // Border highlights the active input field
    border-width: root.is-searching ? 1px : 0px;
    border-color: root.is-searching ? Tokens.dropdown-border : transparent;
    
    // Smooth transitions
    animate background { duration: 150ms; }
    
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        
        // Search icon (always visible)
        Image {
            source: @image-url("../../assets/icons/sidebar/search.svg");
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            colorize: root.is-searching ? Tokens.text-muted : Tokens.text-secondary;
            image-fit: contain;
            
            animate colorize { duration: 150ms; }
        }
        
        // "Search" static text (only shown when not active)
        if (!root.is-searching) : Text {
            text: "Search";
            color: Tokens.text-secondary;
            font-size: Tokens.body-font-size;
            vertical-alignment: center;
        }
        
        // Text input field wrapped in a horizontal scroll container (only shown in search mode)
        if (root.is-searching) : Rectangle {
            horizontal-stretch: 1;
            clip: true; // Clips text overflow to keep it inside the input bounds
            
            flickable := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: max(self.width, input.preferred-width);
                interactive: true;
                
                input := TextInput {
                    width: max(parent.width, self.preferred-width);
                    font-size: Tokens.body-font-size;
                    font-family: Tokens.font-family;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    single-line: true;
                    text <=> root.text;
                    
                    edited => {
                        root.search-query-changed(self.text);
                        
                        // Auto-scroll viewport to keep cursor visible as user types
                        if (self.preferred-width > flickable.width) {
                            flickable.viewport-x = flickable.width - self.preferred-width;
                        }
                    }
                }
            }
        }
        
        // Clear search text button (only shown when there is text typed)
        if (root.is-searching && root.text != "") : clear-btn := Image {
            source: @image-url("../../assets/icons/sidebar/delete.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: clear-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
            image-fit: contain;
            
            clear-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.text = "";
                    root.search-query-changed("");
                }
            }
        }
        
        // Exit/Cancel search mode button
        if (root.is-searching) : close-btn := Image {
            source: @image-url("../../assets/icons/settings/close.svg");
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: close-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
            image-fit: contain;
            
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.is-searching = false;
                    root.text = "";
                    root.search-query-changed("");
                    root.search-cancelled();
                }
            }
        }
    }
    
    // When not searching, clicking the button transitions into active search mode
    touch-area := TouchArea {
        mouse-cursor: root.is-searching ? default : pointer;
        enabled: !root.is-searching;
        clicked => {
            root.is-searching = true;
        }
    }
}
