// Individual conversation/chat item component.
//
// This component represents a single chat conversation in the sidebar. It displays
// the chat title and handles hover/click interactions. Used within both the Projects
// and Chats sections to show individual conversation entries.

import { Tokens } from "../shared/tokens.slint";

// Reusable conversation item that shows a chat title with hover and active states.
// Designed to be used in lists within the Projects and Chats sections.
export component Conversation inherits Rectangle {
    // The display text for this conversation
    in property <string> title: "Untitled Chat";
    
    // Whether this conversation is currently selected/active
    in property <bool> is-active: false;
    
    // Callback fired when the user clicks on this conversation
    callback clicked();
    
    // Fixed height for consistent list item sizing
    height: 32px;
    
    // Horizontal stretch to fill the parent container width
    horizontal-stretch: 1;
    
    // Background changes based on interaction state:
    // - Active: slightly lighter background to indicate selection
    // - Hover: subtle highlight to show interactivity
    // - Default: transparent to blend with sidebar
    background: is-active 
        ? Tokens.dropdown-surface-hover 
        : (touch-area.has-hover ? Tokens.dropdown-surface : transparent);
    
    // Smooth background color transitions for polished feel
    animate background { duration: 150ms; easing: ease-in-out; }
    
    // Rounded corners for modern appearance
    border-radius: 6px;
    
    // Horizontal layout for potential future icon + text combination
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        
        // Chat title text with ellipsis overflow handling
        Text {
            text: root.title;
            color: is-active ? Tokens.text-primary : Tokens.text-secondary;
            font-size: Tokens.body-font-size;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide; // Truncate long titles with "..."
            
            // Smooth color transition when selection changes
            animate color { duration: 150ms; }
        }
    }
    
    // Touch area covering the entire conversation item for click detection
    touch-area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
