// Projects section component for the sidebar.
//
// This component displays a collapsible list of projects, each containing their
// associated conversations. Projects act as organizational containers for related
// chats, helping users manage multiple workstreams or contexts.

import { Tokens } from "../shared/tokens.slint";
import { Conversation } from "./conversation.slint";

// Main Projects section containing project items.
// This is the container that holds all projects and their conversations.
export component Projects inherits Rectangle {
    // Array of project data structures
    // Each project should have: name (string) and conversations (array of strings)
    in property <[{name: string, conversations: [string]}]> projects: [];
    
    // Currently active project index (-1 means none selected)
    in-out property <int> active-project-index: -1;
    
    // Currently active conversation index within the active project
    in-out property <int> active-conversation-index: -1;
    
    // Whether the projects section is expanded
    in-out property <bool> is-expanded: true;
    
    // Callback fired when a conversation is clicked
    // Parameters: project-index, conversation-index
    callback conversation-clicked(int, int);
    
    // Callback fired when the section header is clicked (for expand/collapse)
    callback header-clicked();
    
    // Dynamic height based on content
    height: content.preferred-height;
    horizontal-stretch: 1;
    
    // Vertical layout for stacking section header and project items
    content := VerticalLayout {
        spacing: 4px;
        padding: 4px;
        
        // Section header with "Projects" label and expand/collapse chevron
        header := Rectangle {
            height: 28px;
            horizontal-stretch: 1;
            
            // Subtle hover effect on header
            background: header-touch.has-hover 
                ? Tokens.dropdown-surface 
                : transparent;
            
            animate background { duration: 150ms; }
            border-radius: 6px;
            
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                
                // Projects section icon
                Image {
                    source: @image-url("../../assets/icons/sidebar/projects.svg");
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.text-muted;
                    image-fit: contain;
                }
                
                // "Projects" section title
                Text {
                    text: "Projects";
                    color: Tokens.text-muted;
                    font-size: Tokens.body-font-size - 1px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                
                // Expand/collapse chevron indicator - positioned on the right
                Image {
                    source: is-expanded 
                        ? @image-url("../../assets/icons/sidebar/chevron-down.svg")
                        : @image-url("../../assets/icons/sidebar/chevron-right.svg");
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.text-muted;
                    image-fit: contain;
                }
            }
            
            // Touch area for header click (expand/collapse)
            header-touch := TouchArea {
                clicked => {
                    root.is-expanded = !root.is-expanded;
                    root.header-clicked();
                }
            }
        }
        
        // Project items list (only visible when expanded)
        if is-expanded : VerticalLayout {
            spacing: 2px;
            
            // Dynamically create project items from the projects array
            for project[project-index] in root.projects : VerticalLayout {
                spacing: 2px;
                
                // Project header
                project-header := Rectangle {
                    height: 32px;
                    horizontal-stretch: 1;
                    
                    background: project-touch.has-hover 
                        ? Tokens.dropdown-surface 
                        : transparent;
                    
                    animate background { duration: 150ms; }
                    border-radius: 6px;
                    
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        
                        // Project folder icon
                        Image {
                            source: @image-url("../../assets/icons/sidebar/projects.svg");
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            colorize: Tokens.text-secondary;
                            image-fit: contain;
                        }
                        
                        // Project name text
                        Text {
                            text: project.name;
                            color: Tokens.text-secondary;
                            font-size: Tokens.body-font-size;
                            vertical-alignment: center;
                            overflow: elide;
                            // Stretch to occupy remaining horizontal space, pushing the chevron to the right
                            horizontal-stretch: 1;
                        }

                        // Project expand/collapse chevron indicator (on the right)
                        // Shows chevron-down when the project is currently active (expanded)
                        // and chevron-right when it is collapsed.
                        Image {
                            source: project-index == root.active-project-index
                                ? @image-url("../../assets/icons/sidebar/chevron-down.svg")
                                : @image-url("../../assets/icons/sidebar/chevron-right.svg");
                            width: 14px;
                            height: 14px;
                            // Centered vertically within the 32px project header box
                            y: (parent.height - self.height) / 2;
                            colorize: Tokens.text-muted;
                            image-fit: contain;
                        }
                    }
                    
                    // Clicking the project header toggles its expansion state.
                    // If the project is already expanded (matches active-project-index), clicking it
                    // collapses it by setting active-project-index to -1. Otherwise, it expands it.
                    project-touch := TouchArea {
                        clicked => {
                            if root.active-project-index == project-index {
                                root.active-project-index = -1;
                            } else {
                                root.active-project-index = project-index;
                            }
                        }
                    }
                }
                
                // Conversations list (only visible when this project is selected)
                if project-index == root.active-project-index : VerticalLayout {
                    spacing: 2px;
                    padding-left: 12px;
                    
                    for conversation[conv-index] in project.conversations : Conversation {
                        title: conversation;
                        is-active: conv-index == root.active-conversation-index;
                        
                        clicked => {
                            root.active-conversation-index = conv-index;
                            root.conversation-clicked(project-index, conv-index);
                        }
                    }
                }
            }
        }
    }
}
