// whatsapp.slint — WhatsApp section component for left sidebar.
import { Tokens } from "../shared/tokens.slint";
import { Conversation } from "./conversation.slint";
import { SidebarProject } from "./types.slint";

export component WhatsAppSection inherits Rectangle {
    in property <[SidebarProject]> contacts: [];
    in-out property <int> active-contact-index: -1;
    in-out property <int> active-session-index: -1;
    in-out property <bool> is-expanded: true;

    callback session-clicked(string /* session_id */, string /* contact_number */);

    height: content.preferred-height;
    horizontal-stretch: 1;

    content := VerticalLayout {
        spacing: 4px;
        padding: 4px;

        // Section Header: "WhatsApp Channels"
        header := Rectangle {
            height: 28px;
            horizontal-stretch: 1;
            background: header-touch.has-hover ? Tokens.dropdown-surface : transparent;
            border-radius: 6px;

            animate background { duration: 150ms; }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 24px;
                spacing: 6px;

                Image {
                    source: @image-url("../../assets/icons/settings/category-channels.svg");
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.text-muted;
                    image-fit: contain;
                }

                Text {
                    text: "WhatsApp";
                    color: Tokens.text-muted;
                    font-size: Tokens.body-font-size - 1px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Image {
                    source: root.is-expanded 
                        ? @image-url("../../assets/icons/sidebar/chevron-down.svg")
                        : @image-url("../../assets/icons/sidebar/chevron-right.svg");
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.text-muted;
                    image-fit: contain;
                }
            }

            header-touch := TouchArea {
                clicked => {
                    root.is-expanded = !root.is-expanded;
                }
            }
        }

        // Contact groups (only visible when expanded)
        if root.is-expanded : VerticalLayout {
            spacing: 6px;

            for contact[contact_idx] in root.contacts : VerticalLayout {
                spacing: 2px;

                // Contact Header (Phone Number as Project Folder)
                Rectangle {
                    height: 24px;
                    background: rgba(255, 255, 255, 0.03);
                    border-radius: 4px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 6px;

                        Text {
                            text: "📱 " + contact.name;
                            color: #e8e8e8;
                            font-size: Tokens.body-font-size - 2px;
                            font-weight: 600;
                            vertical-alignment: center;
                            font-family: Tokens.mono_font_family;
                        }
                    }
                }

                // Contact's sessions
                for session[sess_idx] in contact.conversations : Conversation {
                    title: session.title;
                    is-active: contact_idx == root.active-contact-index && sess_idx == root.active-session-index;

                    clicked => {
                        root.active-contact-index = contact_idx;
                        root.active-session-index = sess_idx;
                        root.session-clicked(session.id, contact.name);
                    }
                }
            }

            if root.contacts.length == 0 : Rectangle {
                height: 40px;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "No active WhatsApp contacts";
                        color: Tokens.text-muted;
                        font-size: Tokens.body-font-size - 2px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
