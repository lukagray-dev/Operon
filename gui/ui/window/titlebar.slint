// The titlebar owns the layout of the logo, navigation controls, menu labels,
// and the right-side window buttons.
//
// This component stays focused on structure only. Rust decides what each
// action actually does, while the Slint markup controls the spacing, color, and
// open/close state of the menus.

import { Tokens } from "../shared/tokens.slint";
import { FilesMenu } from "./menu/files.slint";
import { HelpMenu } from "./menu/help.slint";
import { ViewMenu } from "./menu/view.slint";
import { NavigationControls } from "./navigations.slint";
import { WindowActions } from "./action.slint";
import { WindowMenu } from "./menu/window.slint";

export component Titlebar inherits Rectangle {
    in-out property <int> active_menu: 0;
    in property <bool> is_maximized: false;
    in property <float> ui_scale: 1.0;
    // Current visibility state of the left sidebar
    in-out property <bool> sidebar_open: true;

    // Callback fired when the user clicks the brand logo to toggle the sidebar
    callback sidebar_toggle_requested();
    callback minimize_requested();
    callback maximize_requested();
    callback close_window_requested();
    callback exit_requested();
    callback drag_window_requested();
    callback reload_requested();
    callback zoom_in_requested();
    callback zoom_out_requested();
    callback actual_size_requested();
    callback documentation_requested();
    callback report_bug_requested();
    callback follow_creator_requested();
    callback see_repo_requested();

    height: Tokens.titlebar_height;
    background: Tokens.titlebar_background;

    // This invisible drag region sits behind the visible controls. The empty
    // parts of the titlebar can grab the window, while the buttons and menus
    // above it keep their own interactions.
    drag_area := TouchArea {
        x: 0px;
        y: Tokens.window_resize_border_width;
        width: parent.width;
        height: parent.height - Tokens.window_resize_border_width;
        mouse-cursor: default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag_window_requested();
            }
        }
        double-clicked => {
            root.maximize_requested();
        }
    }

    // Brand logo and sidebar toggle container.
    // By default, displays the Operon logo. When the user hovers over the logo,
    // it switches to showing a sidebar-toggle icon (sidebar-opened or sidebar-closed)
    // depending on the current open/collapsed state of the left sidebar.
    // Clicking the container toggles the sidebar's visibility.
    brand_container := Rectangle {
        x: Tokens.titlebar_padding_x;
        y: (Tokens.titlebar_height - Tokens.titlebar_logo_size) / 2;
        width: Tokens.titlebar_logo_size;
        height: Tokens.titlebar_logo_size;

        logo_image := Image {
            width: 100%;
            height: 100%;
            // Show action icon on hover, default to brand logo when not hovered
            source: brand_touch.has-hover
                ? (root.sidebar_open 
                    ? @image-url("../../assets/icons/action/sidebar-opened.svg")
                    : @image-url("../../assets/icons/action/sidebar-closed.svg"))
                : @image-url("../../assets/brand/operon.svg");
            
            // Highlight the action icon with text-primary color when hovered
            colorize: brand_touch.has-hover ? Tokens.text-primary : transparent;
            image-fit: contain;
        }

        brand_touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.sidebar_open = !root.sidebar_open;
                root.sidebar_toggle_requested();
            }
        }
    }

    // Back and forward are visual-only for now, but the chrome still reserves
    // the space so the future navigation wiring can drop in cleanly later.
    navigation := NavigationControls {
        x: brand_container.x + brand_container.width + 8px;
        y: (Tokens.titlebar_height - Tokens.titlebar_icon_hit_height) / 2;
    }

    files_menu := FilesMenu {
        x: navigation.x + navigation.width + 10px;
        y: 0px;
        open: root.active_menu == 1;
        ui_scale: root.ui_scale;
        header_clicked => {
            root.active_menu = root.active_menu == 1 ? 0 : 1;
        }
        dismiss => {
            root.active_menu = 0;
        }
    }

    view_menu := ViewMenu {
        x: files_menu.x + files_menu.width + Tokens.titlebar_menu_gap;
        y: 0px;
        open: root.active_menu == 2;
        ui_scale: root.ui_scale;
        header_clicked => {
            root.active_menu = root.active_menu == 2 ? 0 : 2;
        }
        dismiss => {
            root.active_menu = 0;
        }
        reload_requested => {
            root.reload_requested();
        }
        zoom_in_requested => {
            root.zoom_in_requested();
        }
        zoom_out_requested => {
            root.zoom_out_requested();
        }
        actual_size_requested => {
            root.actual_size_requested();
        }
    }

    window_menu := WindowMenu {
        x: view_menu.x + view_menu.width + Tokens.titlebar_menu_gap;
        y: 0px;
        open: root.active_menu == 3;
        ui_scale: root.ui_scale;
        header_clicked => {
            root.active_menu = root.active_menu == 3 ? 0 : 3;
        }
        dismiss => {
            root.active_menu = 0;
        }
        close_window_requested => {
            root.close_window_requested();
        }
        exit_requested => {
            root.exit_requested();
        }
    }

    help_menu := HelpMenu {
        x: window_menu.x + window_menu.width + Tokens.titlebar_menu_gap;
        y: 0px;
        open: root.active_menu == 4;
        ui_scale: root.ui_scale;
        header_clicked => {
            root.active_menu = root.active_menu == 4 ? 0 : 4;
        }
        dismiss => {
            root.active_menu = 0;
        }
        documentation_requested => {
            root.documentation_requested();
        }
        report_bug_requested => {
            root.report_bug_requested();
        }
        follow_creator_requested => {
            root.follow_creator_requested();
        }
        see_repo_requested => {
            root.see_repo_requested();
        }
    }

    actions := WindowActions {
        x: parent.width - Tokens.titlebar_actions_width - Tokens.titlebar_padding_x;
        y: (Tokens.titlebar_height - Tokens.titlebar_icon_hit_height) / 2;
        is_maximized: root.is_maximized;
        minimize_requested => {
            root.minimize_requested();
        }
        maximize_requested => {
            root.maximize_requested();
        }
        close_window_requested => {
            root.close_window_requested();
        }
    }
}
