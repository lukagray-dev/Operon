// The Help menu opens external URLs for documentation and support links.
//
// The two placeholder entries stay inert for now because the backend does not
// yet expose real update or about handling.

import { DropdownItem, DropdownSurface, DropdownTokens, DropdownTrigger } from "../../shared/dropdown.slint";
import { Tokens } from "../../shared/tokens.slint";

export component HelpMenu inherits Rectangle {
    in property <bool> open: false;
    in property <float> ui_scale: 1.0;
    callback header_clicked();
    callback dismiss();
    callback documentation_requested();
    callback report_bug_requested();
    callback follow_creator_requested();
    callback see_repo_requested();

    width: trigger.width;
    height: Tokens.titlebar_height;

    trigger := DropdownTrigger {
        x: 0px;
        y: (Tokens.titlebar_height - DropdownTokens.trigger_hit_height) / 2;
        label: "Help";
        active: root.open;
        ui_scale: root.ui_scale;
        clicked => {
            root.header_clicked();
        }
    }

    panel := DropdownSurface {
        x: 0px;
        y: Tokens.titlebar_height;
        width: DropdownTokens.surface_width;
        height: 190px;
        visible: root.open;

        documentation_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding;
            label: "Documentation";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.documentation_requested();
            }
        }

        check_for_update_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + DropdownTokens.item_height + DropdownTokens.item_gap;
            label: "Check for update";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
            }
        }

        report_bug_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 2;
            label: "Report bug";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.report_bug_requested();
            }
        }

        about_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 3;
            label: "About";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
            }
        }

        follow_creator_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 4;
            label: "Follow creator";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.follow_creator_requested();
            }
        }

        see_repo_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 5;
            label: "See repo";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.see_repo_requested();
            }
        }
    }
}
