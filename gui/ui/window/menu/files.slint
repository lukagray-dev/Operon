// The Files menu keeps its first pass intentionally inert.
//
// The menu shell still matters because it proves the dropdown interaction and
// gives us a stable place to wire real file actions later.

import { DropdownItem, DropdownSeparator, DropdownSurface, DropdownTokens, DropdownTrigger } from "../../shared/dropdown.slint";
import { Tokens } from "../../shared/tokens.slint";

export component FilesMenu inherits Rectangle {
    in property <bool> open: false;
    in property <float> ui_scale: 1.0;
    callback header_clicked();
    callback dismiss();
    callback open_project_clicked();

    width: trigger.width;
    height: Tokens.titlebar_height;

    trigger := DropdownTrigger {
        x: 0px;
        y: (Tokens.titlebar_height - DropdownTokens.trigger_hit_height) / 2;
        label: "Files";
        active: root.open;
        ui_scale: root.ui_scale;
        clicked => {
            root.header_clicked();
        }
    }

    panel := DropdownSurface {
        x: 0px;
        y: Tokens.titlebar_height;
        width: DropdownTokens.surface_width;
        height: 103px;
        visible: root.open;

        new_conversation := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding;
            label: "New conversation";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
            }
        }

        settings := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + DropdownTokens.item_height + DropdownTokens.item_gap;
            label: "Settings";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
            }
        }

        separator := DropdownSeparator {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 2;
        }

        open_project := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 2 + DropdownTokens.item_gap + 1px;
            label: "Open project";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.open_project_clicked();
            }
        }
    }
}
