// The View menu component for the Operon GUI.
//
// Hey friend! This menu lives in the titlebar and gives users quick options
// to toggle the major layout panels: the left sidebar, the bottom terminal panel,
// and the right git-diff sidebar panel.

import { DropdownItem, DropdownSurface, DropdownTokens, DropdownTrigger } from "../../shared/dropdown.slint";
import { Tokens } from "../../shared/tokens.slint";

export component ViewMenu inherits Rectangle {
    // Controls whether the dropdown menu panel is currently visible
    in property <bool> open: false;
    in property <float> ui_scale: 1.0;
    
    // Menu interaction callbacks
    callback header_clicked();
    callback dismiss();
    
    // Callbacks for layout panel toggles
    callback toggle_sidebar_requested();
    callback toggle_terminal_requested();
    callback toggle_git_diff_requested();

    width: trigger.width;
    height: Tokens.titlebar_height;

    // The clickable "View" header button in the titlebar menu bar
    trigger := DropdownTrigger {
        x: 0px;
        y: (Tokens.titlebar_height - DropdownTokens.trigger_hit_height) / 2;
        label: "View";
        active: root.open;
        ui_scale: root.ui_scale;
        clicked => {
            root.header_clicked();
        }
    }

    // The popover panel surface containing the 3 toggle items
    panel := DropdownSurface {
        x: 0px;
        y: Tokens.titlebar_height;
        width: DropdownTokens.surface_width;
        height: 103px; // Scaled to cleanly fit 3 dropdown items
        visible: root.open;

        // 1. Option to open or close the left navigation sidebar
        toggle_sidebar_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding;
            label: "Toggle left-sidebar";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.toggle_sidebar_requested();
            }
        }

        // 2. Option to open or close the bottom integrated terminal panel
        toggle_terminal_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + DropdownTokens.item_height + DropdownTokens.item_gap;
            label: "Toggle terminal";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.toggle_terminal_requested();
            }
        }

        // 3. Option to open or close the right git-diff inspection sidebar
        toggle_git_diff_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 2;
            label: "Toggle git-diff panel";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.toggle_git_diff_requested();
            }
        }
    }
}
