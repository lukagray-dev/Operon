// The View menu is the first menu with real behavior behind it.
//
// The Rust side owns the actual reload and zoom state, while this file keeps
// the visual dropdown shell small and predictable.

import { DropdownItem, DropdownSurface, DropdownTokens, DropdownTrigger } from "../../shared/dropdown.slint";
import { Tokens } from "../../shared/tokens.slint";

export component ViewMenu inherits Rectangle {
    in property <bool> open: false;
    in property <float> ui_scale: 1.0;
    callback header_clicked();
    callback dismiss();
    callback reload_requested();
    callback zoom_in_requested();
    callback zoom_out_requested();
    callback actual_size_requested();

    width: trigger.width;
    height: Tokens.titlebar_height;

    trigger := DropdownTrigger {
        x: 0px;
        y: (Tokens.titlebar_height - DropdownTokens.trigger_hit_height) / 2;
        label: "View";
        active: root.open;
        ui_scale: root.ui_scale;
        clicked => {
            root.header_clicked();
        }
    }

    panel := DropdownSurface {
        x: 0px;
        y: Tokens.titlebar_height;
        width: DropdownTokens.surface_width;
        height: 130px;
        visible: root.open;

        reload_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding;
            label: "Reload";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.reload_requested();
            }
        }

        zoom_in_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + DropdownTokens.item_height + DropdownTokens.item_gap;
            label: "Zoom in";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.zoom_in_requested();
            }
        }

        zoom_out_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 2;
            label: "Zoom out";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.zoom_out_requested();
            }
        }

        actual_size_item := DropdownItem {
            x: DropdownTokens.surface_padding;
            y: DropdownTokens.surface_padding + (DropdownTokens.item_height + DropdownTokens.item_gap) * 3;
            label: "Actual size";
            ui_scale: root.ui_scale;
            clicked => {
                root.dismiss();
                root.actual_size_requested();
            }
        }
    }
}
