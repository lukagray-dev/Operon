// Settings window component for the Operon GUI.
//
// This component represents the separate settings window that is spawned
// when the user clicks the Settings button in the sidebar.
//
// It uses a custom borderless design with the custom Titlebar component.

import { Tokens } from "../shared/tokens.slint";
import { Titlebar } from "../window/titlebar.slint";

// Import Sidebar and Settings main content viewport
import { SettingsSidebar } from "./left-sidebar/sidebar.slint";
import { SettingsMainContent } from "./main-content/main-content.slint";
import { ProviderSummary } from "./main-content/models/providers.slint";
import { PermissionItem } from "./main-content/permissions.slint";

export component SettingsWindow inherits Window {
    // Falls back to a comfortable centered size for settings page
    preferred-width: 960px;
    preferred-height: 540px;
    min-width: 960px;
    min-height: 540px;
    
    // Borderless frame styling: disable native frame and disable edge resize border when maximized
    no-frame: true;
    resize-border-width: root.window_maximized ? 0px : Tokens.window_resize_border_width;
    
    title: "Settings";
    icon: @image-url("../../assets/brand/operon.svg");
    background: Tokens.window_background;
    default-font-family: Tokens.font_family;

    // Window state properties
    in-out property <bool> window_maximized: false;
    in-out property <float> ui_scale: 1.0;
    // Current visibility state of the left sidebar (within settings - can default to true)
    in-out property <bool> sidebar_open: true;
    
    // Selected category index (0 = general, 1 = appearance, 2 = models, etc.)
    in-out property <int> active-category: 2; // Default to 'models' (idx 2) to match tauri

    // General settings properties
    in-out property <bool> general-autostart-enabled: false;
    in-out property <bool> general-minimize-to-tray-enabled: false;
    in-out property <bool> general-start-minimized: false;
    in-out property <int> general-close-button-action: 0;

    // General settings callbacks
    callback general-autostart-toggled(bool);
    callback general-minimize-to-tray-toggled(bool);
    callback general-start-minimized-toggled(bool);
    callback general-close-action-changed(int);

    // Callbacks
    callback minimize_requested();
    callback maximize_requested();
    callback close_window_requested();
    callback drag_window_requested();
    callback sidebar_toggle_requested();
    callback github_requested();
    callback documentation_requested();
    callback report_issue_requested();


    // Models configuration properties forwarded to viewport
    in property <[ProviderSummary]> providers: [];
    in-out property <string> selected-provider-id: "";
    in-out property <string> selected-provider-label: "";
    in-out property <string> api-base-url: "";
    in-out property <string> api-key: "";
    in-out property <string> active-model: "";
    in-out property <[string]> provider-models: [];
    in-out property <int> models-active-view: 0;

    // Models callbacks forwarded to viewport
    callback provider-selected(string, string);
    callback provider-save-clicked(string, string, string, string);
    callback provider-reload-clicked(string, string, string);
    callback provider-credentials-changed(string, string, string);

    // Permissions configuration properties forwarded to viewport
    in property <[string]> allowed-directories: [];
    in property <string> workspace-directory: "";
    in-out property <string> configure-directory: "";
    in-out property <int> permissions-active-tab: 0;
    in-out property <int> permissions-active-scope: 0;
    in-out property <string> permissions-new-directory-path: "";
    in property <[PermissionItem]> permission-items: [];

    // Permissions callbacks forwarded to viewport
    callback permission-tab-changed(int);
    callback permission-scope-changed(int);
    callback permission-configure-directory-clicked(string);
    callback permission-configure-directory-back();
    callback permission-add-directory-clicked(string);
    callback permission-remove-directory-clicked(string);
    callback permission-toggle-group-expanded(string);
    callback permission-set-mode(string, string, string);

    // WhatsApp configuration properties
    in-out property <string> whatsapp-owner-number: "";
    in-out property <[string]> whatsapp-allowlist: [];
    in-out property <string> whatsapp-connection-status: "Disconnected";
    in-out property <image> whatsapp-qr-code-image;
    in-out property <bool> whatsapp-show-qr-popup: false;
    in-out property <string> whatsapp-pairing-code: "";
    in-out property <bool> whatsapp-show-pairing-code-popup: false;
    in-out property <string> whatsapp-workspace-dir: "";
    in property <string> whatsapp-resolved-workspace-dir-placeholder: "";
    in property <bool> whatsapp-is-policy-covered: false;

    // WhatsApp callbacks
    callback whatsapp-save-clicked(string, [string]);
    callback whatsapp-scan-qr-clicked();
    callback whatsapp-add-allowlist(string);
    callback whatsapp-remove-allowlist(int);
    callback whatsapp-close-qr-popup();
    callback whatsapp-pair-account-clicked();
    callback whatsapp-generate-pairing-code-clicked();
    callback whatsapp-close-pairing-code-popup();
    callback whatsapp-browse-workspace-dir-clicked();

    // Telegram configuration properties
    in-out property <string> telegram-bot-token: "";
    in-out property <string> telegram-owner-chat-id: "";
    in-out property <[string]> telegram-allowlist: [];
    in-out property <string> telegram-connection-status: "Disconnected";
    in-out property <string> telegram-workspace-dir: "";
    in property <string> telegram-resolved-workspace-dir-placeholder: "";
    in property <bool> telegram-is-policy-covered: false;
    in-out property <string> telegram-test-status-message: "";

    // Telegram callbacks
    callback telegram-save-clicked(string, string, [string]);
    callback telegram-test-connection-clicked();
    callback telegram-add-allowlist(string);
    callback telegram-remove-allowlist(int);
    callback telegram-browse-workspace-dir-clicked();

    // Main layout container: Titlebar on top, body content below
    VerticalLayout {
        spacing: 0px;
        
        // 1. Custom Titlebar (no menus, no navigation, but keeps logo/toggle and minimize/maximize/close actions)
        titlebar := Titlebar {
            width: 100%;
            height: Tokens.titlebar_height;
            is_maximized: root.window_maximized;
            ui_scale: root.ui_scale;
            sidebar_open: root.sidebar_open;
            
            // Hide navigation controls and dropdown menus
            show_navigation: false;
            show_menus: false;

            sidebar_toggle_requested => {
                root.sidebar_open = titlebar.sidebar_open;
                root.sidebar_toggle_requested();
            }

            minimize_requested => { root.minimize_requested(); }
            maximize_requested => { root.maximize_requested(); }
            close_window_requested => { root.close_window_requested(); }
            drag_window_requested => { root.drag_window_requested(); }
        }

        // 2. Settings Content Area
        body := Rectangle {
            vertical-stretch: 1;
            background: transparent;

            HorizontalLayout {
                spacing: 0px;
                
                // Left settings category navigation sidebar (absolute black background)
                sidebar := SettingsSidebar {
                    active-category <=> root.active-category;
                    width: root.sidebar_open ? 200px : 0px;
                    visible: root.sidebar_open;
                }
                
                // Main settings content viewport (same background color as main app sidebar)
                main-content := SettingsMainContent {
                    horizontal-stretch: 1;
                    active-category: root.active-category;

                    // Bind general settings properties
                    general-autostart-enabled <=> root.general-autostart-enabled;
                    general-minimize-to-tray-enabled <=> root.general-minimize-to-tray-enabled;
                    general-start-minimized <=> root.general-start-minimized;
                    general-close-button-action <=> root.general-close-button-action;

                    // Bind general settings callbacks
                    general-autostart-toggled(val) => { root.general-autostart-toggled(val); }
                    general-minimize-to-tray-toggled(val) => { root.general-minimize-to-tray-toggled(val); }
                    general-start-minimized-toggled(val) => { root.general-start-minimized-toggled(val); }
                    general-close-action-changed(val) => { root.general-close-action-changed(val); }


                    // Bind models configuration properties
                    providers: root.providers;
                    selected-provider-id <=> root.selected-provider-id;
                    selected-provider-label <=> root.selected-provider-label;
                    api-base-url <=> root.api-base-url;
                    api-key <=> root.api-key;
                    active-model <=> root.active-model;
                    provider-models <=> root.provider-models;
                    models-active-view <=> root.models-active-view;

                    // Bind models callbacks
                    provider-selected(id, label) => { root.provider-selected(id, label); }
                    provider-save-clicked(id, base-url, api-key, active-model) => {
                        root.provider-save-clicked(id, base-url, api-key, active-model);
                    }
                    provider-reload-clicked(id, base-url, api-key) => {
                        root.provider-reload-clicked(id, base-url, api-key);
                    }
                    provider-credentials-changed(id, base-url, api-key) => {
                        root.provider-credentials-changed(id, base-url, api-key);
                    }

                    // Bind permissions configuration properties
                    allowed-directories: root.allowed-directories;
                    workspace-directory: root.workspace-directory;
                    configure-directory <=> root.configure-directory;
                    permissions-active-tab <=> root.permissions-active-tab;
                    permissions-active-scope <=> root.permissions-active-scope;
                    permissions-new-directory-path <=> root.permissions-new-directory-path;
                    permission-items: root.permission-items;

                    // Bind permissions callbacks
                    permission-tab-changed(idx) => { root.permission-tab-changed(idx); }
                    permission-scope-changed(idx) => { root.permission-scope-changed(idx); }
                    permission-configure-directory-clicked(dir) => { root.permission-configure-directory-clicked(dir); }
                    permission-configure-directory-back() => { root.permission-configure-directory-back(); }
                    permission-add-directory-clicked(dir) => { root.permission-add-directory-clicked(dir); }
                    permission-remove-directory-clicked(dir) => { root.permission-remove-directory-clicked(dir); }
                    permission-toggle-group-expanded(gk) => { root.permission-toggle-group-expanded(gk); }
                    permission-set-mode(k, kind, m) => { root.permission-set-mode(k, kind, m); }

                    // Bind WhatsApp configuration properties
                    whatsapp-owner-number <=> root.whatsapp-owner-number;
                    whatsapp-allowlist <=> root.whatsapp-allowlist;
                    whatsapp-connection-status <=> root.whatsapp-connection-status;
                    whatsapp-qr-code-image <=> root.whatsapp-qr-code-image;
                    whatsapp-show-qr-popup <=> root.whatsapp-show-qr-popup;
                    whatsapp-pairing-code <=> root.whatsapp-pairing-code;
                    whatsapp-show-pairing-code-popup <=> root.whatsapp-show-pairing-code-popup;
                    whatsapp-workspace-dir <=> root.whatsapp-workspace-dir;
                    whatsapp-resolved-workspace-dir-placeholder: root.whatsapp-resolved-workspace-dir-placeholder;
                    whatsapp-is-policy-covered: root.whatsapp-is-policy-covered;

                    // Bind WhatsApp callbacks
                    whatsapp-save-clicked(num, list) => { root.whatsapp-save-clicked(num, list); }
                    whatsapp-scan-qr-clicked() => { root.whatsapp-scan-qr-clicked(); }
                    whatsapp-add-allowlist(num) => { root.whatsapp-add-allowlist(num); }
                    whatsapp-remove-allowlist(idx) => { root.whatsapp-remove-allowlist(idx); }
                    whatsapp-close-qr-popup() => { root.whatsapp-close-qr-popup(); }
                    whatsapp-pair-account-clicked() => { root.whatsapp-pair-account-clicked(); }
                    whatsapp-generate-pairing-code-clicked() => { root.whatsapp-generate-pairing-code-clicked(); }
                    whatsapp-browse-workspace-dir-clicked() => { root.whatsapp-browse-workspace-dir-clicked(); }
                    whatsapp-close-pairing-code-popup() => { root.whatsapp-close-pairing-code-popup(); }

                    // Bind Telegram configuration properties
                    telegram-bot-token <=> root.telegram-bot-token;
                    telegram-owner-chat-id <=> root.telegram-owner-chat-id;
                    telegram-allowlist <=> root.telegram-allowlist;
                    telegram-connection-status <=> root.telegram-connection-status;
                    telegram-workspace-dir <=> root.telegram-workspace-dir;
                    telegram-resolved-workspace-dir-placeholder: root.telegram-resolved-workspace-dir-placeholder;
                    telegram-is-policy-covered: root.telegram-is-policy-covered;
                    telegram-test-status-message <=> root.telegram-test-status-message;

                    // Bind Telegram callbacks
                    telegram-save-clicked(token, owner-id, list) => { root.telegram-save-clicked(token, owner-id, list); }
                    telegram-test-connection-clicked() => { root.telegram-test-connection-clicked(); }
                    telegram-add-allowlist(num) => { root.telegram-add-allowlist(num); }
                    telegram-remove-allowlist(idx) => { root.telegram-remove-allowlist(idx); }
                    telegram-browse-workspace-dir-clicked() => { root.telegram-browse-workspace-dir-clicked(); }
                    
                    github_requested => { root.github_requested(); }
                    documentation_requested => { root.documentation_requested(); }
                    report_issue_requested => { root.report_issue_requested(); }
                }
            }
        }
    }
}
