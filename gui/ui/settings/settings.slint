// Settings window component for the Operon GUI.
//
// This component represents the separate settings window that is spawned
// when the user clicks the Settings button in the sidebar.
//
// It uses a custom borderless design with the custom Titlebar component.

import { Tokens } from "../shared/tokens.slint";
import { Titlebar } from "../window/titlebar.slint";

// Import Sidebar and Settings main content viewport
import { SettingsSidebar } from "./left-sidebar/sidebar.slint";
import { SettingsMainContent } from "./main-content/main-content.slint";
import { ProviderSummary } from "./main-content/models/providers.slint";

export component SettingsWindow inherits Window {
    // Falls back to a comfortable centered size for settings page
    preferred-width: 680px;
    preferred-height: 480px;
    min-width: 500px;
    min-height: 350px;
    
    // Borderless frame styling
    no-frame: true;
    resize-border-width: Tokens.window_resize_border_width;
    
    title: "Settings";
    icon: @image-url("../../assets/brand/operon.svg");
    background: Tokens.window_background;
    default-font-family: Tokens.font_family;

    // Window state properties
    in-out property <bool> window_maximized: false;
    in-out property <float> ui_scale: 1.0;
    // Current visibility state of the left sidebar (within settings - can default to true)
    in-out property <bool> sidebar_open: true;
    
    // Selected category index (0 = general, 1 = appearance, 2 = models, etc.)
    in-out property <int> active-category: 2; // Default to 'models' (idx 2) to match tauri

    // Callbacks
    callback minimize_requested();
    callback maximize_requested();
    callback close_window_requested();
    callback drag_window_requested();
    callback sidebar_toggle_requested();
    callback github_requested();
    callback documentation_requested();
    callback report_issue_requested();

    // Models configuration properties forwarded to viewport
    in property <[ProviderSummary]> providers: [];
    in-out property <string> selected-provider-id: "";
    in-out property <string> selected-provider-label: "";
    in-out property <string> api-base-url: "";
    in-out property <string> api-key: "";
    in-out property <string> active-model: "";
    in-out property <[string]> provider-models: [];
    in-out property <int> models-active-view: 0;

    // Models callbacks forwarded to viewport
    callback provider-selected(string, string);
    callback provider-save-clicked(string, string, string, string);
    callback provider-reload-clicked(string, string, string);

    // Main layout container: Titlebar on top, body content below
    VerticalLayout {
        spacing: 0px;
        
        // 1. Custom Titlebar (no menus, no navigation, but keeps logo/toggle and minimize/maximize/close actions)
        titlebar := Titlebar {
            width: 100%;
            height: Tokens.titlebar_height;
            is_maximized: root.window_maximized;
            ui_scale: root.ui_scale;
            sidebar_open: root.sidebar_open;
            
            // Hide navigation controls and dropdown menus
            show_navigation: false;
            show_menus: false;

            sidebar_toggle_requested => {
                root.sidebar_open = titlebar.sidebar_open;
                root.sidebar_toggle_requested();
            }

            minimize_requested => { root.minimize_requested(); }
            maximize_requested => { root.maximize_requested(); }
            close_window_requested => { root.close_window_requested(); }
            drag_window_requested => { root.drag_window_requested(); }
        }

        // 2. Settings Content Area
        body := Rectangle {
            vertical-stretch: 1;
            background: transparent;

            HorizontalLayout {
                spacing: 0px;
                
                // Left settings category navigation sidebar (absolute black background)
                sidebar := SettingsSidebar {
                    active-category <=> root.active-category;
                    width: root.sidebar_open ? 200px : 0px;
                    visible: root.sidebar_open;
                }
                
                // Main settings content viewport (same background color as main app sidebar)
                main-content := SettingsMainContent {
                    horizontal-stretch: 1;
                    active-category: root.active-category;

                    // Bind models configuration properties
                    providers: root.providers;
                    selected-provider-id <=> root.selected-provider-id;
                    selected-provider-label <=> root.selected-provider-label;
                    api-base-url <=> root.api-base-url;
                    api-key <=> root.api-key;
                    active-model <=> root.active-model;
                    provider-models <=> root.provider-models;
                    models-active-view <=> root.models-active-view;

                    // Bind models callbacks
                    provider-selected(id, label) => { root.provider-selected(id, label); }
                    provider-save-clicked(id, base-url, api-key, active-model) => {
                        root.provider-save-clicked(id, base-url, api-key, active-model);
                    }
                    provider-reload-clicked(id, base-url, api-key) => {
                        root.provider-reload-clicked(id, base-url, api-key);
                    }
                    
                    github_requested => { root.github_requested(); }
                    documentation_requested => { root.documentation_requested(); }
                    report_issue_requested => { root.report_issue_requested(); }
                }
            }
        }
    }
}
