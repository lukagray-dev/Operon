// Sidebar component for the settings panel.
//
// This component displays a list of settings categories on the left side
// of the settings dialog. It tracks selection state and highlights the
// currently active category.

import { Tokens } from "../../shared/tokens.slint";

export component SettingsNavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> is-active: false;
    
    callback clicked();
    
    height: 34px;
    border-radius: 6px;
    
    // Background changes based on active or hover states (matching tauri CSS variables)
    background: root.is-active 
        ? rgba(255, 255, 255, 0.08) 
        : (touch-area.has-hover ? rgba(255, 255, 255, 0.05) : transparent);
        
    animate background { duration: 150ms; }
    
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;
        
        // Centered icon wrapper
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.is-active 
                    ? #e8e8e8 
                    : (touch-area.has-hover ? #bbbbbb : #555555);
                    
                animate colorize { duration: 150ms; }
            }
        }
        
        // Label text
        Text {
            text: root.text;
            color: root.is-active 
                ? #e8e8e8 
                : (touch-area.has-hover ? #bbbbbb : #555555);
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            
            animate color { duration: 150ms; }
        }
    }
    
    touch-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsSidebar inherits Rectangle {
    // Current category selection index
    in-out property <int> active-category: 2; // Default to 'models' (idx 2) to match tauri setting activeCategory = 'models'
    
    callback category-changed(int);
    
    width: 200px;
    background: #000000; // Absolute black background as per tauri spec
    
    // Separator line on the right edge
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: #1c1c1c; // Subtle border separating sidebar from content
    }

    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        alignment: start;
        
        // General
        SettingsNavItem {
            text: "General";
            icon: @image-url("../../../assets/icons/settings/category-general.svg");
            is-active: root.active-category == 0;
            clicked => {
                root.active-category = 0;
                root.category-changed(0);
            }
        }
        
        // Appearance
        SettingsNavItem {
            text: "Appearance";
            icon: @image-url("../../../assets/icons/settings/category-appearance.svg");
            is-active: root.active-category == 1;
            clicked => {
                root.active-category = 1;
                root.category-changed(1);
            }
        }
        
        // Models
        SettingsNavItem {
            text: "Models";
            icon: @image-url("../../../assets/icons/settings/category-models.svg");
            is-active: root.active-category == 2;
            clicked => {
                root.active-category = 2;
                root.category-changed(2);
            }
        }
        
        // Channels
        SettingsNavItem {
            text: "Channels";
            icon: @image-url("../../../assets/icons/settings/category-channels.svg");
            is-active: root.active-category == 3;
            clicked => {
                root.active-category = 3;
                root.category-changed(3);
            }
        }
        
        // Permissions
        SettingsNavItem {
            text: "Permissions";
            icon: @image-url("../../../assets/icons/settings/category-permissions.svg");
            is-active: root.active-category == 4;
            clicked => {
                root.active-category = 4;
                root.category-changed(4);
            }
        }
        
        // Skills
        SettingsNavItem {
            text: "Skills";
            icon: @image-url("../../../assets/icons/settings/category-skills.svg");
            is-active: root.active-category == 5;
            clicked => {
                root.active-category = 5;
                root.category-changed(5);
            }
        }
        
        // Extensions
        SettingsNavItem {
            text: "Extensions";
            icon: @image-url("../../../assets/icons/settings/category-extensions.svg");
            is-active: root.active-category == 6;
            clicked => {
                root.active-category = 6;
                root.category-changed(6);
            }
        }
        
        // About
        SettingsNavItem {
            text: "About";
            icon: @image-url("../../../assets/icons/settings/category-about.svg");
            is-active: root.active-category == 7;
            clicked => {
                root.active-category = 7;
                root.category-changed(7);
            }
        }
    }
}
