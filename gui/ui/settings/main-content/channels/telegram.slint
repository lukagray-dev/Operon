// telegram.slint — Telegram channel setup view component.
import { Tokens } from "../../../shared/tokens.slint";
import { ScrollView } from "std-widgets.slint";

component InputField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    clip: true;

    callback edited(string);

    height: 32px;
    background: #0d0d0d;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        input := TextInput {
            font-size: Tokens.body_font_size - 1px;
            font-family: Tokens.font_family;
            color: Tokens.text_primary;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
        }
    }

    if (input.text == "") : Text {
        x: 8px;
        text: root.placeholder;
        color: Tokens.text_muted;
        font-size: Tokens.body_font_size - 1px;
        font-family: Tokens.font_family;
        vertical-alignment: center;
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;

    HorizontalLayout {
        spacing: 16px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.label;
                color: #e8e8e8;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
            }

            Text {
                text: root.subtitle;
                color: Tokens.text_muted;
                font-size: Tokens.body_font_size - 3px;
            }
        }

        VerticalLayout {
            width: 280px;
            alignment: center;
            @children
        }
    }
}

export component TelegramSetup inherits Rectangle {
    background: transparent;

    in property <string> connection-status: "Disconnected"; // "Connected", "Connecting", "Disconnected", or "Error: ..."
    in-out property <string> bot-token: "";
    in-out property <string> owner-chat-id: "";
    in-out property <[string]> allowlist: [];
    in-out property <string> new-allowlist-id: "";
    in-out property <string> workspace-dir: "";
    in property <string> resolved-workspace-dir-placeholder: "";
    in property <bool> is-policy-covered: false;
    in property <string> test-status-message: "";

    callback back-clicked();
    callback save-clicked();
    callback test-connection-clicked();
    callback add-allowlist-number(string);
    callback remove-allowlist-number(int);
    callback browse-workspace-dir-clicked();

    VerticalLayout {
        spacing: 16px;

        // 1. Navigation Header
        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 60px;
                height: 28px;
                border-radius: 6px;
                background: back_touch.has-hover ? #242424 : #1a1a1a;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.08);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;

                    Text {
                        text: "Back";
                        color: back_touch.has-hover ? #e0e0e0 : #888888;
                        font-size: Tokens.body_font_size - 2px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                back_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.back-clicked(); }
                }
            }

            Text {
                text: "Telegram Bot Setup";
                color: #e8e8e8;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                vertical-alignment: center;
            }

            // Connection Badge
            Rectangle {
                border-radius: 4px;
                background: root.connection-status == "Connected" 
                    ? rgba(46, 204, 113, 0.15) 
                    : rgba(231, 76, 60, 0.15);
                border-width: 1px;
                border-color: root.connection-status == "Connected" 
                    ? rgba(46, 204, 113, 0.4) 
                    : rgba(231, 76, 60, 0.4);

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 2px;
                    padding-bottom: 2px;

                    Text {
                        text: root.connection-status;
                        color: root.connection-status == "Connected" ? #2ecc71 : #e74c3c;
                        font-size: Tokens.body_font_size - 3px;
                        font-weight: 700;
                    }
                }
            }
        }

        // 2. Bot Token Row
        SettingRow {
            label: "Bot Token";
            subtitle: "Bot authentication token obtained from @BotFather on Telegram";

            InputField {
                placeholder: "123456789:AAH...";
                text <=> root.bot-token;
            }
        }

        // 3. Owner Chat ID Row
        SettingRow {
            label: "Owner Chat ID";
            subtitle: "Main owner Telegram chat ID (get via @userinfobot)";

            InputField {
                placeholder: "123456789";
                text <=> root.owner-chat-id;
            }
        }

        // 4. Workspace Directory Row
        SettingRow {
            label: "Workspace Directory";
            subtitle: "Shared workspace root directory for Telegram session tool calls";

            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;

                    InputField {
                        horizontal-stretch: 1;
                        placeholder: root.resolved-workspace-dir-placeholder;
                        text <=> root.workspace-dir;
                    }

                    // Folder Browse Button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: browse_touch.has-hover ? #242424 : #1a1a1a;
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.08);

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../../../assets/icons/sidebar/folder.svg");
                            width: 14px;
                            height: 14px;
                            colorize: browse_touch.has-hover ? #e0e0e0 : #888888;
                        }

                        browse_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.browse-workspace-dir-clicked(); }
                        }
                    }
                }

                // Inline Policy Coverage Indicator
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        border-radius: 4px;
                        background: root.is-policy-covered
                            ? rgba(46, 204, 113, 0.15)
                            : rgba(230, 126, 34, 0.15);
                        border-width: 1px;
                        border-color: root.is-policy-covered
                            ? rgba(46, 204, 113, 0.4)
                            : rgba(230, 126, 34, 0.4);

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            padding-top: 2px;
                            padding-bottom: 2px;

                            Text {
                                text: root.is-policy-covered
                                    ? "✓ Policy Covered"
                                    : "⚠️ Uncovered by Policy (Tool calls will Deny)";
                                color: root.is-policy-covered ? #2ecc71 : #e67e22;
                                font-size: Tokens.body_font_size - 3px;
                                font-weight: 600;
                            }
                        }
                    }
                }
            }
        }

        // 5. Allowlist Chat IDs Row
        SettingRow {
            label: "Allowlist Chat IDs";
            subtitle: "Telegram chat IDs granted Owner permissions (Full administrative access)";

            VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;

                    InputField {
                        horizontal-stretch: 1;
                        placeholder: "987654321";
                        text <=> root.new-allowlist-id;
                    }

                    Rectangle {
                        width: 50px;
                        height: 32px;
                        border-radius: 6px;
                        background: add_touch.has-hover ? #2ecc71 : #27ae60;

                        HorizontalLayout {
                            alignment: center;
                            Text {
                                text: "Add";
                                color: #ffffff;
                                font-size: Tokens.body_font_size - 2px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        add_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.new-allowlist-id != "") {
                                    root.add-allowlist-number(root.new-allowlist-id);
                                    root.new-allowlist-id = "";
                                }
                            }
                        }
                    }
                }

                // Allowlist items
                Rectangle {
                    height: 100px;
                    background: #0d0d0d;
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.08);
                    border-radius: 6px;

                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 4px;

                            for id_item[idx] in root.allowlist : Rectangle {
                                height: 28px;
                                background: #1a1a1a;
                                border-radius: 4px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;

                                    Text {
                                        text: id_item;
                                        color: #e8e8e8;
                                        font-size: Tokens.body_font_size - 2px;
                                        font-family: Tokens.mono_font_family;
                                        vertical-alignment: center;
                                    }

                                    // Trash Icon to remove allowlist ID
                                    Image {
                                        source: @image-url("../../../../assets/icons/sidebar/trash.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: del_touch.has-hover ? #e74c3c : #888888;
                                        y: (parent.height - self.height) / 2;

                                        del_touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.remove-allowlist-number(idx);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Inline status test result message if present
        if root.test-status-message != "" : Text {
            text: root.test-status-message;
            color: #3498db;
            font-size: Tokens.body_font_size - 2px;
            font-weight: 600;
        }

        // 6. Actions Row
        HorizontalLayout {
            spacing: 12px;
            alignment: end;

            // Test Connection Button
            Rectangle {
                width: 145px;
                height: 32px;
                border-radius: 6px;
                background: test_touch.has-hover ? #2980b9 : #3498db;

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Test Connection";
                        color: #ffffff;
                        font-size: Tokens.body_font_size - 2px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                test_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.test-connection-clicked(); }
                }
            }

            // Save & Connect Button
            Rectangle {
                width: 130px;
                height: 32px;
                border-radius: 6px;
                background: save_touch.has-hover ? #2ecc71 : #27ae60;

                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: "Save & Connect";
                        color: #ffffff;
                        font-size: Tokens.body_font_size - 2px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                save_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.save-clicked(); }
                }
            }
        }
    }
}
