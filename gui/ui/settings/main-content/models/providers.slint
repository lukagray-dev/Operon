// Providers List view component for the Models page.
import { Tokens } from "../../../shared/tokens.slint";

export struct ProviderSummary {
    id: string,
    label: string,
    status: string,
    active-model: string,
    is-active: bool,
    icon: image,
}

component ProviderCard inherits Rectangle {
    in property <ProviderSummary> provider;
    
    callback clicked();
    
    height: 58px;
    background: touch_area.has-hover ? #1a1a1a : #0d0d0d;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    
    animate background { duration: 150ms; }
    
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        
        // 1. Icon (centered vertically)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                background: rgba(255, 255, 255, 0.03);
                border-radius: 6px;
                
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.provider.icon;
                    width: 18px;
                    height: 18px;
                }
            }
        }
        
        // 2. Info details
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            
            Text {
                text: root.provider.label;
                color: #e8e8e8;
                font-size: Tokens.body_font_size;
                font-weight: 600;
            }
            
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                
                Text {
                    text: root.provider.status;
                    color: root.provider.status == "Configured" ? #888888 : #555555;
                    font-size: Tokens.body_font_size - 3px;
                    font-weight: 500;
                }
                
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 3px;
                        height: 3px;
                        background: #333333;
                        border-radius: 1.5px;
                    }
                }
                
                Text {
                    text: root.provider.active-model;
                    color: #888888;
                    font-size: Tokens.body_font_size - 3px;
                    font-family: Tokens.mono_font_family;
                }
            }
        }
        
        // 3. Status Badge / Navigation Arrow
        VerticalLayout {
            alignment: center;
            
            if (root.provider.is-active) : Rectangle {
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.15);
                border-radius: 4px;
                background: rgba(255, 255, 255, 0.04);
                
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    
                    Text {
                        text: "Active";
                        color: #e8e8e8;
                        font-size: Tokens.body_font_size - 3px;
                        font-weight: 700;
                    }
                }
            }
            
            if (!root.provider.is-active) : Image {
                source: @image-url("../../../../assets/icons/settings/chevron-right.svg");
                width: 12px;
                height: 12px;
                colorize: touch_area.has-hover ? #e0e0e0 : #555555;
                animate colorize { duration: 150ms; }
            }
        }
    }
    
    touch_area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

