// About settings category page for the Operon GUI.
import { Tokens } from "../../shared/tokens.slint";

component AboutLinkButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    
    callback clicked();
    
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    background: touch_area.has-hover ? #242424 : #1a1a1a;
    
    animate background { duration: 150ms; }
    
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 8px;
        alignment: center;
        
        Image {
            source: root.icon;
            width: 14px;
            height: 14px;
            colorize: touch_area.has-hover ? #e0e0e0 : #aaaaaa;
            animate colorize { duration: 150ms; }
        }
        
        Text {
            text: root.text;
            color: touch_area.has-hover ? #e0e0e0 : #aaaaaa;
            font-size: Tokens.body_font_size;
            font-weight: 500;
            animate color { duration: 150ms; }
        }
    }
    
    touch_area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component AboutGridRow inherits Rectangle {
    in property <string> key;
    in property <string> value;
    
    height: 36px;
    background: #0d0d0d;
    
    HorizontalLayout {
        spacing: 0px;
        
        // Key column
        Rectangle {
            width: 160px;
            
            HorizontalLayout {
                padding-left: 14px;
                alignment: start;
                
                Text {
                    text: root.key;
                    color: #888888;
                    font-size: Tokens.body_font_size - 1px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        
        // Vertical divider inside the row
        Rectangle {
            width: 1px;
            background: rgba(255, 255, 255, 0.05);
        }
        
        // Value column
        Rectangle {
            horizontal-stretch: 1;
            
            HorizontalLayout {
                padding-left: 14px;
                alignment: start;
                
                Text {
                    text: root.value;
                    color: #c0c0c0;
                    font-size: Tokens.body_font_size - 1px;
                    font-family: Tokens.mono_font_family;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AboutSettings inherits Rectangle {
    background: transparent;
    
    // Callbacks to forward click events to the window controller
    callback github_requested();
    callback documentation_requested();
    callback report_issue_requested();
    
    Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: main_layout.preferred-height;
        
        main_layout := VerticalLayout {
            padding: 24px;
            spacing: 20px;
            alignment: start;
            
            // 1. Page Header (Icon + Title)
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                
                Image {
                    source: @image-url("../../../assets/icons/settings/category-about.svg");
                    width: 20px;
                    height: 20px;
                }
                
                Text {
                    text: "About Operon";
                    color: Tokens.text_primary;
                    font-size: Tokens.body_font_size + 4px;
                    font-weight: 600;
                }
            }
            
            // 2. Hero Card: branding logo and name
            Rectangle {
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                border-radius: 10px;
                background: #0d0d0d;
                
                VerticalLayout {
                    padding-top: 32px;
                    padding-bottom: 32px;
                    spacing: 12px;
                    alignment: center;
                    
                    // Centered logo container without background
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../assets/icons/settings/category-about.svg");
                            width: 48px;
                            height: 48px;
                        }
                    }
                    
                    Text {
                        text: "Operon";
                        color: #e8e8e8;
                        font-size: 22px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    
                    Text {
                        text: "Version 0.1.0";
                        color: #555555;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
            }
            
            // 3. Technical Specifications Grid
            Rectangle {
                border-radius: 8px;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.05);
                background: rgba(255, 255, 255, 0.05);
                clip: true; // clip round corners
                
                VerticalLayout {
                    spacing: 1px; // visually acts as divider border between rows
                    
                    AboutGridRow {
                        key: "Version";
                        value: "0.1.0";
                    }
                    AboutGridRow {
                        key: "Platform";
                        value: "Windows 10/11";
                    }
                    AboutGridRow {
                        key: "Architecture";
                        value: "x86_64";
                    }
                    AboutGridRow {
                        key: "UI Toolkit";
                        value: "Slint 1.16";
                    }
                    AboutGridRow {
                        key: "Compiler";
                        value: "Rustc 1.78+";
                    }
                }
            }
            
            // 4. External Links Button Row
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                
                AboutLinkButton {
                    text: "GitHub";
                    icon: @image-url("../../../assets/icons/settings/github.svg");
                    clicked => { root.github_requested(); }
                }
                AboutLinkButton {
                    text: "Documentation";
                    icon: @image-url("../../../assets/icons/settings/about-documentation.svg");
                    clicked => { root.documentation_requested(); }
                }
                AboutLinkButton {
                    text: "Report Issue";
                    icon: @image-url("../../../assets/icons/settings/about-report-issue.svg");
                    clicked => { root.report_issue_requested(); }
                }
            }
        }
    }
}
