// Models settings category page coordinating list and setup views.
import { Tokens } from "../../shared/tokens.slint";
import { ScrollView } from "std-widgets.slint";
import { ProvidersList, ProviderSummary } from "./models/providers.slint";
import { ProviderSetup } from "./models/setup.slint";

export component ModelsSettings inherits Rectangle {
    background: transparent;
    
    // View state tracking: 0 = Providers List, 1 = Provider Setup
    in-out property <int> active-view: 0;
    
    // Selection state
    in-out property <string> selected-provider-id: "";
    in-out property <string> selected-provider-label: "";
    
    // Input state
    in-out property <string> api-base-url: "";
    in-out property <string> api-key: "";
    in-out property <string> active-model: "";
    
    // Dynamic models list based on selection
    in-out property <[string]> provider-models: [];

    // Providers list from Rust
    in property <[ProviderSummary]> providers;

    // Callbacks to forward events to the Rust controller
    callback provider-selected(string, string);
    callback save-clicked(string, string, string, string);
    callback reload-clicked(string, string, string);
    
    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        
        main_layout := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;
            
            // 1. Page Header (Icon + Title)
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                
                Image {
                    source: @image-url("../../../assets/icons/settings/category-models.svg");
                    width: 20px;
                    height: 20px;
                    colorize: Tokens.text_primary;
                }
                
                Text {
                    text: root.active-view == 0 
                        ? "Models Settings" 
                        : "Models Settings | " + root.selected-provider-label;
                    color: Tokens.text_primary;
                    font-size: Tokens.body_font_size + 4px;
                    font-weight: 600;
                }
            }
            
            // Subtitle
            Text {
                text: root.active-view == 0 
                    ? "Configure AI models, API keys, endpoints, and provider preferences."
                    : "Configure API credentials, discover available models, and save selections.";
                color: Tokens.text_muted;
                font-size: Tokens.body_font_size;
                wrap: TextWrap.word-wrap;
            }
            
            // Separator
            Rectangle {
                height: 1px;
                background: rgba(255, 255, 255, 0.05);
            }
            
            // 2. View Switching
            if (root.active-view == 0) : ProvidersList {
                providers: root.providers;
                provider-selected(id, label) => {
                    root.provider-selected(id, label);
                }
            }
            
            if (root.active-view == 1) : ProviderSetup {
                provider-id: root.selected-provider-id;
                provider-label: root.selected-provider-label;
                api-base-url <=> root.api-base-url;
                api-key <=> root.api-key;
                active-model <=> root.active-model;
                discovered-models: root.provider-models;
                
                back-clicked => {
                    root.active-view = 0;
                }
                save-clicked => {
                    root.save-clicked(root.selected-provider-id, root.api-base-url, root.api-key, root.active-model);
                }
                reload-clicked => {
                    root.reload-clicked(root.selected-provider-id, root.api-base-url, root.api-key);
                }
            }
        }
    }
}
