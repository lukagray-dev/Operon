// Appearance Settings category page for the Operon GUI.
//
// Hey friend! This component defines the complete Appearance Settings panel.
// It organizes visual customization preferences into 3 clear sections:
// 1. Theme & Color Palette (4 side-by-side live syntax code preview cards)
// 2. UI Scale & Density (UI scaling preset buttons, compact mode, smooth animations)
// 3. Typography & Code Styling (UI font family, code font family, cursor blink toggle)

import { Tokens } from "../../shared/tokens.slint";
import { ToggleSwitch } from "../../shared/toggle.slint";
import { ScrollView } from "std-widgets.slint";

// Segmented 3-option selector for Theme Modes or Font choices
component SegmentedChoice3 inherits Rectangle {
    in property <string> option1: "Opt 1";
    in property <string> option2: "Opt 2";
    in property <string> option3: "Opt 3";
    in-out property <int> selected-index: 0;
    
    callback selected-changed(int);
    
    height: 30px;
    background: #0d0d0d;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    
    HorizontalLayout {
        spacing: 0px;
        padding: 2px;
        
        // Option 1
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 0 ? rgba(255, 255, 255, 0.12) : transparent;
            
            Text {
                text: root.option1;
                color: root.selected-index == 0 ? #ffffff : #777777;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 0;
                    root.selected-changed(0);
                }
            }
        }
        
        // Option 2
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 1 ? rgba(255, 255, 255, 0.12) : transparent;
            
            Text {
                text: root.option2;
                color: root.selected-index == 1 ? #ffffff : #777777;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 1;
                    root.selected-changed(1);
                }
            }
        }

        // Option 3
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 2 ? rgba(255, 255, 255, 0.12) : transparent;
            
            Text {
                text: root.option3;
                color: root.selected-index == 2 ? #ffffff : #777777;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 2;
                    root.selected-changed(2);
                }
            }
        }
    }
}

// Segmented 5-option selector for UI Scale Levels (80%, 100%, 120%, 140%, 160%)
component UiScaleSelector inherits Rectangle {
    in-out property <int> selected-index: 1; // 0=80%, 1=100%, 2=120%, 3=140%, 4=160%
    callback scale-changed(int);
    
    height: 30px;
    width: 250px;
    background: #0d0d0d;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;

    HorizontalLayout {
        spacing: 0px;
        padding: 2px;

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 0 ? rgba(255, 255, 255, 0.12) : transparent;
            Text {
                text: "80%";
                color: root.selected-index == 0 ? #ffffff : #666666;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected-index = 0; root.scale-changed(0); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 1 ? rgba(255, 255, 255, 0.12) : transparent;
            Text {
                text: "100%";
                color: root.selected-index == 1 ? #ffffff : #666666;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected-index = 1; root.scale-changed(1); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 2 ? rgba(255, 255, 255, 0.12) : transparent;
            Text {
                text: "120%";
                color: root.selected-index == 2 ? #ffffff : #666666;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected-index = 2; root.scale-changed(2); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 3 ? rgba(255, 255, 255, 0.12) : transparent;
            Text {
                text: "140%";
                color: root.selected-index == 3 ? #ffffff : #666666;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected-index = 3; root.scale-changed(3); }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 4 ? rgba(255, 255, 255, 0.12) : transparent;
            Text {
                text: "160%";
                color: root.selected-index == 4 ? #ffffff : #666666;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected-index = 4; root.scale-changed(4); }
            }
        }
    }
}

// Side-by-side Theme Preview Card Component with real-time syntax code preview
component ThemeCardPreview inherits Rectangle {
    in property <int> theme-index: 0; // 0=Operon Dark, 1=One Dark, 2=Monokai, 3=Nord
    in property <string> theme-name: "Operon Dark";
    in property <bool> is-selected: false;
    callback clicked();

    // Theme specific syntax color palette tokens
    property <color> bg-color: root.theme-index == 0 ? #0a0a0a : (root.theme-index == 1 ? #1e1e1e : (root.theme-index == 2 ? #272822 : #2e3440));
    property <color> header-bg: root.theme-index == 0 ? #141414 : (root.theme-index == 1 ? #252526 : (root.theme-index == 2 ? #1e1e1c : #3b4252));
    property <color> box-border-color: root.is-selected ? #ffffff : (root.theme-index == 0 ? #2a2a2a : (root.theme-index == 1 ? #333333 : (root.theme-index == 2 ? #49483e : #434c5e)));
    property <color> gutter-color: root.theme-index == 0 ? #555555 : (root.theme-index == 1 ? #5c6370 : (root.theme-index == 2 ? #75715e : #4c566a));
    property <color> keyword-color: root.theme-index == 0 ? #c678dd : (root.theme-index == 1 ? #c678dd : (root.theme-index == 2 ? #f92672 : #81a1c1));
    property <color> type-color: root.theme-index == 0 ? #e5c07b : (root.theme-index == 1 ? #e5c07b : (root.theme-index == 2 ? #66d9ef : #8fbcbb));
    property <color> prop-color: root.theme-index == 0 ? #d19a66 : (root.theme-index == 1 ? #e06c75 : (root.theme-index == 2 ? #fd971f : #88c0d0));
    property <color> string-color: root.theme-index == 0 ? #98c379 : (root.theme-index == 1 ? #98c379 : (root.theme-index == 2 ? #a6e22e : #a3be8c));
    property <color> number-color: root.theme-index == 0 ? #61afef : (root.theme-index == 1 ? #d19a66 : (root.theme-index == 2 ? #ae81ff : #b48ead));
    property <color> punct-color: root.theme-index == 0 ? #abb2bf : (root.theme-index == 1 ? #abb2bf : (root.theme-index == 2 ? #f8f8f2 : #d8dee9));
    property <color> highlight-line-bg: root.theme-index == 0 ? rgba(255, 255, 255, 0.04) : (root.theme-index == 1 ? rgba(255, 255, 255, 0.05) : (root.theme-index == 2 ? rgba(255, 255, 255, 0.06) : rgba(255, 255, 255, 0.06)));

    background: root.bg-color;
    border-width: root.is-selected ? 2px : 1px;
    border-color: root.box-border-color;
    border-radius: 8px;

    animate border-color { duration: 150ms; easing: ease-in-out; }

    VerticalLayout {
        spacing: 0px;

        // Card Header Bar with Theme Title & Active Check Badge
        Rectangle {
            height: 28px;
            background: root.header-bg;
            border-top-left-radius: 7px;
            border-top-right-radius: 7px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;

                Text {
                    text: root.theme-name;
                    color: root.is-selected ? #ffffff : Tokens.text_secondary;
                    font-size: Tokens.body_font_size - 2px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                // Selection active checkmark badge (vertically centered in header)
                if (root.is-selected) : Rectangle {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: #ffffff;

                    Image {
                        source: @image-url("../../../assets/icons/settings/check.svg");
                        width: 10px;
                        height: 10px;
                        colorize: #000000;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Live Code Syntax Highlighted Snippet Container
        Rectangle {
            height: 100px;
            background: transparent;

            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;

                // Line 1: const themePreview = {
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "1"; color: root.gutter-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; width: 10px; horizontal-alignment: right; }
                    HorizontalLayout {
                        spacing: 0px;
                        Text { text: "const "; color: root.keyword-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                        Text { text: "themePreview"; color: root.prop-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                        Text { text: " = {"; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                    }
                }

                // Line 2:   surface: "sidebar", (with line highlight tint)
                Rectangle {
                    background: root.highlight-line-bg;
                    border-radius: 2px;
                    height: 16px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text { text: "2"; color: root.gutter-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; width: 10px; horizontal-alignment: right; }
                        HorizontalLayout {
                            spacing: 0px;
                            Text { text: "  surface"; color: root.prop-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: ": "; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: "\"sidebar\""; color: root.string-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: ","; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                        }
                    }
                }

                // Line 3:   accent: "#2563eb",
                Rectangle {
                    background: root.highlight-line-bg;
                    border-radius: 2px;
                    height: 16px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text { text: "3"; color: root.gutter-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; width: 10px; horizontal-alignment: right; }
                        HorizontalLayout {
                            spacing: 0px;
                            Text { text: "  accent"; color: root.prop-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: ": "; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: "\"#2563eb\""; color: root.string-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: ","; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                        }
                    }
                }

                // Line 4:   contrast: 42,
                Rectangle {
                    background: root.highlight-line-bg;
                    border-radius: 2px;
                    height: 16px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text { text: "4"; color: root.gutter-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; width: 10px; horizontal-alignment: right; }
                        HorizontalLayout {
                            spacing: 0px;
                            Text { text: "  contrast"; color: root.prop-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: ": "; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: "42"; color: root.number-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                            Text { text: ","; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                        }
                    }
                }

                // Line 5: };
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "5"; color: root.gutter-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; width: 10px; horizontal-alignment: right; }
                    Text { text: "};"; color: root.punct-color; font-size: Tokens.body_font_size - 2px; font-family: Tokens.mono_font_family; }
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppearanceSettings inherits Rectangle {
    background: transparent;

    // ── Theme & Color Palette Properties ──
    in-out property <int> selected-theme-mode: 0; // 0 = Dark Immersive, 1 = OLED Pitch Black, 2 = Dimmed Gray
    in-out property <int> selected-syntax-theme: 0; // 0 = Operon Dark, 1 = One Dark, 2 = Monokai Pro, 3 = Nord

    // ── UI Scale & Density Properties ──
    in-out property <int> ui-scale-index: 1; // 0=80%, 1=100%, 2=120%, 3=140%, 4=160%
    in-out property <bool> compact-mode-enabled: false;
    in-out property <bool> animations-enabled: true;

    // ── Typography & Code Styling Properties ──
    in-out property <int> selected-ui-font: 0; // 0 = Open Sans, 1 = Inter, 2 = Roboto
    in-out property <int> selected-assistant-font: 0; // 0 = Literata, 1 = Georgia, 2 = Merriweather
    in-out property <int> selected-code-font: 0; // 0 = Kode Mono, 1 = Fira Code, 2 = JetBrains Mono
    in-out property <bool> cursor-blink-enabled: true;

    // ── Interaction Callbacks ──
    callback theme-mode-changed(int);
    callback syntax-theme-changed(int);
    callback ui-scale-changed(int);
    callback compact-mode-toggled(bool);
    callback animations-toggled(bool);
    callback ui-font-changed(int);
    callback assistant-font-changed(int);
    callback code-font-changed(int);
    callback cursor-blink-toggled(bool);

    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 20px;
            alignment: start;

            // Header Banner
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Image {
                    source: @image-url("../../../assets/icons/settings/category-appearance.svg");
                    width: 22px;
                    height: 22px;
                    colorize: Tokens.text_primary;
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "Appearance Settings";
                        color: Tokens.text_primary;
                        font-size: Tokens.body_font_size + 4px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Customize application themes, scaling, message density, and code editor typography.";
                        color: Tokens.text_muted;
                        font-size: Tokens.body_font_size - 1px;
                        wrap: TextWrap.word-wrap;
                    }
                }
            }

            // ═════════════════════════════════════════════════════════════
            // SECTION 1: Theme & Color Palette Card with 4 Side-by-Side Theme Previews
            // ═════════════════════════════════════════════════════════════
            Rectangle {
                background: #161616;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Section Card Header
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Syntax Highlighting Themes";
                            color: Tokens.text_primary;
                            font-size: Tokens.body_font_size + 1px;
                            font-weight: 600;
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.05);
                    }

                    // 4 Side-by-Side Live Theme Code Preview Grid (2x2)
                    VerticalLayout {
                        spacing: 12px;

                        // Row 1: Operon Dark & One Dark Pro
                        HorizontalLayout {
                            spacing: 12px;

                            ThemeCardPreview {
                                horizontal-stretch: 1;
                                theme-index: 0;
                                theme-name: "Operon Dark";
                                is-selected: root.selected-syntax-theme == 0;
                                clicked => {
                                    root.selected-syntax-theme = 0;
                                    root.syntax-theme-changed(0);
                                }
                            }

                            ThemeCardPreview {
                                horizontal-stretch: 1;
                                theme-index: 1;
                                theme-name: "One Dark Pro";
                                is-selected: root.selected-syntax-theme == 1;
                                clicked => {
                                    root.selected-syntax-theme = 1;
                                    root.syntax-theme-changed(1);
                                }
                            }
                        }

                        // Row 2: Monokai Pro & Nord Theme
                        HorizontalLayout {
                            spacing: 12px;

                            ThemeCardPreview {
                                horizontal-stretch: 1;
                                theme-index: 2;
                                theme-name: "Monokai Pro";
                                is-selected: root.selected-syntax-theme == 2;
                                clicked => {
                                    root.selected-syntax-theme = 2;
                                    root.syntax-theme-changed(2);
                                }
                            }

                            ThemeCardPreview {
                                horizontal-stretch: 1;
                                theme-index: 3;
                                theme-name: "Nord Theme";
                                is-selected: root.selected-syntax-theme == 3;
                                clicked => {
                                    root.selected-syntax-theme = 3;
                                    root.syntax-theme-changed(3);
                                }
                            }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 2: Interface Theme Mode
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Interface Theme Mode";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Base application shell background and visual tone";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        SegmentedChoice3 {
                            width: 270px;
                            option1: "Dark Default";
                            option2: "OLED Black";
                            option3: "Dimmed Gray";
                            selected-index <=> root.selected-theme-mode;
                            selected-changed(idx) => { root.theme-mode-changed(idx); }
                        }
                    }
                }
            }

            // ═════════════════════════════════════════════════════════════
            // SECTION 2: UI Scale & Density Card
            // ═════════════════════════════════════════════════════════════
            Rectangle {
                background: #161616;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Section Card Header
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "UI Scale & Density";
                            color: Tokens.text_primary;
                            font-size: Tokens.body_font_size + 1px;
                            font-weight: 600;
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.05);
                    }

                    // Row 1: UI Scaling Level
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "UI Scaling Level";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Global zoom level for text, icons, and interface components";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        UiScaleSelector {
                            selected-index <=> root.ui-scale-index;
                            scale-changed(idx) => { root.ui-scale-changed(idx); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 2: Compact Layout Mode
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Compact Message Spacing";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Reduce padding between chat messages and sidebar items to display more content";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.compact-mode-enabled;
                            toggled(checked) => { root.compact-mode-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 3: Smooth UI Animations
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Smooth Interface Animations";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Enable smooth panel transitions, hover effects, and micro-animations";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.animations-enabled;
                            toggled(checked) => { root.animations-toggled(checked); }
                        }
                    }
                }
            }

            // ═════════════════════════════════════════════════════════════
            // SECTION 3: Typography & Code Styling Card
            // ═════════════════════════════════════════════════════════════
            Rectangle {
                background: #161616;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Section Card Header
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Typography & Code Styling";
                            color: Tokens.text_primary;
                            font-size: Tokens.body_font_size + 1px;
                            font-weight: 600;
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.05);
                    }

                    // Row 1: Primary UI Font
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Primary Interface Font";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Sans-serif font family used for UI chrome, menus, and labels";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        SegmentedChoice3 {
                            width: 270px;
                            option1: "Open Sans";
                            option2: "Inter";
                            option3: "Roboto";
                            selected-index <=> root.selected-ui-font;
                            selected-changed(idx) => { root.ui-font-changed(idx); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 2: Assistant Response Font
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Assistant Response Font";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Serif / reading font family used for AI assistant message content";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        SegmentedChoice3 {
                            width: 270px;
                            option1: "Literata";
                            option2: "Georgia";
                            option3: "Merriweather";
                            selected-index <=> root.selected-assistant-font;
                            selected-changed(idx) => { root.assistant-font-changed(idx); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 2: Monospace Code Font
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Monospace Code Font";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Monospaced font family used for code blocks and terminal logs";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        SegmentedChoice3 {
                            width: 270px;
                            option1: "Kode Mono";
                            option2: "Fira Code";
                            option3: "JetBrains";
                            selected-index <=> root.selected-code-font;
                            selected-changed(idx) => { root.code-font-changed(idx); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 3: Cursor Blinking
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Text Cursor Blinking";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Animate text insertion cursor blinking in input boxes and terminal prompt";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.cursor-blink-enabled;
                            toggled(checked) => { root.cursor-blink-toggled(checked); }
                        }
                    }
                }
            }
        }
    }
}
