// General Settings category page for the Operon GUI.
//
// Hey friend! This component defines the complete General Settings panel.
// It organizes general application configurations into 3 clear sections:
// 1. System Startup & Window Behavior (autostart, minimize to tray, window close action)
// 2. Default Agent Execution Preferences (global auto-approve)
// 3. Updates & Diagnostics (automatic update check, anonymous telemetry)

import { Tokens } from "../../shared/tokens.slint";
import { ToggleSwitch } from "../../shared/toggle.slint";
import { ScrollView } from "std-widgets.slint";

// Segmented 2-option selector for discrete choices (e.g. Exit App vs Minimize to Tray)
component SegmentedChoice2 inherits Rectangle {
    in property <string> option1: "Option 1";
    in property <string> option2: "Option 2";
    in property <bool> enabled: true;
    in-out property <int> selected-index: 0;
    
    callback selected-changed(int);
    
    height: 30px;
    background: #0d0d0d;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.4;
    
    HorizontalLayout {
        spacing: 0px;
        padding: 2px;
        
        // First Choice
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 0 ? rgba(255, 255, 255, 0.12) : transparent;
            
            Text {
                text: root.option1;
                color: root.selected-index == 0 ? #ffffff : #777777;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => {
                    root.selected-index = 0;
                    root.selected-changed(0);
                }
            }
        }
        
        // Second Choice
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 1 ? rgba(255, 255, 255, 0.12) : transparent;
            
            Text {
                text: root.option2;
                color: root.selected-index == 1 ? #ffffff : #777777;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => {
                    root.selected-index = 1;
                    root.selected-changed(1);
                }
            }
        }
    }
}

export component GeneralSettings inherits Rectangle {
    background: transparent;

    // ── Bindable State Properties Exposed to Rust ──
    in-out property <bool> autostart-enabled: false;
    in-out property <bool> minimize-to-tray-enabled: false;
    in-out property <bool> start-minimized: false;
    in-out property <int> close-button-action: 0; // 0 = Exit App, 1 = Minimize to Tray

    in-out property <bool> global-auto-approve-default: false;
    in-out property <bool> auto-scroll-stream: true;
    in-out property <bool> notify-on-permission-request: true;
    in-out property <bool> notify-on-response-complete: false;
    in-out property <bool> auto-collapse-reasoning-tools: false;

    in-out property <bool> auto-update-checks: true;
    in-out property <bool> telemetry-enabled: false;

    // ── Interaction Callbacks ──
    callback autostart-toggled(bool);
    callback minimize-to-tray-toggled(bool);
    callback start-minimized-toggled(bool);
    callback close-action-changed(int);
    callback global-auto-approve-toggled(bool);
    callback auto-scroll-stream-toggled(bool);
    callback notify-permission-request-toggled(bool);
    callback notify-response-complete-toggled(bool);
    callback auto-collapse-reasoning-tools-toggled(bool);
    callback auto-update-toggled(bool);
    callback telemetry-toggled(bool);

    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 20px;
            alignment: start;

            // Header Banner
            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                Image {
                    source: @image-url("../../../assets/icons/settings/category-general.svg");
                    width: 22px;
                    height: 22px;
                    colorize: Tokens.text_primary;
                }

                VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: "General Settings";
                        color: Tokens.text_primary;
                        font-size: Tokens.body_font_size + 4px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Configure application launch behavior, window controls, and system defaults.";
                        color: Tokens.text_muted;
                        font-size: Tokens.body_font_size - 1px;
                        wrap: TextWrap.word-wrap;
                    }
                }
            }

            // ═════════════════════════════════════════════════════════════
            // SECTION 1: System Startup & Window Behavior Card
            // ═════════════════════════════════════════════════════════════
            Rectangle {
                background: #161616;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Section Card Header
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "System & Window Behavior";
                            color: Tokens.text_primary;
                            font-size: Tokens.body_font_size + 1px;
                            font-weight: 600;
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.05);
                    }

                    // Row 1: Launch on Startup
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Launch on System Startup";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Automatically launch Operon when logging into your computer";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.autostart-enabled;
                            toggled(checked) => { root.autostart-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 2: Minimize to System Tray
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Minimize to System Tray";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Keep Operon accessible from the system notification area";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.minimize-to-tray-enabled;
                            toggled(checked) => { root.minimize-to-tray-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 3: Start Minimized
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            opacity: root.minimize-to-tray-enabled ? 1.0 : 0.4;

                            Text {
                                text: "Start Minimized to System Tray";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Run Operon silently in the background on startup without focusing the window";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            enabled: root.minimize-to-tray-enabled;
                            checked <=> root.start-minimized;
                            toggled(checked) => { root.start-minimized-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 4: Close Button Action
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            opacity: root.minimize-to-tray-enabled ? 1.0 : 0.4;

                            Text {
                                text: "Window Close (X) Action";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Choose whether closing the window exits the app or minimizes it to system tray";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        SegmentedChoice2 {
                            width: 200px;
                            enabled: root.minimize-to-tray-enabled;
                            option1: "Exit App";
                            option2: "Minimize to Tray";
                            selected-index <=> root.close-button-action;
                            selected-changed(idx) => { root.close-action-changed(idx); }
                        }
                    }
                }
            }

            // ═════════════════════════════════════════════════════════════
            // SECTION 2: Default Agent & Execution Preferences Card
            // ═════════════════════════════════════════════════════════════
            Rectangle {
                background: #161616;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Section Card Header
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Agent Execution Preferences";
                            color: Tokens.text_primary;
                            font-size: Tokens.body_font_size + 1px;
                            font-weight: 600;
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.05);
                    }

                    // Row 1: Global Auto-Approve Default
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Global Auto-Approve Tools";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Automatically run safe file and terminal actions without prompting for manual confirmation";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.global-auto-approve-default;
                            toggled(checked) => { root.global-auto-approve-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 2: Auto-Scroll Chat View on New Tokens
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Auto-Scroll Chat View on New Tokens";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Automatically keep chat viewport anchored to the latest streaming response text";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.auto-scroll-stream;
                            toggled(checked) => { root.auto-scroll-stream-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 3: Desktop Notification on Permission Requests
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Desktop Notification on Permission Asking";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Send a system notification when an agent action requires manual user confirmation";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.notify-on-permission-request;
                            toggled(checked) => { root.notify-permission-request-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 4: Desktop Notification on Response Complete
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Desktop Notification on Response Complete";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Send a system notification when long-running agent responses and tool turns finish";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.notify-on-response-complete;
                            toggled(checked) => { root.notify-response-complete-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 5: Auto-Collapse Reasoning / Thinking and Tool Cards
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Auto-Collapse Reasoning & Tool Cards";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Automatically collapse extended thinking blocks and tool execution cards in session chat";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.auto-collapse-reasoning-tools;
                            toggled(checked) => { root.auto-collapse-reasoning-tools-toggled(checked); }
                        }
                    }
                }
            }

            // ═════════════════════════════════════════════════════════════
            // SECTION 3: Updates & Diagnostic Logs Card
            // ═════════════════════════════════════════════════════════════
            Rectangle {
                background: #161616;
                border-width: 1px;
                border-color: rgba(255, 255, 255, 0.06);
                border-radius: 8px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;

                    // Section Card Header
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Updates & Diagnostics";
                            color: Tokens.text_primary;
                            font-size: Tokens.body_font_size + 1px;
                            font-weight: 600;
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.05);
                    }

                    // Row 1: Automatic Update Checks
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Automatic Update Checks";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Check GitHub releases for new Operon versions and security updates on startup";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.auto-update-checks;
                            toggled(checked) => { root.auto-update-toggled(checked); }
                        }
                    }

                    // Divider line
                    Rectangle {
                        height: 1px;
                        background: rgba(255, 255, 255, 0.04);
                    }

                    // Row 2: Anonymous Telemetry & Crash Reports
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "Anonymous Error Diagnostics";
                                color: Tokens.text_primary;
                                font-size: Tokens.body_font_size;
                                font-weight: 500;
                            }

                            Text {
                                text: "Send anonymized crash stack traces and diagnostic logs to help improve system stability";
                                color: Tokens.text_muted;
                                font-size: Tokens.body_font_size - 2px;
                            }
                        }

                        ToggleSwitch {
                            checked <=> root.telemetry-enabled;
                            toggled(checked) => { root.telemetry-toggled(checked); }
                        }
                    }
                }
            }
        }
    }
}



