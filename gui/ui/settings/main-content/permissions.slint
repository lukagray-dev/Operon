// Permissions settings category page for the Operon GUI.
import { Tokens } from "../../shared/tokens.slint";
import { ScrollView } from "std-widgets.slint";

component SegmentedControl2 inherits Rectangle {
    in property <string> option1;
    in property <string> option2;
    in-out property <int> selected-index: 0;
    
    callback selected-changed(int);
    
    height: 32px;
    background: #0d0d0d;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    
    HorizontalLayout {
        spacing: 0px;
        padding: 2px;
        
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 0 ? rgba(255, 255, 255, 0.08) : transparent;
            
            Text {
                text: root.option1;
                color: root.selected-index == 0 ? #e8e8e8 : #888888;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 0;
                    root.selected-changed(0);
                }
            }
        }
        
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 1 ? rgba(255, 255, 255, 0.08) : transparent;
            
            Text {
                text: root.option2;
                color: root.selected-index == 1 ? #e8e8e8 : #888888;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 1;
                    root.selected-changed(1);
                }
            }
        }
    }
}

component SegmentedControl3 inherits Rectangle {
    in property <string> option1: "Allow";
    in property <string> option2: "Ask";
    in property <string> option3: "Deny";
    in-out property <int> selected-index: 1; // 0, 1, 2
    
    callback selected-changed(int);
    
    height: 28px;
    background: #0d0d0d;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    
    HorizontalLayout {
        spacing: 0px;
        padding: 2px;
        
        // Option 1
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 0 ? rgba(255, 255, 255, 0.08) : transparent;
            
            Text {
                text: root.option1;
                color: root.selected-index == 0 ? #e8e8e8 : #555555;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 0;
                    root.selected-changed(0);
                }
            }
        }
        
        // Option 2
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 1 ? rgba(255, 255, 255, 0.08) : transparent;
            
            Text {
                text: root.option2;
                color: root.selected-index == 1 ? #e8e8e8 : #555555;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 1;
                    root.selected-changed(1);
                }
            }
        }
        
        // Option 3
        Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.selected-index == 2 ? rgba(255, 255, 255, 0.08) : transparent;
            
            Text {
                text: root.option3;
                color: root.selected-index == 2 ? #e8e8e8 : #555555;
                font-size: Tokens.body_font_size - 2px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected-index = 2;
                    root.selected-changed(2);
                }
            }
        }
    }
}

component PermissionsInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    
    height: 32px;
    background: #0d0d0d;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        
        input := TextInput {
            font-size: Tokens.body_font_size - 1px;
            font-family: Tokens.font_family;
            color: Tokens.text_primary;
            vertical-alignment: center;
            single-line: true;
        }
    }
    
    // Placeholder text logic
    if (input.text == "") : Text {
        x: 8px;
        text: root.placeholder;
        color: Tokens.text_muted;
        font-size: Tokens.body_font_size - 1px;
        font-family: Tokens.font_family;
        vertical-alignment: center;
    }
}

component DirectoryRow inherits Rectangle {
    in property <string> path;
    in property <bool> is-workspace: false;
    
    callback configure-clicked();
    callback remove-clicked();
    
    height: 44px;
    background: #0d0d0d;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        
        // 1. Directory icon (centered vertically)
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../assets/icons/settings/permission-directory.svg");
                width: 14px;
                height: 14px;
                colorize: #888888;
            }
        }
        
        // 2. Path & Workspace Badge (centered vertically)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                
                Text {
                    text: root.path;
                    color: #e8e8e8;
                    font-size: Tokens.body_font_size - 1px;
                    vertical-alignment: center;
                }
                
                if (root.is-workspace) : Rectangle {
                    border-width: 1px;
                    border-color: rgba(255, 255, 255, 0.1);
                    border-radius: 4px;
                    background: rgba(255, 255, 255, 0.02);
                    
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: "Workspace";
                            color: #888888;
                            font-size: Tokens.body_font_size - 3px;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
        
        // 3. Action Buttons (centered vertically)
        VerticalLayout {
            alignment: center;
            
            HorizontalLayout {
                spacing: 4px;
                alignment: end;
                
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: conf_touch.has-hover ? rgba(255, 255, 255, 0.05) : transparent;
                    
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../../assets/icons/settings/configure-directory-permissions.svg");
                        width: 14px;
                        height: 14px;
                        colorize: conf_touch.has-hover ? #e0e0e0 : #888888;
                    }
                    
                    conf_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.configure-clicked(); }
                    }
                }
                
                if (!root.is-workspace) : Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: rem_touch.has-hover ? rgba(255, 255, 255, 0.05) : transparent;
                    
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../../assets/icons/settings/permission-directory-remove.svg");
                        width: 14px;
                        height: 14px;
                        colorize: rem_touch.has-hover ? #e0e0e0 : #888888;
                    }
                    
                    rem_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.remove-clicked(); }
                    }
                }
            }
        }
    }
}

export struct PermissionItem {
    key: string,
    label: string,
    subtitle: string,
    mode: string,      // "allow", "ask", "deny", "custom"
    base-mode: string, // "allow", "ask", "deny"
    is-explicit: bool,
    kind: string,      // "group" or "tool"
    group-key: string,
    is-expanded: bool,
    has-tools: bool,
}

export global PermissionHelpers {
    public pure function mode_to_index(mode: string) -> int {
        if (mode == "allow") { return 0; }
        if (mode == "ask") { return 1; }
        if (mode == "deny") { return 2; }
        return 1; // Default to "ask"
    }

    public pure function index_to_mode(index: int) -> string {
        if (index == 0) { return "allow"; }
        if (index == 1) { return "ask"; }
        if (index == 2) { return "deny"; }
        return "ask";
    }
}

component PermissionGroupRow inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <string> mode;
    in property <bool> is-expanded: false;
    in property <bool> has-tools: false;
    
    callback toggle-expanded();
    callback mode-changed(string);
    
    height: 52px;
    background: #0d0d0d;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.04);
    
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        
        // 1. Expand/Collapse arrow + Package Icon
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            
            VerticalLayout {
                alignment: center;
                if (root.has-tools) : Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 4px;
                    background: expand_touch.has-hover ? rgba(255, 255, 255, 0.04) : transparent;
                    
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.is-expanded 
                            ? @image-url("../../../assets/icons/settings/chevron-up.svg") 
                            : @image-url("../../../assets/icons/settings/chevron-down.svg");
                        width: 10px;
                        height: 10px;
                        colorize: expand_touch.has-hover ? #e0e0e0 : #555555;
                    }
                    
                    expand_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-expanded(); }
                    }
                }
                if (!root.has-tools) : Rectangle {
                    width: 20px;
                    height: 20px;
                }
            }
            
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../assets/icons/settings/package.svg");
                    width: 16px;
                    height: 16px;
                    colorize: #888888;
                }
            }
        }
        
        // 2. Text Details
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            
            Text {
                text: root.label;
                color: #e8e8e8;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 600;
            }
            
            Text {
                text: root.subtitle;
                color: #555555;
                font-size: Tokens.body_font_size - 3px;
            }
        }
        
        // 3. Segmented Control
        VerticalLayout {
            alignment: center;
            SegmentedControl3 {
                width: 140px;
                selected-index: PermissionHelpers.mode_to_index(root.mode);
                selected-changed(index) => {
                    root.mode-changed(PermissionHelpers.index_to_mode(index));
                }
            }
        }
    }
}

component PermissionToolRow inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <string> mode;
    
    callback mode-changed(string);
    
    height: 48px;
    background: #090909;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.02);
    
    HorizontalLayout {
        padding-left: 24px; // Indent tool rows
        padding-right: 12px;
        spacing: 12px;
        
        // 1. Tool Icon
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../assets/icons/settings/code.svg");
                width: 14px;
                height: 14px;
                colorize: #555555;
            }
        }
        
        // 2. Text Details
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            
            Text {
                text: root.label;
                color: #d0d0d0;
                font-size: Tokens.body_font_size - 1px;
                font-weight: 500;
            }
            
            Text {
                text: root.subtitle;
                color: #444444;
                font-size: Tokens.body_font_size - 3px;
            }
        }
        
        // 3. Segmented Control
        VerticalLayout {
            alignment: center;
            SegmentedControl3 {
                width: 140px;
                selected-index: PermissionHelpers.mode_to_index(root.mode);
                selected-changed(index) => {
                    root.mode-changed(PermissionHelpers.index_to_mode(index));
                }
            }
        }
    }
}

export component PermissionsSettings inherits Rectangle {
    background: transparent;
    
    // Tab tracking: 0 = Allowed Directories, 1 = Global
    in-out property <int> active-tab: 0;
    
    // Sub-view directory configuration (empty means allowed directories tab list view)
    in-out property <string> configure-directory: "";
    
    // Scope tracking: 0 = Owner, 1 = External
    in-out property <int> active-scope: 0;
    
    // Directories list
    in property <[string]> allowed-directories: [];
    in property <string> workspace-directory: "";
    
    // New directory path input state
    in-out property <string> new-directory-path: "";
    
    // Flat loop items list for the current tab / directory scope
    in property <[PermissionItem]> permission-items: [];
    
    // Callbacks to forward events to the Rust controller
    callback tab-changed(int);
    callback scope-changed(int);
    callback configure-directory-clicked(string);
    callback configure-directory-back();
    callback add-directory-clicked(string);
    callback remove-directory-clicked(string);
    callback toggle-group-expanded(string);
    callback set-permission-mode(string, string, string);
    
    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        
        main_layout := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;
            
            // 1. Page Header (Icon + Title)
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                
                Image {
                    source: @image-url("../../../assets/icons/settings/category-permissions.svg");
                    width: 20px;
                    height: 20px;
                    colorize: Tokens.text_primary;
                }
                
                Text {
                    text: "Permissions Settings";
                    color: Tokens.text_primary;
                    font-size: Tokens.body_font_size + 4px;
                    font-weight: 600;
                }
            }
            
            // If in normal list view (directories or global)
            if (root.configure-directory == "") : VerticalLayout {
                spacing: 16px;
                
                // 2. Segmented Tab Selector
                SegmentedControl2 {
                    option1: "Allowed Directories";
                    option2: "Global Permissions";
                    selected-index <=> root.active-tab;
                    selected-changed(idx) => {
                        root.tab-changed(idx);
                    }
                }
                
                // 3. Tab Contents
                if (root.active-tab == 0) : VerticalLayout {
                    spacing: 12px;
                    
                    // Directory rows
                    for dir in root.allowed-directories : DirectoryRow {
                        path: dir;
                        is-workspace: dir == root.workspace-directory;
                        configure-clicked => {
                            root.configure-directory-clicked(dir);
                        }
                        remove-clicked => {
                            root.remove-directory-clicked(dir);
                        }
                    }
                    
                    // Add directory row
                    Rectangle {
                        height: 17px;
                        Rectangle {
                            y: 8px;
                            height: 1px;
                            background: rgba(255, 255, 255, 0.05);
                        }
                    }
                    
                    VerticalLayout {
                        spacing: 8px;
                        
                        Text {
                            text: "Add directory";
                            color: #e8e8e8;
                            font-size: Tokens.body_font_size - 1px;
                            font-weight: 600;
                        }
                        
                        Text {
                            text: "Allow tools to access a new directory path";
                            color: Tokens.text_muted;
                            font-size: Tokens.body_font_size - 2px;
                        }
                        
                        HorizontalLayout {
                            spacing: 8px;
                            
                            PermissionsInput {
                                horizontal-stretch: 1;
                                placeholder: "Directory path (e.g. /path/to/project)";
                                text <=> root.new-directory-path;
                            }
                            
                            // Add button
                            add_btn := Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 6px;
                                background: add_touch.has-hover ? #242424 : #1a1a1a;
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.08);
                                
                                animate background { duration: 150ms; }
                                
                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("../../../assets/icons/settings/plus.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: add_touch.has-hover ? #e0e0e0 : #888888;
                                }
                                
                                add_touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if (root.new-directory-path != "") {
                                            root.add-directory-clicked(root.new-directory-path);
                                            root.new-directory-path = "";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                if (root.active-tab == 1) : VerticalLayout {
                    spacing: 12px;
                    
                    // Scope Selector
                    HorizontalLayout {
                        alignment: space-between;
                        
                        SegmentedControl2 {
                            width: 180px;
                            option1: "Owner";
                            option2: "External";
                            selected-index <=> root.active-scope;
                            selected-changed(idx) => {
                                root.scope-changed(idx);
                            }
                        }
                        
                        Text {
                            text: root.active-scope == 0 ? "Global · Owner scope" : "Global · External scope";
                            color: Tokens.text_muted;
                            font-size: Tokens.body_font_size - 2px;
                            vertical-alignment: center;
                        }
                    }
                    
                    // Permission Rows
                    for item in root.permission-items : VerticalLayout {
                        spacing: 8px;
                        
                        if (item.kind == "group") : PermissionGroupRow {
                            label: item.label;
                            subtitle: item.subtitle;
                            mode: item.mode;
                            is-expanded: item.is-expanded;
                            has-tools: item.has-tools;
                            toggle-expanded => { root.toggle-group-expanded(item.key); }
                            mode-changed(m) => { root.set-permission-mode(item.key, item.kind, m); }
                        }
                        
                        if (item.kind == "tool") : PermissionToolRow {
                            label: item.label;
                            subtitle: item.subtitle;
                            mode: item.mode;
                            mode-changed(m) => { root.set-permission-mode(item.key, item.kind, m); }
                        }
                    }
                }
            }
            
            // If in Configure Directory View
            if (root.configure-directory != "") : VerticalLayout {
                spacing: 14px;
                
                // Back Button & Path Header
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    
                    back_btn := Rectangle {
                        width: 60px;
                        height: 28px;
                        border-radius: 6px;
                        background: back_touch.has-hover ? #242424 : #1a1a1a;
                        border-width: 1px;
                        border-color: rgba(255, 255, 255, 0.08);
                        
                        animate background { duration: 150ms; }
                        
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../../assets/icons/settings/chevron-left.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: back_touch.has-hover ? #e0e0e0 : #888888;
                                }
                            }
                            
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "Back";
                                    color: back_touch.has-hover ? #e0e0e0 : #888888;
                                    font-size: Tokens.body_font_size - 2px;
                                    font-weight: 600;
                                }
                            }
                        }
                        
                        back_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.configure-directory-back();
                            }
                        }
                    }
                    
                    Text {
                        text: "Directory: " + root.configure-directory;
                        color: #e8e8e8;
                        font-size: Tokens.body_font_size - 1px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                
                // Scope selector for the directory
                HorizontalLayout {
                    alignment: space-between;
                    
                    SegmentedControl2 {
                        width: 180px;
                        option1: "Owner";
                        option2: "External";
                        selected-index <=> root.active-scope;
                        selected-changed(idx) => {
                            root.scope-changed(idx);
                        }
                    }
                    
                    Text {
                        text: root.active-scope == 0 ? "Directory · Owner scope" : "Directory · External scope";
                        color: Tokens.text_muted;
                        font-size: Tokens.body_font_size - 2px;
                        vertical-alignment: center;
                    }
                }
                
                // Permission rows specific to the directory
                for item in root.permission-items : VerticalLayout {
                    spacing: 8px;
                    
                    if (item.kind == "group") : PermissionGroupRow {
                        label: item.label;
                        subtitle: item.subtitle;
                        mode: item.mode;
                        is-expanded: item.is-expanded;
                        has-tools: item.has-tools;
                        toggle-expanded => { root.toggle-group-expanded(item.key); }
                        mode-changed(m) => { root.set-permission-mode(item.key, item.kind, m); }
                    }
                    
                    if (item.kind == "tool") : PermissionToolRow {
                        label: item.label;
                        subtitle: item.subtitle;
                        mode: item.mode;
                        mode-changed(m) => { root.set-permission-mode(item.key, item.kind, m); }
                    }
                }
            }
        }
    }
}
