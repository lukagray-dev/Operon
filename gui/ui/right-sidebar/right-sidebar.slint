// Main RightSidebar component for Git Diff / Source Control panel.
//
// Assembles all modular Source Control sections into a cohesive panel:
// 1. SourceControlHeader: Top panel title bar "SOURCE CONTROL" with section visibility toggle dropdown menu.
// 2. RepositoriesSection: Expandable list of workspace repositories with active branch badges, header options, & item dropdowns.
// 3. CommitInputSection: Commit message box with AI "Generate 🪄" button and primary "✓ Commit v" split button.
// 4. ChangesListSection: File changes list accordion with file status badges (M, A, D, U) and line diff preview.
// 5. CommitGraphSection: Visual Git commit history graph matching VS Code Source Control view.
// 6. ContextMenuPopup: Dark VS Code floating dropdown context menus & submenus.
// 7. Left-edge resize handle with blue accent hover highlight matching left sidebar.

import { Tokens } from "../shared/tokens.slint";
import { GitFileDiff, GitDiffHunk, GitDiffLine, GitRepositoryInfo, GitGraphCommit } from "./types.slint";
import { SourceControlHeader } from "./header.slint";
import { RepositoriesSection } from "./repositories.slint";
import { CommitInputSection } from "./commit-input.slint";
import { ChangesListSection } from "./changes-list.slint";
import { CommitGraphSection } from "./commit-graph.slint";
import { ContextMenuPopup, ContextMenuItem } from "./context-menu.slint";
import { MenuData } from "./menu-data.slint";

// Export all struct types so they remain accessible to window.slint and Rust bindings
export { GitFileDiff, GitDiffHunk, GitDiffLine, GitRepositoryInfo, GitGraphCommit, ContextMenuItem }

// Main RightSidebar component
export component RightSidebar inherits Rectangle {
    // Current width of the sidebar (resizable via left drag handle)
    in-out property <length> sidebar-width: 340px;
    
    // Minimum and maximum width constraints for resizing (matching left sidebar)
    property <length> sidebar-min-width: 240px;
    property <length> sidebar-max-width: 400px;
    
    // Overall repository diff stats
    in property <int> total-insertions: 0;
    in property <int> total-deletions: 0;
    in property <bool> has-repo: true;
    in property <string> active-branch: "";

    // Files lists bound from Rust
    in property <[GitFileDiff]> unstaged-files: [];
    in property <[GitFileDiff]> staged-files: [];

    // Repository list for Repositories accordion
    in property <[GitRepositoryInfo]> repositories: [];

    // Commit Graph history for Graph accordion
    in property <[GitGraphCommit]> commits: [];

    // Two-way bound commit message, section collapse, and visibility states
    in-out property <string> commit-message: "";
    in-out property <bool> repos-expanded: true;
    in-out property <bool> changes-expanded: true;
    in-out property <bool> graph-expanded: true;
    in-out property <bool> repos-visible: true;
    in-out property <bool> changes-visible: true;
    in-out property <bool> graph-visible: true;

    // Resizable heights for individual sections
    in-out property <length> repos-section-height: 120px;
    in-out property <length> changes-section-height: 200px;
    in-out property <length> graph-section-height: 250px;

    // Context menu popup & submenu state
    in-out property <bool> menu-open: false;
    in-out property <bool> submenu-open: false;
    in-out property <[ContextMenuItem]> active-menu-items: [];
    in-out property <[ContextMenuItem]> active-submenu-items: [];
    in-out property <length> menu-pos-x: 100px;
    in-out property <length> menu-pos-y: 35px;
    in-out property <length> submenu-pos-y: 35px;

    // Callbacks for user actions
    callback stage-file-clicked(string /* path */);
    callback unstage-file-clicked(string /* path */);
    callback revert-file-clicked(string /* path */);
    callback stage-all-clicked();
    callback revert-all-clicked();
    callback file-expanded-toggled(bool /* is_staged */, int /* file_index */);
    callback width-changed(length);
    callback commit-submitted(string /* message */);
    callback generate-commit-message-requested();
    callback menu-item-clicked(string /* item_id */);

    // Forwarded child callbacks
    callback repository-selected(string /* name */);
    callback refresh-repo-requested(string /* name */);
    callback commit-selected(string /* hash */);
    callback graph-refresh-requested();
    callback graph-center-head-requested();
    callback graph-pull-requested();
    callback graph-push-requested();
    callback graph-filter-branch-requested();
    callback open-file-in-editor(string /* path */);

    width: root.sidebar-width;
    background: #181818;
    clip: true;

    // Main layout containing header and independent resizable/scrollable sections
    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // ===== PANEL HEADER BAR =====
        SourceControlHeader {
            more-actions-clicked => {
                root.submenu-open = false;
                root.active-menu-items = [
                    { id: "toggle_repos", label: root.repos-visible ? "✓ Repositories" : "   Repositories", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false },
                    { id: "toggle_changes", label: root.changes-visible ? "✓ Changes" : "   Changes", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false },
                    { id: "toggle_graph", label: root.graph-visible ? "✓ Graph" : "   Graph", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false }
                ];
                root.menu-pos-x = root.sidebar-width - 235px;
                root.menu-pos-y = 35px;
                root.menu-open = true;
            }
        }

        // ===== 1. REPOSITORIES SECTION =====
        if (root.repos-visible) : repos-sec := RepositoriesSection {
            repositories: root.repositories;
            is-expanded <=> root.repos-expanded;
            section-height <=> root.repos-section-height;

            repository-clicked(name) => {
                root.repository-selected(name);
            }
            refresh-repo-clicked(name) => {
                root.refresh-repo-requested(name);
            }
            header-actions-clicked => {
                root.submenu-open = false;
                root.active-menu-items = MenuData.repo-heading-menu;
                root.menu-pos-x = root.sidebar-width - 235px;
                root.menu-pos-y = 60px;
                root.menu-open = true;
            }
            repo-actions-clicked(name) => {
                root.submenu-open = false;
                root.active-menu-items = MenuData.git-main-menu;
                root.menu-pos-x = root.sidebar-width - 235px;
                root.menu-pos-y = 80px;
                root.menu-open = true;
            }
        }

        // Horizontal Divider for Resizing Repositories Section
        if (root.repos-visible && root.repos-expanded) : repos-divider := Rectangle {
            height: 4px;
            background: repos-divider-touch.has-hover ? Tokens.accent-blue : transparent;
            animate background { duration: 150ms; }

            repos-divider-touch := TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        let delta = self.mouse-y - self.pressed-y;
                        root.repos-section-height = max(50px, min(350px, root.repos-section-height + delta));
                    }
                }
            }
        }

        // ===== 2. MAIN CHANGES SECTION HEADER =====
        if (root.changes-visible) : changes-header := Rectangle {
            height: 24px;
            background: changes-title-touch.has-hover || changes-more-touch.has-hover ? rgba(255, 255, 255, 0.05) : #1e1e1e;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                alignment: space-between;

                // Title & Chevron (Clickable area to toggle expand/collapse)
                changes-title-area := Rectangle {
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        Image {
                            source: root.changes-expanded 
                                ? @image-url("../../assets/icons/right-sidebar/chevron-down.svg") 
                                : @image-url("../../assets/icons/right-sidebar/chevron-right.svg");
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                            colorize: Tokens.text-muted;
                        }

                        Text {
                            text: "Changes";
                            font-size: 11px;
                            font-weight: 700;
                            color: Tokens.text-primary;
                            font-family: Tokens.font-family;
                            vertical-alignment: center;
                        }
                    }

                    changes-title-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.changes-expanded = !root.changes-expanded;
                        }
                    }
                }

                // Changes More Options button (...)
                changes-more-btn := Rectangle {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: changes-more-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    Image {
                        source: @image-url("../../assets/icons/right-sidebar/ellipsis.svg");
                        width: 12px;
                        height: 12px;
                        colorize: changes-more-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    changes-more-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.submenu-open = false;
                            root.active-menu-items = MenuData.git-main-menu;
                            root.menu-pos-x = root.sidebar-width - 235px;
                            root.menu-pos-y = 160px;
                            root.menu-open = true;
                        }
                    }
                }
            }
        }

        // Main Changes Section Body
        if (root.changes-visible && root.changes-expanded) : VerticalLayout {
            spacing: 0px;

            // Commit Message Input Box & Split Commit Button
            CommitInputSection {
                commit-message <=> root.commit-message;
                active-branch: root.active-branch;

                generate-message-clicked => {
                    root.generate-commit-message-requested();
                }
                commit-clicked => {
                    root.commit-submitted(root.commit-message);
                }
                commit-dropdown-clicked => {
                    root.submenu-open = false;
                    root.active-menu-items = [
                        { id: "commit_now", label: "Commit", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false },
                        { id: "commit_and_push", label: "Commit & Push", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false },
                        { id: "commit_and_sync", label: "Commit & Sync", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false }
                    ];
                    root.menu-pos-x = root.sidebar-width - 235px;
                    root.menu-pos-y = 167px + (root.repos-visible ? (root.repos-expanded ? root.repos-section-height + 4px : 24px) : 0px);
                    root.menu-open = true;
                }
            }

            // File Changes List (Sub-accordion: v Changes 3)
            ChangesListSection {
                title: "Changes";
                files: root.unstaged-files.length > 0 ? root.unstaged-files : root.staged-files;
                section-height <=> root.changes-section-height;

                file-clicked(path, idx) => {
                    root.file-expanded-toggled(false, idx);
                }
                stage-file-clicked(path) => {
                    root.stage-file-clicked(path);
                }
                discard-file-clicked(path) => {
                    root.revert-file-clicked(path);
                }
                open-file-clicked(path) => {
                    root.open-file-in-editor(path);
                }
            }

            // Staged Changes List (If Any)
            if (root.staged-files.length > 0) : ChangesListSection {
                title: "Staged Changes";
                files: root.staged-files;

                file-clicked(path, idx) => {
                    root.file-expanded-toggled(true, idx);
                }
                stage-file-clicked(path) => {
                    root.unstage-file-clicked(path);
                }
                discard-file-clicked(path) => {
                    root.revert-file-clicked(path);
                }
                open-file-clicked(path) => {
                    root.open-file-in-editor(path);
                }
            }
        }

        // Horizontal Divider for Resizing Changes Section
        if (root.changes-visible && root.changes-expanded) : changes-divider := Rectangle {
            height: 4px;
            background: changes-divider-touch.has-hover ? Tokens.accent-blue : transparent;
            animate background { duration: 150ms; }

            changes-divider-touch := TouchArea {
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        let delta = self.mouse-y - self.pressed-y;
                        root.changes-section-height = max(80px, min(500px, root.changes-section-height + delta));
                    }
                }
            }
        }

        // ===== 3. COMMIT GRAPH SECTION =====
        if (root.graph-visible) : graph-sec := CommitGraphSection {
            commits: root.commits;
            is-expanded <=> root.graph-expanded;
            section-height <=> root.graph-section-height;
            vertical-stretch: 1;

            commit-clicked(hash) => {
                root.commit-selected(hash);
            }
            refresh-graph-clicked => {
                root.graph-refresh-requested();
            }
            center-head-clicked => {
                root.graph-center-head-requested();
            }
            pull-clicked => {
                root.graph-pull-requested();
            }
            push-clicked => {
                root.graph-push-requested();
            }
            filter-branch-clicked => {
                root.graph-filter-branch-requested();
            }
            more-graph-clicked => {
                root.submenu-open = false;
                root.active-menu-items = MenuData.graph-heading-menu;
                root.menu-pos-x = root.sidebar-width - 235px;
                root.menu-pos-y = 180px;
                root.menu-open = true;
            }
        }
    }

    // ===== FLOATING DROPDOWN CONTEXT MENU OVERLAY =====
    if (root.menu-open) : popup-backdrop := TouchArea {
        width: 100%;
        height: 100%;
        z: 999;
        clicked => {
            root.menu-open = false;
            root.submenu-open = false;
        }

        popup-menu := ContextMenuPopup {
            x: root.menu-pos-x;
            y: root.menu-pos-y;
            items: root.active-menu-items;

            item-hovered(id) => {
                if (id == "commit_sub") {
                    root.active-submenu-items = MenuData.commit-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 131px;
                    root.submenu-open = true;
                } else if (id == "changes_sub") {
                    root.active-submenu-items = MenuData.changes-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 155px;
                    root.submenu-open = true;
                } else if (id == "pull_push_sub") {
                    root.active-submenu-items = MenuData.pull-push-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 179px;
                    root.submenu-open = true;
                } else if (id == "branch_sub") {
                    root.active-submenu-items = MenuData.branch-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 203px;
                    root.submenu-open = true;
                } else if (id == "remote_sub") {
                    root.active-submenu-items = MenuData.remote-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 227px;
                    root.submenu-open = true;
                } else if (id == "stash_sub") {
                    root.active-submenu-items = MenuData.stash-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 251px;
                    root.submenu-open = true;
                } else if (id == "tags_sub") {
                    root.active-submenu-items = MenuData.tags-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 275px;
                    root.submenu-open = true;
                } else if (id == "worktrees_sub") {
                    root.active-submenu-items = MenuData.worktrees-submenu;
                    root.submenu-pos-y = root.menu-pos-y + 299px;
                    root.submenu-open = true;
                } else {
                    root.submenu-open = false;
                }
            }

            item-selected(id) => {
                if (id == "toggle_repos") {
                    root.repos-visible = !root.repos-visible;
                } else if (id == "toggle_changes") {
                    root.changes-visible = !root.changes-visible;
                } else if (id == "toggle_graph") {
                    root.graph-visible = !root.graph-visible;
                } else {
                    root.menu-item-clicked(id);
                }
                root.menu-open = false;
                root.submenu-open = false;
            }
            close-requested => {
                root.menu-open = false;
                root.submenu-open = false;
            }
        }

        // Secondary Nested Submenu Overlay
        if (root.submenu-open) : submenu-popup := ContextMenuPopup {
            x: max(10px, root.menu-pos-x - 220px);
            y: root.submenu-pos-y;
            items: root.active-submenu-items;

            item-selected(id) => {
                root.menu-item-clicked(id);
                root.menu-open = false;
                root.submenu-open = false;
            }
            close-requested => {
                root.menu-open = false;
                root.submenu-open = false;
            }
        }
    }

    // ===== RESIZE HANDLE =====
    // Positioned on the left edge of the right sidebar (git diff panel).
    // Allows users to drag and adjust panel width smoothly just like the left sidebar.
    resize-handle := Rectangle {
        x: - self.width / 2;
        width: 4px;
        height: parent.height;
        
        // Subtle visual indicator (blue accent highlight) on mouse hover
        background: resize-touch.has-hover 
            ? Tokens.accent-blue 
            : transparent;
        
        // Smooth color transition on hover start/end
        animate background { duration: 150ms; }
        
        // Touch area for detecting mouse drag events
        resize-touch := TouchArea {
            // Stores initial panel width when drag interaction begins
            property <length> drag-start-width: root.sidebar-width;
            
            // Set double-ended horizontal resize cursor (east-west resize)
            mouse-cursor: ew-resize;
            
            // Capture initial drag state on mouse press
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.drag-start-width = root.sidebar-width;
                }
            }
            
            // Track pointer movement while pressed to adjust panel width smoothly
            moved => {
                if (self.pressed) {
                    root.sidebar-width = max(
                        root.sidebar-min-width,
                        min(
                            root.sidebar-max-width,
                            root.sidebar-width - (self.mouse-x - self.pressed-x)
                        )
                    );
                    
                    // Notify window/parent container of updated sidebar width
                    root.width-changed(root.sidebar-width);
                }
            }
        }
    }
}
