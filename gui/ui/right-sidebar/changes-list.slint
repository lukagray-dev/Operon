// File changes list accordion section component for Source Control panel.
//
// Displays:
// - Expandable accordion header "Changes" with changes count badge (e.g. `3`).
// - List of changed files with file icon, file basename, directory path, hover actions (Open diff, Discard, Stage), and status badge (`M`, `A`, `D`, `U`).
// - Expandable inline line-by-line diff preview when clicking a file row.
// - Supports independent section scrolling and resizable section height.

import { Tokens } from "../shared/tokens.slint";
import { GitFileDiff } from "./types.slint";

export component ChangesListSection inherits VerticalLayout {
    // List of changed files bound from parent / Rust
    in property <[GitFileDiff]> files: [];
    
    // Accordion section title label (e.g. "Changes", "Staged Changes")
    in property <string> title: "Changes";

    // Accordion expansion state and resizable section height
    in-out property <bool> is-expanded: true;
    in-out property <length> section-height: 180px;

    // Callbacks for user actions
    callback file-clicked(string /* path */, int /* index */);
    callback stage-file-clicked(string /* path */);
    callback discard-file-clicked(string /* path */);
    callback open-file-clicked(string /* path */);

    spacing: 0px;

    // ===== ACCORDION HEADER =====
    header := Rectangle {
        height: 24px;
        background: header-touch.has-hover ? rgba(255, 255, 255, 0.05) : #1e1e1e;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                Image {
                    source: root.is-expanded 
                        ? @image-url("../../assets/icons/right-sidebar/chevron-down.svg") 
                        : @image-url("../../assets/icons/right-sidebar/chevron-right.svg");
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.text-muted;
                }

                Text {
                    text: root.title;
                    font-size: 11px;
                    font-weight: 700;
                    color: Tokens.text-primary;
                    font-family: Tokens.font-family;
                    vertical-alignment: center;
                }
            }

            // Count badge
            count-badge := Rectangle {
                background: rgba(255, 255, 255, 0.12);
                border-radius: 9px;
                height: 16px;
                width: count-text.preferred-width + 10px;
                y: (parent.height - self.height) / 2;

                count-text := Text {
                    text: root.files.length;
                    font-size: 10px;
                    font-weight: 600;
                    color: Tokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        header-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.is-expanded = !root.is-expanded;
            }
        }
    }

    // ===== INDEPENDENT SCROLLABLE FILE LIST =====
    if (root.is-expanded) : Rectangle {
        vertical-stretch: 1;
        preferred-height: root.section-height;
        clip: true;

        Flickable {
            width: 100%;
            height: 100%;
            viewport-height: file-list-layout.preferred-height;

            file-list-layout := VerticalLayout {
                spacing: 0px;

                if (root.files.length == 0) : HorizontalLayout {
                    height: 28px;
                    padding-left: 20px;

                    Text {
                        text: "No changes detected";
                        font-size: 11px;
                        color: Tokens.text-muted;
                        font-family: Tokens.font-family;
                        vertical-alignment: center;
                    }
                }

                for file[file-idx] in root.files : VerticalLayout {
                    spacing: 0px;

                    file-row := Rectangle {
                        height: 24px;
                        background: file-row-touch.has-hover 
                            ? rgba(255, 255, 255, 0.06) 
                            : (file.is_expanded ? rgba(255, 255, 255, 0.03) : transparent);

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 8px;
                            spacing: 6px;

                            // File icon
                            Image {
                                source: @image-url("../../assets/icons/right-sidebar/file-text.svg");
                                width: 14px;
                                height: 14px;
                                y: (parent.height - self.height) / 2;
                                colorize: file.status == "added" ? #23d18b :
                                          (file.status == "deleted" ? #f14c4c : #e2c08d);
                            }

                            // File name (basename)
                            Text {
                                text: file.file_name != "" ? file.file_name : file.path;
                                font-size: 12px;
                                color: Tokens.text-primary;
                                font-family: Tokens.font-family;
                                vertical-alignment: center;
                            }

                            // Directory path (muted text suffix)
                            Text {
                                text: file.dir_path != "" ? file.dir_path : "";
                                font-size: 11px;
                                color: Tokens.text-muted;
                                font-family: Tokens.font-family;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            // Right hover actions (Open diff, Discard, Stage)
                            HorizontalLayout {
                                spacing: 2px;
                                alignment: end;
                                visible: file-row-touch.has-hover;

                                // Open diff file button
                                open-btn := Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: open-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                                    Image {
                                        source: @image-url("../../assets/icons/right-sidebar/external-link.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: open-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    open-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.open-file-clicked(file.path);
                                        }
                                    }
                                }

                                // Discard / Revert changes button
                                discard-btn := Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: discard-touch.has-hover ? rgba(241, 76, 76, 0.2) : transparent;

                                    Image {
                                        source: @image-url("../../assets/icons/right-sidebar/undo-2.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: discard-touch.has-hover ? #f14c4c : Tokens.text-muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    discard-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.discard-file-clicked(file.path);
                                        }
                                    }
                                }

                                // Stage file button (+)
                                stage-btn := Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: stage-touch.has-hover ? rgba(35, 209, 139, 0.2) : transparent;

                                    Image {
                                        source: @image-url("../../assets/icons/right-sidebar/plus.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: stage-touch.has-hover ? #23d18b : Tokens.text-muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    stage-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.stage-file-clicked(file.path);
                                        }
                                    }
                                }
                            }

                            // Git status badge (M, A, D, U)
                            Text {
                                text: file.status == "added" ? "A" :
                                      (file.status == "deleted" ? "D" :
                                      (file.status == "untracked" ? "U" : "M"));
                                font-size: 11px;
                                font-weight: 700;
                                color: file.status == "added" ? #23d18b :
                                       (file.status == "deleted" ? #f14c4c :
                                       (file.status == "untracked" ? #cccccc : #e2c08d));
                                vertical-alignment: center;
                            }
                        }

                        file-row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.file-clicked(file.path, file-idx);
                            }
                        }
                    }

                    // Inline Hunk Diff View when expanded
                    if (file.is_expanded) : Rectangle {
                        background: #050505;
                        border-radius: 4px;
                        clip: true;

                        VerticalLayout {
                            padding: 4px;
                            spacing: 2px;

                            for hunk in file.hunks : VerticalLayout {
                                spacing: 1px;

                                // Hunk Header
                                Rectangle {
                                    height: 20px;
                                    background: rgba(255, 255, 255, 0.03);

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;

                                        Text {
                                            text: hunk.header;
                                            font-size: 10.5px;
                                            font-family: Tokens.mono_font_family;
                                            color: #79c0ff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Diff Lines
                                for line in hunk.lines : Rectangle {
                                    height: 20px;
                                    background: line.line_type == "+" ? rgba(35, 209, 139, 0.15) :
                                                (line.line_type == "-" ? rgba(241, 76, 76, 0.18) : transparent);

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;

                                        Text {
                                            text: line.old_line_num;
                                            font-size: 10px;
                                            font-family: Tokens.mono_font_family;
                                            color: line.line_type == "-" ? #f14c4c : Tokens.text-muted;
                                            width: 24px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: line.new_line_num;
                                            font-size: 10px;
                                            font-family: Tokens.mono_font_family;
                                            color: line.line_type == "+" ? #23d18b : Tokens.text-muted;
                                            width: 24px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: line.line_type;
                                            font-size: 10.5px;
                                            font-family: Tokens.mono_font_family;
                                            color: line.line_type == "+" ? #23d18b :
                                                   (line.line_type == "-" ? #f14c4c : Tokens.text-muted);
                                            width: 10px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: line.content;
                                            font-size: 10.5px;
                                            font-family: Tokens.mono_font_family;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
