// Git Commit Graph / History accordion section component for Source Control panel.
//
// Displays:
// - Expandable accordion header "Graph" with repository selector badge (`Operon`), `Auto`, and toolbar action icons (`↻`, `...`).
// - Visual commit timeline tree with blue commit nodes (`O`), vertical branch connector lines (`|`), commit message, author, and branch tip badges.
// - Matches the exact Git Graph feature from VS Code's Source Control view.
// - Supports independent section scrolling and resizable section height.

import { Tokens } from "../shared/tokens.slint";
import { GitGraphCommit } from "./types.slint";

export component CommitGraphSection inherits VerticalLayout {
    // Array of commit graph entries bound from parent / Rust
    in property <[GitGraphCommit]> commits: [];

    // Accordion expansion state and resizable section height
    in-out property <bool> is-expanded: true;
    in-out property <length> section-height: 250px;

    // Callbacks for user actions
    callback commit-clicked(string /* hash */);
    callback refresh-graph-clicked();
    callback center-head-clicked();
    callback pull-clicked();
    callback push-clicked();
    callback filter-branch-clicked();
    callback more-graph-clicked();

    spacing: 0px;

    // ===== ACCORDION HEADER WITH GRAPH TOOLBAR =====
    header := Rectangle {
        height: 28px;
        background: header-touch.has-hover ? rgba(255, 255, 255, 0.05) : #1e1e1e;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: space-between;

            // Left Section Title: v Graph
            HorizontalLayout {
                spacing: 4px;
                alignment: start;

                Image {
                    source: root.is-expanded 
                        ? @image-url("../../assets/icons/right-sidebar/chevron-down.svg") 
                        : @image-url("../../assets/icons/right-sidebar/chevron-right.svg");
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.text-muted;
                }

                Text {
                    text: "Graph";
                    font-size: 11px;
                    font-weight: 700;
                    color: Tokens.text-primary;
                    font-family: Tokens.font-family;
                    vertical-alignment: center;
                }
            }

            // Right Graph Toolbar Options: [Operon] [Auto] [Target] [Branch] [Pull] [Push] [↻] [...]
            HorizontalLayout {
                spacing: 4px;
                alignment: end;

                // 1. Repository Filter Badge [Book Operon]
                repo-badge := Rectangle {
                    background: rgba(255, 255, 255, 0.08);
                    border-radius: 4px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;

                        Image {
                            source: @image-url("../../assets/icons/right-sidebar/book.svg");
                            width: 11px;
                            height: 11px;
                            y: (parent.height - self.height) / 2;
                            colorize: Tokens.text-primary;
                        }

                        Text {
                            text: "Operon";
                            font-size: 10.5px;
                            color: Tokens.text-primary;
                            font-family: Tokens.font-family;
                            vertical-alignment: center;
                        }
                    }
                }

                // 2. Auto mode label
                Text {
                    text: "Auto";
                    font-size: 10.5px;
                    color: Tokens.text-muted;
                    font-family: Tokens.font-family;
                    vertical-alignment: center;
                }

                // 3. Center HEAD / Target button (o)
                target-btn := Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: target-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    Image {
                        source: @image-url("../../assets/icons/right-sidebar/target.svg");
                        width: 12px;
                        height: 12px;
                        colorize: target-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    target-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.center-head-clicked();
                        }
                    }
                }

                // 4. Branch / Fetch Filter button
                branch-filter-btn := Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: branch-filter-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    Image {
                        source: @image-url("../../assets/icons/right-sidebar/git-commit.svg");
                        width: 12px;
                        height: 12px;
                        colorize: branch-filter-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    branch-filter-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.filter-branch-clicked();
                        }
                    }
                }

                // 5. Pull commits down button
                pull-btn := Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: pull-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    Image {
                        source: @image-url("../../assets/icons/right-sidebar/arrow-down.svg");
                        width: 12px;
                        height: 12px;
                        colorize: pull-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    pull-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.pull-clicked();
                        }
                    }
                }

                // 6. Push commits up button
                push-btn := Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: push-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    Image {
                        source: @image-url("../../assets/icons/right-sidebar/arrow-up.svg");
                        width: 12px;
                        height: 12px;
                        colorize: push-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    push-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.push-clicked();
                        }
                    }
                }

                // 7. Refresh graph icon button (↻)
                refresh-graph-btn := Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: refresh-graph-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    Image {
                        source: @image-url("../../assets/icons/right-sidebar/refresh-cw.svg");
                        width: 12px;
                        height: 12px;
                        colorize: refresh-graph-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    refresh-graph-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.refresh-graph-clicked();
                        }
                    }
                }

                // 8. More actions ellipsis button (...)
                more-graph-btn := Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: more-graph-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                    Image {
                        source: @image-url("../../assets/icons/right-sidebar/ellipsis.svg");
                        width: 12px;
                        height: 12px;
                        colorize: more-graph-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    more-graph-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.more-graph-clicked();
                        }
                    }
                }
            }
        }

        header-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.is-expanded = !root.is-expanded;
            }
        }
    }

    // ===== INDEPENDENT SCROLLABLE COMMIT GRAPH TIMELINE LIST =====
    if (root.is-expanded) : Rectangle {
        vertical-stretch: 1;
        preferred-height: root.section-height;
        clip: true;

        Flickable {
            width: 100%;
            height: 100%;
            viewport-height: graph-list-layout.preferred-height;

            graph-list-layout := VerticalLayout {
                spacing: 0px;

                if (root.commits.length == 0) : HorizontalLayout {
                    height: 28px;
                    padding-left: 20px;

                    Text {
                        text: "No commit history found";
                        font-size: 11px;
                        color: Tokens.text-muted;
                        font-family: Tokens.font-family;
                        vertical-alignment: center;
                    }
                }

                for commit[idx] in root.commits : commit-row := Rectangle {
                    height: 24px;
                    background: commit-row-touch.has-hover 
                        ? rgba(255, 255, 255, 0.06) 
                        : (commit.is_head ? rgba(0, 120, 212, 0.1) : transparent);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;

                        // Visual Timeline Node Circle (O) with vertical connecting line (|)
                        graph-node-col := Rectangle {
                            width: 12px;

                            // Vertical timeline connecting line
                            Rectangle {
                                width: 2px;
                                height: parent.height;
                                background: #007acc;
                                x: (parent.width - self.width) / 2;
                            }

                            // Node Circle
                            node-circle := Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: commit.is_head ? #38bdf8 : #007acc;
                                border-width: commit.is_head ? 2px : 0px;
                                border-color: #ffffff;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        // Commit message text
                        Text {
                            text: commit.message;
                            font-size: 11.5px;
                            font-weight: commit.is_head ? 600 : 400;
                            color: commit.is_head ? Tokens.text-primary : #cccccc;
                            font-family: Tokens.font-family;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // Author name
                        Text {
                            text: commit.author;
                            font-size: 11px;
                            color: Tokens.text-muted;
                            font-family: Tokens.font-family;
                            vertical-alignment: center;
                        }

                        // Branch tag badge if present (e.g. `(O) revert-tool-proto... ☁️`)
                        if (commit.branch_tag != "") : branch-pill := Rectangle {
                            background: #004b72;
                            border-radius: 10px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;

                                Image {
                                    source: @image-url("../../assets/icons/right-sidebar/git-branch.svg");
                                    width: 10px;
                                    height: 10px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: #ffffff;
                                }

                                Text {
                                    text: commit.branch_tag;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: #ffffff;
                                    font-family: Tokens.font-family;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Image {
                                    source: @image-url("../../assets/icons/right-sidebar/cloud.svg");
                                    width: 10px;
                                    height: 10px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: #ffffff;
                                }
                            }
                        }
                    }

                    commit-row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.commit-clicked(commit.hash);
                        }
                    }
                }
            }
        }
    }
}
