// Commit message input panel & action buttons component for Source Control panel.
//
// Displays:
// - Multiline / text input box with placeholder "Message (Ctrl+Enter to commit on...)".
// - Integrated AI "Generate 🪄" action button inside the message input box.
// - Primary split "✓ Commit v" action button matching VS Code Source Control panel layout.

import { Tokens } from "../shared/tokens.slint";
import { LineEdit } from "std-widgets.slint";

export component CommitInputSection inherits VerticalLayout {
    // Commit message text property (two-way bound)
    in-out property <string> commit-message: "";
    
    // Active branch name for input placeholder
    in property <string> active-branch: "revert-tool-protocol-provider-native";
    
    // Callbacks for user actions
    callback generate-message-clicked();
    callback commit-clicked();
    callback commit-dropdown-clicked();

    padding: 8px;
    spacing: 8px;

    // ===== COMMIT MESSAGE INPUT BOX WITH INTEGRATED GENERATE BUTTON =====
    input-container := Rectangle {
        height: 64px;
        background: #252526;
        border-width: 1px;
        border-color: input-touch.has-hover ? Tokens.accent-blue : #3c3c3c;
        border-radius: 4px;

        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 4px;

            HorizontalLayout {
                spacing: 6px;

                // Commit message text edit area
                commit-input := Text {
                    text: root.commit-message != "" 
                        ? root.commit-message 
                        : "Message (Ctrl+Enter to commit on \"" + root.active-branch + "\")";
                    font-size: 11px;
                    color: root.commit-message != "" ? Tokens.text-primary : Tokens.text-muted;
                    font-family: Tokens.font-family;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }

                // AI "Generate 🪄" action button
                generate-btn := Rectangle {
                    height: 22px;
                    width: 80px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: generate-touch.has-hover ? #007acc : #0e639c;

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;

                        Image {
                            source: @image-url("../../assets/icons/right-sidebar/sparkles.svg");
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            colorize: #ffffff;
                        }

                        Text {
                            text: "Generate";
                            font-size: 10.5px;
                            font-weight: 600;
                            color: #ffffff;
                            font-family: Tokens.font-family;
                            vertical-alignment: center;
                        }
                    }

                    generate-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.generate-message-clicked();
                        }
                    }
                }
            }
        }

        input-touch := TouchArea {
            // Allows focus interaction for text entry
        }
    }

    // ===== PRIMARY COMMIT SPLIT BUTTON =====
    commit-split-btn := Rectangle {
        height: 28px;
        border-radius: 3px;
        background: commit-touch.has-hover ? #0062a3 : #0078d4;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            alignment: space-between;

            // Main Commit click area
            commit-main-area := HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 1;

                Image {
                    source: @image-url("../../assets/icons/right-sidebar/check.svg");
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    colorize: #ffffff;
                }

                Text {
                    text: "Commit";
                    font-size: 11.5px;
                    font-weight: 600;
                    color: #ffffff;
                    font-family: Tokens.font-family;
                    vertical-alignment: center;
                }
            }

            // Separator line between Commit button and dropdown chevron
            Rectangle {
                width: 1px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                background: rgba(255, 255, 255, 0.2);
            }

            // Dropdown chevron button
            dropdown-area := Rectangle {
                width: 20px;
                height: 24px;
                y: (parent.height - self.height) / 2;

                Image {
                    source: @image-url("../../assets/icons/right-sidebar/chevron-down.svg");
                    width: 12px;
                    height: 12px;
                    colorize: #ffffff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                dropdown-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.commit-dropdown-clicked();
                    }
                }
            }
        }

        commit-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.commit-clicked();
            }
        }
    }
}
