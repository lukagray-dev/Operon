// Menu Data helper module containing all VS Code Source Control context menu definitions.
//
// Exports predefined menu item lists for:
// 1. Source Control Header (Section Visibility Toggles)
// 2. Repositories Heading (Sorting & Selection)
// 3. Repository Items & Changes Header (Full Git Commands & Submenus)
// 4. All Submenus (Commit, Changes, Pull/Push, Branch, Remote, Stash, Tags, Worktrees)
// 5. Commit Graph Heading (Graph options)

import { ContextMenuItem } from "./context-menu.slint";

export global MenuData {
    // 1. Repositories Heading Menu: Sort & Selection options
    out property <[ContextMenuItem]> repo-heading-menu: [
        { id: "sort_discovery", label: "Sort by Discovery Time", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false },
        { id: "sort_name", label: "Sort by Name", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false },
        { id: "sort_path", label: "Sort by Path", shortcut: "", has_submenu: false, is_separator: false, is_disabled: false },
