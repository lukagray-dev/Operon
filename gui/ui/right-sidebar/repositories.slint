// Repositories accordion section component for Source Control panel.
//
// Displays:
// - Expandable accordion header "Repositories" with header actions menu (`...`).
// - List of workspace git repositories with active branch badges, refresh action `↻`, and `...` options.
// - Highlighted active repository row matching VS Code Source Control styling.
// - Correct touch area scoping so `...` buttons receive click events cleanly.

import { Tokens } from "../shared/tokens.slint";
import { GitRepositoryInfo } from "./types.slint";

export component RepositoriesSection inherits VerticalLayout {
    // Repository list data bound from parent / Rust
    in property <[GitRepositoryInfo]> repositories: [];
    
    // Accordion expansion state and resizable section height
    in-out property <bool> is-expanded: true;
    in-out property <length> section-height: 120px;

    // Callbacks for user interaction
    callback repository-clicked(string /* name */);
    callback refresh-repo-clicked(string /* name */);
    callback repo-actions-clicked(string /* name */);
    callback header-actions-clicked();

    spacing: 0px;

    // ===== ACCORDION HEADER =====
    header := Rectangle {
        height: 24px;
        background: header-touch.has-hover ? rgba(255, 255, 255, 0.05) : #1e1e1e;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: space-between;

            // Title & Chevron (Clickable area to toggle expand/collapse)
            title-area := Rectangle {
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;

                    Image {
                        source: root.is-expanded 
                            ? @image-url("../../assets/icons/right-sidebar/chevron-down.svg") 
                            : @image-url("../../assets/icons/right-sidebar/chevron-right.svg");
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        colorize: Tokens.text-muted;
                    }

                    Text {
                        text: "Repositories";
                        font-size: 11px;
                        font-weight: 700;
                        color: Tokens.text-primary;
                        font-family: Tokens.font-family;
                        vertical-alignment: center;
                    }
                }

                header-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.is-expanded = !root.is-expanded;
                    }
                }
            }

            // Header More Options button (...)
            repos-more-btn := Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: repos-more-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                Image {
                    source: @image-url("../../assets/icons/right-sidebar/ellipsis.svg");
                    width: 12px;
                    height: 12px;
                    colorize: repos-more-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                repos-more-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.header-actions-clicked();
                    }
                }
            }
        }
    }

    // ===== INDEPENDENT SCROLLABLE REPOSITORIES LIST =====
    if (root.is-expanded) : Rectangle {
        vertical-stretch: 1;
        preferred-height: root.section-height;
        clip: true;

        Flickable {
            width: 100%;
            height: 100%;
            viewport-height: repo-list.preferred-height;

            repo-list := VerticalLayout {
                spacing: 0px;

                for repo in root.repositories : repo-row := Rectangle {
                    height: 26px;
                    background: repo-name-touch.has-hover || more-repo-touch.has-hover
                        ? (repo.is_active ? rgba(55, 55, 61, 0.8) : rgba(255, 255, 255, 0.05))
                        : (repo.is_active ? rgba(42, 45, 46, 0.6) : transparent);

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: space-between;

                        // Left section: Icon + Repository Name (Clickable to select repository)
                        repo-name-area := Rectangle {
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                horizontal-stretch: 1;

                                Image {
                                    source: @image-url("../../assets/icons/right-sidebar/book.svg");
                                    width: 14px;
                                    height: 14px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: repo.is_active ? Tokens.text-primary : Tokens.text-muted;
                                }

                                Text {
                                    text: repo.name;
                                    font-size: 12px;
                                    font-weight: repo.is_active ? 600 : 400;
                                    color: repo.is_active ? Tokens.text-primary : #bbbbbb;
                                    font-family: Tokens.font-family;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            repo-name-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.repository-clicked(repo.name);
                                }
                            }
                        }

                        // Right edge section: Branch tag badge + Hover action buttons
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            Text {
                                text: repo.branch;
                                font-size: 11px;
                                color: repo.is_active ? #cccccc : Tokens.text-muted;
                                font-family: Tokens.font-family;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            // Action Buttons (Refresh, More)
                            HorizontalLayout {
                                spacing: 2px;
                                alignment: end;

                                // Refresh button
                                refresh-btn := Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: refresh-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                                    Image {
                                        source: @image-url("../../assets/icons/right-sidebar/refresh-cw.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: refresh-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    refresh-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.refresh-repo-clicked(repo.name);
                                        }
                                    }
                                }

                                // More actions button (...)
                                more-repo-btn := Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: more-repo-touch.has-hover ? rgba(255, 255, 255, 0.15) : transparent;

                                    Image {
                                        source: @image-url("../../assets/icons/right-sidebar/ellipsis.svg");
                                        width: 12px;
                                        height: 12px;
                                        colorize: more-repo-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    more-repo-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.repo-actions-clicked(repo.name);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
