// Top title bar component for the Source Control (Git Diff) panel.
//
// This component displays:
// - Uppercase "SOURCE CONTROL" panel title.
// - Right action buttons (overflow `...` menu button).
//
// Designed to match the exact aesthetic of VS Code's Source Control panel header.

import { Tokens } from "../shared/tokens.slint";

export component SourceControlHeader inherits Rectangle {
    // Callbacks for user interaction
    callback more-actions-clicked();

    height: 35px;
    background: #181818;
    border-width: 0px;
    border-color: Tokens.dropdown-border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        alignment: space-between;

        // Title text label
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                text: "SOURCE CONTROL";
                font-size: 11px;
                font-weight: 700;
                font-family: Tokens.font-family;
                color: #cccccc;
                vertical-alignment: center;
                letter-spacing: 0.5px;
            }
        }

        // Top right action buttons (ellipsis / more actions)
        HorizontalLayout {
            spacing: 2px;
            alignment: end;

            more-btn := Rectangle {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: more-touch.has-hover ? rgba(255, 255, 255, 0.1) : transparent;

                Image {
                    source: @image-url("../../assets/icons/right-sidebar/ellipsis.svg");
                    width: 14px;
                    height: 14px;
                    colorize: more-touch.has-hover ? Tokens.text-primary : Tokens.text-muted;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                more-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.more-actions-clicked();
                    }
                }
            }
        }
    }
}
