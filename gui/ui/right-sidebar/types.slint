// Shared data structures and types for the Git Diff / Source Control right sidebar.
//
// This file defines the Slint struct types used across all right sidebar components:
// - GitFileDiff: Represents a modified, added, deleted, or untracked file.
// - GitDiffHunk: Represents a block of code changes within a file.
// - GitDiffLine: Represents an individual line inside a diff hunk.
// - GitRepositoryInfo: Represents a git repository in the workspace.
// - GitGraphCommit: Represents a commit entry in the visual Git commit graph.

// Line-by-line diff entry inside a hunk.
// Old and new line numbers allow displaying side-by-side or unified diff line numbers.
export struct GitDiffLine {
    line_type: string,     // "+" for insertion, "-" for deletion, " " for context
    content: string,       // Syntax-highlighted or plain text line content
    old_line_num: string,  // Line number in the original/base file
    new_line_num: string,  // Line number in the modified/new file
}

// Hunk of modifications in a file diff.
// Contains a header string (e.g. "@@ -10,4 +10,6 @@") and a list of diff lines.
export struct GitDiffHunk {
    header: string,        // Diff hunk header string
    lines: [GitDiffLine],  // Array of lines within this hunk
}

// File diff structure representing a modified, added, deleted, or untracked file.
// Contains file path details, status badge, line counts, and expanded state for diff viewer.
export struct GitFileDiff {
    path: string,          // Full relative file path (e.g. "gui/ui/right-sidebar/right-sidebar.slint")
    file_name: string,     // Basename of the file (e.g. "right-sidebar.slint")
    dir_path: string,      // Directory path prefix (e.g. "gui/ui/right-sidebar")
    status: string,        // "modified", "added", "deleted", "untracked"
    insertions: int,       // Count of inserted lines (+X)
    deletions: int,        // Count of deleted lines (-Y)
    hunks: [GitDiffHunk],  // List of hunks for line-by-line diff preview
    is_expanded: bool,     // Whether the hunk diff viewer is expanded for this file
}

// Data structure representing a repository in the Source Control panel.
// Used for displaying the Repositories accordion list (similar to VS Code Source Control).
export struct GitRepositoryInfo {
    name: string,          // Repository name (e.g. "Operon", "codex", "openclaw")
    branch: string,        // Active branch name (e.g. "revert-tool-protocol-provider-native*", "main")
    is_active: bool,       // True if this is the currently active repository
    has_changes: bool,     // True if repository has uncommitted changes
}

// Data structure representing a single commit node in the visual Git Commit Graph.
// Includes hash, message, author, branch tag, and node position flags.
export struct GitGraphCommit {
    hash: string,          // Full git commit SHA hash
    short_hash: string,    // Short commit hash (e.g. "a1b2c3d")
    message: string,       // Commit message (e.g. "feat(gui): implement image attachment support")
    author: string,        // Commit author username/email (e.g. "lukagray-dev")
    branch_tag: string,    // Branch tag badge label if HEAD/branch tip (e.g. "revert-tool-proto...")
    is_head: bool,         // True if this commit is the current HEAD
    is_local: bool,        // True if commit is local-only (unpushed)
}
