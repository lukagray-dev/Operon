// Shared dropdown primitives for the custom titlebar menus.
//
// This file owns both the dropdown panel tokens and the reusable surface,
// trigger, item, and separator components. That keeps the individual menu
// files small and makes the interaction polish consistent everywhere.

import { Tokens } from "./tokens.slint";

export global DropdownTokens {
    in property <length> surface_width: Tokens.dropdown_surface_width;
    in property <length> surface_radius: Tokens.dropdown_surface_radius;
    in property <length> surface_padding: Tokens.dropdown_surface_padding;
    in property <length> item_height: Tokens.dropdown_item_height;
    in property <length> item_gap: Tokens.dropdown_item_gap;
    in property <length> item_padding_x: Tokens.dropdown_item_padding_x;
    in property <length> trigger_padding_x: Tokens.dropdown_trigger_padding_x;
    in property <length> trigger_hit_height: Tokens.dropdown_trigger_hit_height;
    in property <length> trigger_font_size: Tokens.titlebar_font_size;
    in property <length> item_font_size: Tokens.dropdown_font_size;
}

export component DropdownSurface inherits Rectangle {
    width: DropdownTokens.surface_width;
    border-radius: DropdownTokens.surface_radius;
    background: Tokens.dropdown_surface;
    border-width: 1px;
    border-color: Tokens.dropdown_border;
    clip: true;
    drop-shadow-blur: 16px;
    drop-shadow-color: Tokens.shadow_color;
    drop-shadow-offset-y: 6px;
}

export component DropdownTrigger inherits Rectangle {
    // The titlebar menu headers are text-only. The click target is small and
    // tight on purpose so the chrome feels refined instead of oversized.
    in property <string> label;
    in property <bool> active: false;
    in property <float> ui_scale: 1.0;
    callback clicked();

    width: label_text.preferred-width + DropdownTokens.trigger_padding_x * 2;
    height: DropdownTokens.trigger_hit_height;

    label_text := Text {
        x: DropdownTokens.trigger_padding_x;
        y: 0px;
        width: parent.width - DropdownTokens.trigger_padding_x * 2;
        height: parent.height;
        text: root.label;
        color: trigger_touch.pressed
            ? (root.active ? Tokens.accent_blue_hover : Tokens.text_primary)
            : root.active
                ? Tokens.accent_blue
                : trigger_touch.has-hover
                    ? Tokens.text_primary
                    : Tokens.text_muted;
        font-size: DropdownTokens.trigger_font_size * root.ui_scale;
        font-weight: 400;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: clip;
    }

    trigger_touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component DropdownItem inherits Rectangle {
    // Dropdown rows get a little hover tint so they still feel clickable while
    // staying mostly grayscale in the idle state.
    in property <string> label;
    in property <bool> danger: false;
    in property <float> ui_scale: 1.0;
    callback clicked();

    width: DropdownTokens.surface_width - DropdownTokens.surface_padding * 2;
    height: DropdownTokens.item_height;
    border-radius: 6px;
    background: item_touch.pressed
        ? Tokens.dropdown_surface_pressed
        : item_touch.has-hover
            ? Tokens.dropdown_surface_hover
            : transparent;

    item_label := Text {
        x: DropdownTokens.item_padding_x;
        y: 0px;
        width: parent.width - DropdownTokens.item_padding_x * 2;
        height: parent.height;
        text: root.label;
        color: item_touch.pressed || item_touch.has-hover
            ? (root.danger ? Tokens.danger_red_hover : Tokens.text_primary)
            : (root.danger ? Tokens.danger_red : Tokens.text_secondary);
        font-size: DropdownTokens.item_font_size * root.ui_scale;
        font-weight: 400;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: clip;
    }

    item_touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component DropdownSeparator inherits Rectangle {
    width: DropdownTokens.surface_width - DropdownTokens.surface_padding * 2;
    height: 1px;
    background: Tokens.dropdown_separator;
}
