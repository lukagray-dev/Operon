// Solving Thinking Orb component (Rubik Scrambling 3D Sphere Lattice) for Operon GUI.
//
// 1:1 mathematical port of the 'solving' preset (drawRubik) from Jakubantalik/thinking-orbs:
// 3D sphere lattice (lat/lon density) with 6 deterministic step-eased slice turns,
// palindrome scramble-to-solve cycle, and active slice ink highlights.

import { Tokens } from "../tokens.slint";

export component SolvingOrb inherits Rectangle {
    in property <length> size: 64px;
    in property <bool> is-active: true;

    width: root.size;
    height: root.size;
    background: transparent;

    property <float> t: 0.0;

    // Continuous 60 FPS animation timer loop
    Timer {
        interval: 16ms;
        running: root.is-active;
        triggered => {
            root.t = root.t + 0.012;
            if (root.t > 1000.0) {
                root.t = 0.0;
            }
        }
    }

    // Outer faint bounding sphere ring
    Rectangle {
        width: root.size * 0.82;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.06);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // ── 3D Sphere Lat/Long Grid (11 Latitude Rings x Variable Longitude Meridians) ──
    for li in 11 : Rectangle {
        property <float> lat: -1.5707963 + (li / 10.0) * 3.14159265;
        property <float> cosLat: cos(lat * 1rad);
        property <float> sinLat: sin(lat * 1rad);
        property <int> lonCount: max(1, round(abs(cosLat) * 20.0));

        for lj in 20 : Rectangle {
            if (lj < lonCount) : Rectangle {
                property <float> lon: (lj / max(1.0, lonCount)) * 6.2831853;

                // Base sphere 3D coordinates
                property <float> x0: cosLat * cos(lon * 1rad);
                property <float> y0: sinLat;
                property <float> z0: cosLat * sin(lon * 1rad);

                // Palindrome Scramble-then-Solve cycle timing (faster slot duration = 0.28s)
                property <float> cycTime: mod(root.t * 3.2, 4.5);
                property <float> slotIdx: floor(cycTime / 0.28);
                property <float> slotProg: min(1.0, (cycTime - slotIdx * 0.28) / 0.22);
                property <float> easeP: 1.0 - (1.0 - slotProg) * (1.0 - slotProg) * (1.0 - slotProg);

                // Move 0: Equatorial Y-rotation
                property <angle> move0: (slotIdx > 0 ? 90deg : (slotIdx == 0 ? easeP * 90deg : 0deg));
                property <bool> match0: abs(y0) < 0.35;
                property <float> x1: match0 ? (x0 * cos(move0) + z0 * sin(move0)) : x0;
                property <float> y1: y0;
                property <float> z1: match0 ? (-x0 * sin(move0) + z0 * cos(move0)) : z0;

                // Move 1: Northern X-rotation
                property <angle> move1: (slotIdx > 1 ? -90deg : (slotIdx == 1 ? -easeP * 90deg : 0deg));
                property <bool> match1: y1 > 0.15;
                property <float> x2: x1;
                property <float> y2: match1 ? (y1 * cos(move1) - z1 * sin(move1)) : y1;
                property <float> z2: match1 ? (y1 * sin(move1) + z1 * cos(move1)) : z1;

                // Move 2: Eastern Z-rotation
                property <angle> move2: (slotIdx > 2 ? 90deg : (slotIdx == 2 ? easeP * 90deg : 0deg));
                property <bool> match2: x2 > 0.1;
                property <float> x3: match2 ? (x2 * cos(move2) - y2 * sin(move2)) : x2;
                property <float> y3: match2 ? (x2 * sin(move2) + y2 * cos(move2)) : y2;
                property <float> z3: z2;

                // Camera yaw & tilt projection (makeProj from thinking-orbs)
                property <angle> yaw: root.t * 360deg * 0.15;
                property <float> px3d: x3 * cos(yaw) + z3 * sin(yaw);
                property <float> py3d: y3 * 0.939 - (-x3 * sin(yaw) + z3 * cos(yaw)) * 0.342;
                property <float> z3d: y3 * 0.342 + (-x3 * sin(yaw) + z3 * cos(yaw)) * 0.939;

                property <float> depth: (z3d + 1.0) / 2.0;
                property <bool> inActiveHand: (slotIdx == 0 && match0) || (slotIdx == 1 && match1) || (slotIdx == 2 && match2);

                width: max(1.0px, ((inActiveHand ? 1.3px : 0.9px) + 1.4px * depth) * (root.size / 64px));
                height: self.width;
                border-radius: self.width / 2;

                background: inActiveHand ? #ffffff : #bbbbbb;
                opacity: max(0.08, (inActiveHand ? 0.28 : 0.12) + 0.55 * depth);

                x: (parent.width / 2) + px3d * (root.size * 0.39) - self.width / 2;
                y: (parent.height / 2) - py3d * (root.size * 0.39) - self.height / 2;
            }
        }
    }
}
