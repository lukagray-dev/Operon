{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Operon Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode/extension"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/extension/src/js/**/*.js"
      ],
      "preLaunchTask": "npm: watch (vscode/extension)"
    }
  ]
}
